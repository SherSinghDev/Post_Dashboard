                        <!--**********************************
          Content body start
    ***********************************-->
                        <div class="content-body">
                            <div class="container">

                                <div class="d-flex justify-content-between mb-4 flex-wrap">


                                    <ul class="revnue-tab nav nav-tabs" id="myTab" role="tablist">
                                        <li class="nav-item" role="presentation">
                                            <button class="nav-link <%= statusFilter === 'all' ? 'active' : '' %>"
                                                id="status-tab" onclick="getFilter('all')" data-bs-toggle="tab"
                                                data-bs-target="#status-tab-pane" type="button" role="tab"
                                                aria-controls="status-tab-pane" aria-selected="false" tabindex="-1">All
                                                Status (<span></span>)</button>
                                        </li>
                                        <li class="nav-item" role="presentation">
                                            <button
                                                class="nav-link <%= statusFilter === 'Delivery Failed' ? 'active' : '' %>"
                                                id="Delivery-Failed" onclick="getFilter('Delivery Failed')"
                                                data-bs-toggle="tab" data-bs-target="#Delivery-Failed" type="button"
                                                role="tab" aria-controls="Delivery-Failed" aria-selected="false"
                                                tabindex="-1">Delivery Failed (<span></span>)</button>
                                        </li>
                                        <li class="nav-item" role="presentation">
                                            <button class="nav-link <%= statusFilter === 'Pickups' ? 'active' : '' %>"
                                                id="Pickups-tab" onclick="getFilter('Pickups')" data-bs-toggle="tab"
                                                data-bs-target="#Pickups-tab-pane" type="button" role="tab"
                                                aria-controls="Pickups-tab-pane" aria-selected="false"
                                                tabindex="-1">Pickups (<span></span>)</button>
                                        </li>
                                        <li class="nav-item" role="presentation">
                                            <button
                                                class="nav-link <%= statusFilter === 'In Transit' ? 'active' : '' %>"
                                                id="In-Transit-tab" onclick="getFilter('In Transit')"
                                                data-bs-toggle="tab" data-bs-target="#In-Transit-tab-pane" type="button"
                                                role="tab" aria-controls="In-Transit-tab-pane" aria-selected="false"
                                                tabindex="-1">In Transit (<span></span>)</button>
                                        </li>
                                        <li class="nav-item" role="presentation">
                                            <button
                                                class="nav-link <%= statusFilter === 'Out For Delivery' ? 'active' : '' %>"
                                                id="Out-For-Devlivery-tab" onclick="getFilter('Out For Delivery')"
                                                data-bs-toggle="tab" data-bs-target="#Out-For-Devlivery-tab-pane"
                                                type="button" role="tab" aria-controls="Out-For-Devlivery-tab-pane"
                                                aria-selected="false" tabindex="-1">Out For Delivery
                                                (<span></span>)</button>
                                        </li>
                                        <li class="nav-item" role="presentation">
                                            <button class="nav-link <%= statusFilter === 'Delivered' ? 'active' : '' %>"
                                                id="Delivered-tab" onclick="getFilter('Delivered')" data-bs-toggle="tab"
                                                data-bs-target="#Delivered-tab-pane" type="button" role="tab"
                                                aria-controls="Delivered-tab-pane" aria-selected="true">Delivered
                                                (<span></span>)</button>
                                        </li>
                                        <li class="nav-item" role="presentation">
                                            <button class="nav-link <%= statusFilter === 'RTO' ? 'active' : '' %>"
                                                id="RTO-tab" onclick="getFilter('RTO')" data-bs-toggle="tab"
                                                data-bs-target="#RTO-tab-pane" type="button" role="tab"
                                                aria-controls="RTO-tab-pane" aria-selected="true">RTO
                                                (<span></span>)</button>
                                        </li>
                                    </ul>
                                    <div>
                                        <div class="input-group w-auto mb-2 mb-xxl-0">
                                            <input type="text" placeholder="Search by Reg No., name, city, or mobile"
                                                class="form-control search-input" style="width: 300px;">
                                        </div>
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-xl-12">
                                        <div class="card mt-2">
                                            <div class="card-body">
                                                <div class="table-responsive text-center">

                                                    <% for(let key in applications){ %>
                                                        <h4 class="text-start">
                                                            <% if(key==user.name){ %>
                                                                My Orders
                                                                <%}else{ %>
                                                                    Orders of <span class="text-secondary"><%-
                                                                            key!='undefined' ?key:"Unknown" %></span>
                                                                    <% } %>
                                                        </h4>
                                                        <table class="table table-striped align-middle main-table">
                                                            <thead>
                                                                <tr>
                                                                    <th>Order Details</th>
                                                                    <th>Provider</th>
                                                                    <th>Courier Partner</th>
                                                                    <th>Delivery Details</th>
                                                                    <th>Package Details</th>
                                                                    <th>Item Details</th>
                                                                    <th>Payment Details</th>
                                                                    <th>Status</th>
                                                                    <th>Actions</th>
                                                                </tr>
                                                            </thead>
                                                            <tbody>


                                                                <% if (applications[key].length> 0) { %>
                                                                    <% applications[key].forEach((app, index)=> { %>
                                                                        <% if(app){%>


                                                                            <tr id="tr-<%= app?._id %>"
                                                                                style="text-align: left;">
                                                                                <td>
                                                                                    <p>
                                                                                        <%= app?.invoice_number %>
                                                                                    </p>
                                                                                    <p>
                                                                                        <%= new
                                                                                            Date(app.createdAt).toLocaleString()
                                                                                            %>
                                                                                    </p>
                                                                                    <p>
                                                                                        <%= app?.channel_name %>
                                                                                    </p>
                                                                                </td>
                                                                                <td>
                                                                                    <p>
                                                                                        <b> <%- app?.provider ?
                                                                                                app?.provider :'proship'
                                                                                                %> </b>
                                                                                    </p>

                                                                                </td>
                                                                                <td>
                                                                                    <p>AWB : <b>
                                                                                            <%= app?.track?.waybill ?
                                                                                                app?.track?.waybill :
                                                                                                app?.awb_number %>
                                                                                        </b></p>
                                                                                    <p>Courier : <b>
                                                                                            <%= app?.track?.courierPartner
                                                                                                ?
                                                                                                app?.track?.courierPartner
                                                                                                :app?.track?.[0].billing_name
                                                                                                %>
                                                                                        </b></p>
                                                                                </td>
                                                                                <td>
                                                                                    <p><i
                                                                                            class="fa-solid fa-location-dot"></i>
                                                                                        <%= app?.pickup_details.from_name
                                                                                            %>
                                                                                            <br>
                                                                                            <span class="ms-3">
                                                                                                <%= app?.pickup_details.from_pincode
                                                                                                    %>
                                                                                            </span>
                                                                                    </p>
                                                                                    <p><i
                                                                                            class="fa-solid fa-location-dot"></i>
                                                                                        <%= app?.delivery_details.to_name
                                                                                            %>
                                                                                            <br>
                                                                                            <span class="ms-3">
                                                                                                <%= app?.delivery_details.to_pincode
                                                                                                    %>
                                                                                            </span>
                                                                                    </p>

                                                                                </td>
                                                                                <td>
                                                                                    <p>Dead Weight: <%=
                                                                                            (app?.shipment_detail[0].item_weight)/1000
                                                                                            %>kg</p>
                                                                                    <p>Vol Weight: </p>
                                                                                    <p>Dimensions: <%=
                                                                                            app?.shipment_detail[0].item_height
                                                                                            %> X <%=
                                                                                                app?.shipment_detail[0].item_length
                                                                                                %> X <%=
                                                                                                    app?.shipment_detail[0].item_breadth
                                                                                                    %>
                                                                                    </p>
                                                                                </td>
                                                                                <td>
                                                                                    <p>Total Units : <%=
                                                                                            app?.item_list.length %>
                                                                                    </p>
                                                                                </td>

                                                                                <td>
                                                                                    <p>Rs. <%= app?.invoice_value %>
                                                                                    </p>
                                                                                    <p><a href="#"
                                                                                            class="btn btn-secondary p-2 py-1 rounded-4">
                                                                                            <%= app?.payment_mode %>
                                                                                        </a></p>
                                                                                </td>
                                                                                <td>
                                                                                    <p><a href="#"
                                                                                            class="btn btn-dark p-2 py-1 rounded-4 order-status">
                                                                                            <%= app?.track?.currentStatus
                                                                                                ?
                                                                                                app?.track?.currentStatus
                                                                                                :
                                                                                                app?.track?.[0]?.action
                                                                                                %>
                                                                                        </a></p>
                                                                                </td>

                                                                                <td>

                                                                                    <p>
                                                                                        <% if(app.mobile){ %>
                                                                                            <a href="https://wa.me/+91<%= app.mobile %>"
                                                                                                class=" btn btn-sm btn-success">
                                                                                                <i class="fa-brands fa-whatsapp"
                                                                                                    style="color:white;font-size: 16px;"></i>
                                                                                            </a>
                                                                                            <% } %>
                                                                                                <a href="javascript:void(0);"
                                                                                                    data-way="<%= app?.track?.waybill ? app?.track?.waybill : app?.track?.[0]?.tracking_number %>"
                                                                                                    class=" btn btn-sm btn-info details-btn">
                                                                                                    TRACK
                                                                                                </a>


                                                                                                <a href="javascript:void(0);"
                                                                                                    data-way="<%= app?.track?.waybill ? app?.track?.waybill : app?.track?.[0]?.tracking_number %>"
                                                                                                    onclick="handleCancelOrder()"
                                                                                                    class=" btn btn-sm btn-danger cancel-order">
                                                                                                    CANCEL
                                                                                                </a>
                                                                                    </p>

                                                                                </td>
                                                                            </tr>
                                                                            <% } %>
                                                                                <% }) %>
                                                                                    <% } else { %>
                                                                                        <tr>
                                                                                            <td colspan="10"
                                                                                                class="text-center text-muted">
                                                                                                No Data found</td>
                                                                                        </tr>
                                                                                        <% } %>

                                                            </tbody>
                                                        </table>
                                                        <% } %>

                                                            <!-- Pagination Controls -->
                                                            <% if (pagination && pagination.totalPages> 1) { %>
                                                                <div class="d-flex justify-content-center mt-4">
                                                                    <div style="overflow-x: auto; max-width: 100%;">
                                                                        <nav aria-label="Page navigation">
                                                                            <ul class="pagination flex-nowrap">
                                                                                <% if (pagination.hasPrevPage) { %>
                                                                                    <li class="page-item">
                                                                                        <a class="page-link"
                                                                                            href="/patientorder/allorders?status=<%= statusFilter %>&page=<%= pagination.currentPage - 1 %>"
                                                                                            aria-label="Previous">
                                                                                            <span
                                                                                                aria-hidden="true">&laquo;</span>
                                                                                        </a>
                                                                                    </li>
                                                                                    <% } %>

                                                                                        <% for (let i=1; i
                                                                                            <=pagination.totalPages;
                                                                                            i++) { %>
                                                                                            <li
                                                                                                class="page-item <%= pagination.currentPage === i ? 'active' : '' %>">
                                                                                                <a class="page-link"
                                                                                                    href="/patientorder/allorders?status=<%= statusFilter %>&page=<%= i %>">
                                                                                                    <%= i %>
                                                                                                </a>
                                                                                            </li>
                                                                                            <% } %>

                                                                                                <% if
                                                                                                    (pagination.hasNextPage)
                                                                                                    { %>
                                                                                                    <li
                                                                                                        class="page-item">
                                                                                                        <a class="page-link"
                                                                                                            href="/patientorder/allorders?status=<%= statusFilter %>&page=<%= pagination.currentPage + 1 %>"
                                                                                                            aria-label="Next">
                                                                                                            <span
                                                                                                                aria-hidden="true">&raquo;</span>
                                                                                                        </a>
                                                                                                    </li>
                                                                                                    <% } %>
                                                                            </ul>
                                                                        </nav>
                                                                    </div>
                                                                </div>

                                                                <div class="text-center text-muted mt-2">
                                                                    Showing <%= (pagination.currentPage - 1) *
                                                                        pagination.limit + 1 %> to
                                                                        <%= Math.min(pagination.currentPage *
                                                                            pagination.limit, pagination.totalOrders) %>
                                                                            of <%= pagination.totalOrders %> orders
                                                                </div>
                                                                <% } %>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <!--**********************************
          Content body end
    ***********************************-->




