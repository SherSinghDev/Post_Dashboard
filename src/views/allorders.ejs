                                            </div>
                                        </div>
                                    
                                `);
                        $('#details-modal').modal('show');
                    }
                    else {
                        alert(data.message)
                    }
                })
                .catch(err => console.error(err));


        });


        function getAllFilter() {
            let codes = []

            // if (status == 'all') {
            //     document.querySelectorAll('.main-table tbody tr').forEach((tr) => {
            //         tr.style.display = 'table-row'
            //     })
            //     return
            // }
            // codes = ['PICKUP_FAILED', 'FAILED_DELIVERY', 'CANCELLED_ORDER','CANCELLED_PENDING']


            let all = 0
            let failedList = ['PICKUP_FAILED', 'FAILED_DELIVERY', 'CANCELLED_ORDER']
            let totalfailed = 0
            let pickList = ['PICKUP_PENDING', 'PICKED_UP']
            let totalPick = 0
            let intransitList = ['INTRANSIT']
            let totalIntransit = 0
            let outDeliveryList = ['OUT_FOR_DELIVERY']
            let totalOutDelivery = 0
            let deliveredList = ['DELIVERED']
            let totalDelivered = 0
            let rtoList = ['RTO_REQUESTED', 'RTO', 'RTO_OUT_FOR_DELIVERY', 'RTO_DELIVERED', 'RTO_FAILED']
            let totalRto = 0


            let btn = document.querySelectorAll('.main-table tbody tr .order-status')
            // console.log(btn);
            all = btn.length
            let show = []
            btn.forEach((b) => {
                let bStatus = b.innerText.trim()
                // console.log(bStatus);

                if (failedList.includes(bStatus)) {
                    totalfailed += 1
                }
                else if (intransitList.includes(bStatus)) {
                    totalIntransit += 1
                }
                else if (outDeliveryList.includes(bStatus)) {
                    totalOutDelivery += 1
                }
                else if (deliveredList.includes(bStatus)) {
                    totalDelivered += 1
                }
                else if (rtoList.includes(bStatus)) {
                    totalRto += 1
                }
            })
            // console.log(all, totalfailed, totalPick, totalIntransit, totalOutDelivery, totalDelivered, totalRto);

            document.querySelector('#status-tab span').innerHTML = all
            document.querySelector('#Delivery-Failed span').innerHTML = totalfailed
            document.querySelector('#Pickups-tab span').innerHTML = totalPick
            document.querySelector('#In-Transit-tab span').innerHTML = totalIntransit
            document.querySelector('#Out-For-Devlivery-tab span').innerHTML = totalOutDelivery
            document.querySelector('#Delivered-tab span').innerHTML = totalDelivered
            document.querySelector('#RTO-tab span').innerHTML = totalRto
        }

        setTimeout(() => {
            getAllFilter()
        }, 2000);





        function getFilter(status) {
            // Redirect to server with status filter and page=1
            window.location.href = `/patientorder/allorders?status=${encodeURIComponent(status)}&page=1`;
        }

        $(document).on('click', '.logout-btn', function (e) {
            Swal.fire({
                title: "Do you want to Logout?",
                showDenyButton: true,
                // showCancelButton: true,
                confirmButtonText: "Yes",
                denyButtonText: `Cancel`
            }).then((result) => {
                /* Read more about isConfirmed, isDenied below */
                if (result.isConfirmed) {

                    $.ajax({
                        url: `/auth/logout`,
                        method: "POST",
                        success: function (data) {
                            console.log(data);
                            if (data.logout) {
                                window.location.href = '/'
                            }
                            else {
                                Swal.fire({
                                    icon: "error",
                                    title: "Oops...",
                                    text: "Something Went Wrong",
                                    timer: 1500
                                });
                            }
                        },
                        error: function (err) {
                            console.log(err);
                        }
                    })
                }
            });
        })

        // track btn
        $(document).on('click', ".track-btn", function () {
            let id = $(this).attr('data-id')
            console.log(id);
            navigator.clipboard.writeText(id)
                .then(() => {
                    console.log("Copied to clipboard");
                    window.open('https://www.indiapost.gov.in/home', "_blank")
                })
                .catch((err) => {
                    console.log(err);
                })
        })

        var handleNavigation = function () {
            $(".nav-control").on('click', function () {

                $('#main-wrapper').toggleClass("menu-toggle");

                $(".hamburger").toggleClass("is-active");
            });
        }

        handleNavigation()
    </script>
