<!DOCTYPE html>
<html lang="en">
<%- include('./globals/head') %>

<body>
    <%- include('./globals/preloader') %>

    <div id="main-wrapper">
        <%- include('globals/navHeader') %>
        <%- include('globals/header') %>

        <!--**********************************
            Sidebar start
        ***********************************-->
        <%- include('./globals/doctor_sidebar') %>
        <div class="content-body">
            <div class="container">
                <%- include('./globals/dash_cards_style') %>

                
                <div class="row" id="dashboardCardsContainer">
                    <!-- Single Order Patients -->
                    <div class="col-xl-6 col-lg-6 col-sm-6 dash-card-item">
                        <div class="dash-card">
                            <div class="d-flex align-items-start justify-content-between mb-3">
                                <div>
                                    <div class="dash-card-title">Single Order Patients</div>
                                    <div class="dash-card-value"><%= singleOrders %></div>
                                    <div class="text-success fw-bold fs-14 mt-1">Today: <%= singleOrdersToday %></div>
                                </div>
                                <div class="dash-card-icon icon-blue">
                                    <i class="fas fa-file-prescription"></i>
                                </div>
                            </div>
                            <div class="d-flex align-items-center justify-content-between mt-1">
                                <a href="/doctors/patients/single" class="dash-card-action">
                                    View All <i class="fas fa-arrow-right ms-2 fs-12"></i>
                                </a>
                                <div class="dash-card-trend trend-up">
                                    <i class="fas fa-chart-line"></i>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Stock Order Patients -->
                    <div class="col-xl-6 col-lg-6 col-sm-6 dash-card-item">
                        <div class="dash-card">
                            <div class="d-flex align-items-start justify-content-between mb-3">
                                <div>
                                    <div class="dash-card-title">Stock Order Patients</div>
                                    <div class="dash-card-value"><%= stockOrders %></div>
                                    <div class="text-success fw-bold fs-14 mt-1">Today: <%= stockOrdersToday %></div>
                                </div>
                                <div class="dash-card-icon icon-emerald">
                                    <i class="fas fa-boxes"></i>
                                </div>
                            </div>
                            <div class="d-flex align-items-center justify-content-between mt-1">
                                <a href="/doctors/patients/stock" class="dash-card-action">
                                    View All <i class="fas fa-arrow-right ms-2 fs-12"></i>
                                </a>
                                <div class="dash-card-trend trend-up">
                                    <i class="fas fa-chart-line"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </div></div>
            </div>

        </div>

        <!--**********************************
            Content body end
        ***********************************-->

        <!--**********************************
            Footer start
        ***********************************-->
        <!-- <div class="footer">
                                <div class="copyright">
