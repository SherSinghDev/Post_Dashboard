<%- include('header') %>

<main class="flex-1 py-12 bg-slate-50">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">

        <!-- Page Header -->
        <div class="text-center max-w-3xl mx-auto mb-10">
            <span class="text-orange-600 text-xs font-black uppercase tracking-wider">Know Our Organization</span>
            <h1 class="text-3xl sm:text-4xl font-black text-slate-900 mt-1">About BSRF Education</h1>
            <p class="text-xs text-slate-500 mt-2">Pioneering accessible, distance, and university degree programs for students across India.</p>
            <div class="w-16 h-1 bg-orange-500 mx-auto mt-3 rounded-full"></div>
        </div>

        <!-- Tab Controls (Like makemyshiksha) -->
        <div class="flex justify-center gap-3 mb-10">
            <button type="button" onclick="switchAboutTab('tab-company')" id="btn-tab-company" class="px-6 py-2.5 rounded-full text-xs font-bold transition-all bg-orange-600 text-white shadow-md">
                <i class="fa-solid fa-building-columns mr-1"></i> About Company
            </button>
            <button type="button" onclick="switchAboutTab('tab-director')" id="btn-tab-director" class="px-6 py-2.5 rounded-full text-xs font-bold transition-all bg-white text-slate-700 border border-slate-200 hover:border-orange-500">
                <i class="fa-solid fa-user-tie mr-1"></i> Director's Message
            </button>
        </div>

        <!-- Tab 1: About Company -->
        <div id="tab-company" class="about-tab-panel">
            <div class="bg-white rounded-3xl p-8 sm:p-12 shadow-md border border-slate-100 grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
                <div class="lg:col-span-7 space-y-4 text-xs sm:text-sm text-slate-600 leading-relaxed">
                    <span class="text-orange-600 font-extrabold uppercase tracking-wider text-xs">Excellence in Higher Education</span>
                    <h2 class="text-2xl font-black text-slate-900 leading-tight">
                        Empowering Aspirations Through <span class="text-blue-900">Quality University Education</span>
                    </h2>
                    <p>
                        <strong>BSRF Education</strong> is an educational division under <strong>Binupur Seva Research Foundation</strong>. We serve as a strategic Admission & Education Service Provider helping students gain admission into top reputed colleges and UGC, AICTE & NAAC A+ approved universities across India.
                    </p>
                    <p>
                        Students can select career options spanning <strong>UG, PG, Diploma, Certificate, Paramedical, Pharmacy, Law, Management, Engineering, and Doctoral (Ph.D.)</strong> programs across Online, Distance, and Regular formats.
                    </p>
                    <p>
                        Our mentors bring decades of combined experience in the education domain and personalized career counseling. We bridge the gap between ambitious students, franchise learning centers, and premier universities nationwide.
                    </p>
                    <div class="grid grid-cols-2 gap-4 pt-4 border-t border-slate-100">
                        <div class="bg-slate-50 p-3 rounded-xl border border-slate-200">
                            <span class="font-extrabold text-blue-900 text-lg block">50+</span>
                            <span class="text-[11px] text-slate-500">University Partners</span>
                        </div>
                        <div class="bg-slate-50 p-3 rounded-xl border border-slate-200">
                            <span class="font-extrabold text-orange-600 text-lg block">15,000+</span>
                            <span class="text-[11px] text-slate-500">Students Benefited</span>
                        </div>
                    </div>
                </div>

                <div class="lg:col-span-5 flex justify-center">
                    <div class="p-6 bg-gradient-to-br from-blue-900 to-indigo-950 text-white rounded-3xl shadow-xl w-full text-center space-y-4">
                        <div class="w-20 h-20 bg-orange-500 rounded-3xl mx-auto flex items-center justify-center text-3xl shadow-lg">
                            <i class="fa-solid fa-award"></i>
                        </div>
                        <h3 class="text-lg font-black">ISO 9001:2015 Certified</h3>
                        <p class="text-xs text-slate-300">Committed to ethical counseling, authentic university admissions, and student transparency since inception.</p>
                        <div class="pt-2">
                            <button type="button" onclick="openEnquiryModal()" class="px-5 py-2.5 bg-white text-blue-950 font-black rounded-xl text-xs hover:bg-orange-50 transition">
                                Talk with an Advisor
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Tab 2: Director's Message -->
        <div id="tab-director" class="about-tab-panel hidden">
            <div class="bg-white rounded-3xl p-8 sm:p-12 shadow-md border border-slate-100 grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
                <div class="lg:col-span-5 text-center">
                    <div class="w-48 h-48 sm:w-56 sm:h-56 mx-auto rounded-3xl bg-gradient-to-br from-orange-400 to-amber-600 p-2 shadow-xl mb-4">
                        <img src="https://images.unsplash.com/photo-1573496359142-b8d87734a5a2?auto=format&fit=crop&w=400&q=80" alt="Director" class="w-full h-full object-cover rounded-2xl">
                    </div>
                    <h3 class="text-lg font-extrabold text-slate-900">Dr. A. K. Mishra</h3>
                    <p class="text-xs text-orange-600 font-bold">Director, BSRF Education</p>
                    <p class="text-[11px] text-slate-400">Binupur Seva Research Foundation</p>
                </div>

                <div class="lg:col-span-7 space-y-4 text-xs sm:text-sm text-slate-600 leading-relaxed">
                    <span class="text-orange-600 font-extrabold uppercase tracking-wider text-xs">Visionary Leadership</span>
                    <h2 class="text-2xl font-black text-slate-900 leading-tight">
                        "Education is the most powerful weapon to transform lives and nation."
                    </h2>
                    <blockquote class="p-4 bg-orange-50 border-l-4 border-orange-500 rounded-r-xl italic text-slate-700 text-xs sm:text-sm">
                        "At BSRF Education, our commitment is to ensure that no ambitious student is left behind due to geographical or financial limitations. With modern online degree and distance education frameworks approved by UGC, students can now learn at their own pace from top universities."
                    </blockquote>
                    <p>
                        Furthermore, we invite Admission Consultants, Franchise Centers, and Counselors nationwide to collaborate with us. Together, we build a nationwide learning bridge empowering youth with verified, accredited higher education qualifications.
                    </p>
                    <div class="pt-2 flex items-center gap-4">
                        <a href="/education/contact" class="px-5 py-2.5 bg-blue-900 hover:bg-blue-800 text-white font-bold rounded-xl text-xs transition">
                            Contact Director's Desk
                        </a>
                    </div>
                </div>
            </div>
        </div>

    </div>
</main>

<script>
    function switchAboutTab(tabId) {
        document.querySelectorAll('.about-tab-panel').forEach(p => p.classList.add('hidden'));
        document.getElementById(tabId).classList.remove('hidden');

        const btnCompany = document.getElementById('btn-tab-company');
        const btnDirector = document.getElementById('btn-tab-director');

        if (tabId === 'tab-company') {
            btnCompany.className = 'px-6 py-2.5 rounded-full text-xs font-bold transition-all bg-orange-600 text-white shadow-md';
            btnDirector.className = 'px-6 py-2.5 rounded-full text-xs font-bold transition-all bg-white text-slate-700 border border-slate-200 hover:border-orange-500';
        } else {
            btnDirector.className = 'px-6 py-2.5 rounded-full text-xs font-bold transition-all bg-orange-600 text-white shadow-md';
            btnCompany.className = 'px-6 py-2.5 rounded-full text-xs font-bold transition-all bg-white text-slate-700 border border-slate-200 hover:border-orange-500';
        }
    }
</script>

<%- include('footer') %>
