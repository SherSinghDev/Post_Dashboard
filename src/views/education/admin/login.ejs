<%- include('../header') %>

<main class="flex-1 py-14 bg-slate-50 flex items-center justify-center">
    <div class="max-w-md w-full mx-4">
        
        <div class="bg-white rounded-3xl p-8 sm:p-10 shadow-2xl border border-slate-200 relative overflow-hidden">
            <!-- Top decorative stripe -->
            <div class="absolute top-0 left-0 right-0 h-2 bg-gradient-to-r from-blue-900 via-indigo-900 to-orange-500"></div>

            <div class="text-center mb-8">
                <div class="w-16 h-16 rounded-2xl bg-gradient-to-br from-blue-900 to-slate-900 text-white mx-auto flex items-center justify-center text-2xl shadow-lg mb-3">
                    <i class="fa-solid fa-shield-halved text-orange-400"></i>
                </div>
                <span class="text-[10px] font-black uppercase text-orange-600 tracking-wider">Master Control Gateway</span>
                <h1 class="text-2xl font-black text-slate-900 tracking-tight mt-0.5">Education Admin Login</h1>
                <p class="text-xs text-slate-500 mt-1">Authorized administration portal for universities, students, applications & commissions</p>
            </div>

            <% if (typeof successMsg !== 'undefined' && successMsg) { %>
                <div class="mb-5 p-3.5 bg-emerald-50 border border-emerald-200 text-emerald-800 text-xs rounded-xl flex items-center gap-2 font-semibold">
                    <i class="fa-solid fa-circle-check text-emerald-600 flex-shrink-0"></i>
                    <span><%= successMsg %></span>
                </div>
            <% } %>

            <% if (typeof error !== 'undefined' && error) { %>
                <div class="mb-5 p-3.5 bg-red-50 border border-red-200 text-red-700 text-xs rounded-xl flex items-center gap-2 font-semibold">
                    <i class="fa-solid fa-circle-exclamation text-red-500 flex-shrink-0"></i>
                    <span><%= error %></span>
                </div>
            <% } %>

            <form action="/education/admin/login" method="POST" class="space-y-4 text-xs">
                <div>
                    <label class="block font-bold text-slate-700 mb-1">Admin Username / Email *</label>
                    <div class="relative">
                        <i class="fa-regular fa-user absolute left-3.5 top-3.5 text-slate-400"></i>
                        <input type="text" id="adminUserField" name="username" required value="admin@bsrf.org" placeholder="e.g. admin or admin@bsrf.org" class="w-full pl-10 pr-3.5 py-3 rounded-xl border border-slate-200 focus:outline-none focus:border-orange-500 bg-slate-50 focus:bg-white text-xs font-semibold text-slate-800">
                    </div>
                </div>

                <div>
                    <div class="flex justify-between items-center mb-1">
                        <label class="font-bold text-slate-700">Master Password *</label>
                    </div>
                    <div class="relative">
                        <i class="fa-solid fa-lock absolute left-3.5 top-3.5 text-slate-400"></i>
                        <input type="password" id="adminPassField" name="password" required value="admin" placeholder="Enter master password" class="w-full pl-10 pr-3.5 py-3 rounded-xl border border-slate-200 focus:outline-none focus:border-orange-500 bg-slate-50 focus:bg-white text-xs font-semibold text-slate-800">
                    </div>
                </div>

                <!-- Demo Credentials Box with autofill -->
                <div class="p-3 bg-amber-50 rounded-2xl border border-amber-200 text-[11px] text-amber-900 flex items-center justify-between">
                    <div>
                        <span class="font-bold block text-amber-950">Default Master Credentials:</span>
                        <span>User: <strong>admin@bsrf.org</strong> &bull; Pass: <strong>admin</strong></span>
                    </div>
                    <button type="button" onclick="fillAdminDemo()" class="px-2.5 py-1 bg-amber-200 hover:bg-amber-300 text-amber-900 font-bold rounded-lg text-[10px] transition">
                        Autofill
                    </button>
                </div>

                <button type="submit" class="w-full py-3.5 bg-gradient-to-r from-blue-900 via-indigo-900 to-slate-900 hover:from-blue-800 hover:to-slate-800 text-white font-black text-xs uppercase tracking-wider rounded-xl shadow-lg transition flex items-center justify-center gap-2">
                    <i class="fa-solid fa-shield-halved text-orange-400"></i> Authenticate & Access Admin Panel
                </button>
            </form>

            <div class="mt-6 pt-6 border-t border-slate-100 flex items-center justify-between text-xs text-slate-500">
                <a href="/education" class="hover:text-orange-600 transition flex items-center gap-1 font-semibold">
                    <i class="fa-solid fa-arrow-left"></i> Back to Education Home
                </a>
                <span class="flex items-center gap-1 text-[11px] text-slate-400">
                    <i class="fa-solid fa-lock text-green-600"></i> Encrypted Session
                </span>
            </div>
        </div>

    </div>
</main>

<script>
    function fillAdminDemo() {
        document.getElementById('adminUserField').value = 'admin@bsrf.org';
        document.getElementById('adminPassField').value = 'admin';
    }
</script>

<%- include('../footer') %>
