<%- include('../header') %>

<main class="flex-1 py-14 bg-slate-50 flex items-center justify-center">
    <div class="max-w-md w-full mx-4">
        
        <div class="bg-white rounded-3xl p-8 sm:p-10 shadow-xl border border-slate-200">
            <div class="text-center mb-8">
                <div class="w-16 h-16 rounded-2xl bg-amber-100 text-amber-700 mx-auto flex items-center justify-center text-2xl shadow-inner mb-3">
                    <i class="fa-solid fa-school"></i>
                </div>
                <h1 class="text-2xl font-black text-slate-900 tracking-tight">Franchise & Center Login</h1>
                <p class="text-xs text-slate-500 mt-1">Authorized study center portal for student admissions & commission tracking</p>
            </div>

            <% if (typeof error !== 'undefined' && error) { %>
                <div class="mb-5 p-3.5 bg-red-50 border border-red-200 text-red-700 text-xs rounded-xl flex items-center gap-2">
                    <i class="fa-solid fa-circle-exclamation flex-shrink-0"></i>
                    <span><%= error %></span>
                </div>
            <% } %>

            <form action="/education/centre/login" method="POST" class="space-y-4 text-xs">
                <div>
                    <label class="block font-bold text-slate-700 mb-1">Center Code / Registered Email</label>
                    <div class="relative">
                        <i class="fa-regular fa-building absolute left-3.5 top-3.5 text-slate-400"></i>
                        <input type="text" name="emailOrCode" required value="center@bsrf.org" placeholder="center@bsrf.org or BSRF-CEN-01" class="w-full pl-10 pr-3.5 py-3 rounded-xl border border-slate-200 focus:outline-none focus:border-orange-500 bg-slate-50 text-xs font-semibold">
                    </div>
                </div>

                <div>
                    <label class="block font-bold text-slate-700 mb-1">Password</label>
                    <div class="relative">
                        <i class="fa-solid fa-lock absolute left-3.5 top-3.5 text-slate-400"></i>
                        <input type="password" name="password" required value="123456" placeholder="Enter password" class="w-full pl-10 pr-3.5 py-3 rounded-xl border border-slate-200 focus:outline-none focus:border-orange-500 bg-slate-50 text-xs font-semibold">
                    </div>
                    <p class="text-[11px] text-slate-400 mt-1">Demo login: <strong>center@bsrf.org</strong> | Password: <strong>123456</strong></p>
                </div>

                <button type="submit" class="w-full py-3.5 bg-blue-900 hover:bg-blue-800 text-white font-black text-xs uppercase tracking-wider rounded-xl shadow-lg transition flex items-center justify-center gap-2">
                    <i class="fa-solid fa-right-to-bracket"></i> Login to Center Portal
                </button>
            </form>

            <div class="mt-6 pt-6 border-t border-slate-100 text-center text-xs text-slate-500">
                Want to become an authorized study center?
                <a href="/education/centre/register" class="font-extrabold text-orange-600 hover:underline">Apply for Franchise</a>
            </div>
        </div>

    </div>
</main>

<%- include('../footer') %>
