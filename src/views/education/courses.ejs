<%- include('header') %>

<main class="flex-1 py-12 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6">

        <!-- Page Header -->
        <div class="text-center max-w-3xl mx-auto mb-10">
            <span class="text-orange-600 text-xs font-black uppercase tracking-wider">All Academic Programs</span>
            <h1 class="text-3xl sm:text-4xl font-black text-slate-900 mt-1">Online & Distance Courses Directory</h1>
            <p class="text-xs text-slate-500 mt-2">Filter across UGC-approved UG, PG, Diploma, and Certificate programs from top Indian universities.</p>
            <div class="w-16 h-1 bg-orange-500 mx-auto mt-3 rounded-full"></div>
        </div>

        <!-- Filter Bar -->
        <div class="bg-white rounded-2xl p-6 shadow-sm border border-slate-200 mb-8">
            <form action="/education/courses" method="GET" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 text-xs">
                <div>
                    <label class="block font-bold text-slate-700 mb-1">Search Course Title</label>
                    <div class="relative">
                        <i class="fa-solid fa-magnifying-glass absolute left-3 top-3 text-slate-400"></i>
                        <input type="text" name="search" value="<%= searchQuery || '' %>" placeholder="e.g. BCA, MBA, B.Tech" class="w-full pl-9 pr-3 py-2 rounded-xl border border-slate-200 bg-slate-50 text-xs">
                    </div>
                </div>

                <div>
                    <label class="block font-bold text-slate-700 mb-1">Degree Category</label>
                    <select name="category" class="w-full px-3 py-2 rounded-xl border border-slate-200 bg-slate-50 text-xs font-semibold">
                        <% categories.forEach(function(cat) { %>
                            <option value="<%= cat %>" <%= selectedCategory === cat ? 'selected' : '' %>><%= cat %></option>
                        <% }); %>
                    </select>
                </div>

                <div>
                    <label class="block font-bold text-slate-700 mb-1">Stream / Field</label>
                    <select name="stream" class="w-full px-3 py-2 rounded-xl border border-slate-200 bg-slate-50 text-xs font-semibold">
                        <% streams.forEach(function(st) { %>
                            <option value="<%= st %>" <%= selectedStream === st ? 'selected' : '' %>><%= st %></option>
                        <% }); %>
                    </select>
                </div>

                <div class="flex items-end gap-2">
                    <button type="submit" class="flex-1 py-2.5 bg-orange-600 hover:bg-orange-700 text-white rounded-xl font-bold transition shadow-sm flex items-center justify-center gap-1.5">
                        <i class="fa-solid fa-filter"></i> Apply Filters
                    </button>
                    <a href="/education/courses" class="py-2.5 px-3 bg-slate-100 hover:bg-slate-200 text-slate-600 rounded-xl font-bold transition">
                        Reset
                    </a>
                </div>
            </form>
        </div>

        <!-- Course Cards -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            <% if (courses && courses.length > 0) { %>
                <% courses.forEach(function(course) { %>
                    <div class="bg-white rounded-2xl p-6 border border-slate-200 hover:border-orange-400 hover:shadow-xl transition-all flex flex-col justify-between">
                        <div>
                            <div class="flex items-center justify-between mb-3">
                                <span class="text-[10px] font-black uppercase px-2.5 py-1 rounded-md bg-blue-50 text-blue-700 border border-blue-200">
                                    <%= course.category %> &bull; <%= course.stream %>
                                </span>
                                <span class="text-[11px] font-bold text-emerald-600 bg-emerald-50 px-2 py-0.5 rounded-full">
                                    <%= course.mode %>
                                </span>
                            </div>

                            <h3 class="text-base font-extrabold text-slate-900 leading-snug mb-1">
                                <%= course.title %>
                            </h3>

                            <p class="text-xs text-orange-600 font-semibold mb-3 flex items-center gap-1.5">
                                <i class="fa-solid fa-building-columns"></i> <%= course.universityName || 'Partner University' %>
                            </p>

                            <div class="space-y-1.5 text-xs text-slate-600 my-4 bg-slate-50 p-3.5 rounded-xl border border-slate-100">
                                <div class="flex justify-between">
                                    <span class="text-slate-400">Duration:</span>
                                    <span class="font-bold text-slate-800"><%= course.duration %></span>
                                </div>
                                <div class="flex justify-between">
                                    <span class="text-slate-400">Annual Tuition:</span>
                                    <span class="font-extrabold text-blue-900">₹<%= (course.feePerYear || 25000).toLocaleString('en-IN') %></span>
                                </div>
                                <div class="flex justify-between">
                                    <span class="text-slate-400">Total Program Fee:</span>
                                    <span class="font-bold text-slate-800">₹<%= (course.totalFee || 75000).toLocaleString('en-IN') %></span>
                                </div>
                                <div class="pt-2 border-t border-slate-200">
                                    <span class="text-slate-400 block text-[10px] uppercase font-bold">Eligibility:</span>
                                    <span class="text-[11px] text-slate-700"><%= course.eligibility %></span>
                                </div>
                            </div>
                        </div>

                        <div class="flex items-center gap-2 pt-2">
                            <a href="/education/student/apply" class="flex-1 text-center py-2.5 px-3 bg-orange-600 hover:bg-orange-700 text-white rounded-xl text-xs font-bold transition shadow-sm">
                                <i class="fa-solid fa-file-pen mr-1"></i> Apply Online
                            </a>
                            <button type="button" onclick="openEnquiryModal()" class="py-2.5 px-3 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-xl text-xs font-bold transition">
                                Enquire
                            </button>
                        </div>
                    </div>
                <% }); %>
            <% } else { %>
                <div class="col-span-3 text-center py-16 bg-white rounded-2xl border border-slate-200">
                    <i class="fa-solid fa-magnifying-glass text-4xl text-slate-300 mb-3"></i>
                    <p class="text-sm font-bold text-slate-700">No courses found matching your filter criteria.</p>
                    <p class="text-xs text-slate-400 mt-1">Try resetting the filters or searching with another keyword.</p>
                </div>
            <% } %>
        </div>

    </div>
</main>

<%- include('footer') %>
