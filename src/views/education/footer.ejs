    <!-- Scripts -->
    <script>
        // Mobile Toggle with Icon switch
        const toggleBtn = document.getElementById('edu-mobile-toggle');
        const drawer = document.getElementById('edu-mobile-drawer');
        const toggleIcon = document.getElementById('edu-toggle-icon');
        if (toggleBtn && drawer) {
            toggleBtn.addEventListener('click', () => {
                const isHidden = drawer.classList.contains('hidden');
                if (isHidden) {
                    drawer.classList.remove('hidden');
                    if (toggleIcon) {
                        toggleIcon.classList.remove('fa-bars');
                        toggleIcon.classList.add('fa-xmark');
                    }
                } else {
                    drawer.classList.add('hidden');
                    if (toggleIcon) {
                        toggleIcon.classList.remove('fa-xmark');
                        toggleIcon.classList.add('fa-bars');
                    }
                }
            });
        }

        // Enquiry Modal
        const enquiryModal = document.getElementById('enquiryModal');
        function openEnquiryModal() {
            if (enquiryModal) {
                enquiryModal.classList.remove('hidden');
                enquiryModal.classList.add('flex');
            }
        }
        function closeEnquiryModal() {
            if (enquiryModal) {
                enquiryModal.classList.add('hidden');
                enquiryModal.classList.remove('flex');
            }
        }

        // Fee Modal
        const feeModal = document.getElementById('feeModal');
        function openFeeModal() {
            if (feeModal) {
                feeModal.classList.remove('hidden');
                feeModal.classList.add('flex');
            }
        }
        function closeFeeModal() {
            if (feeModal) {
                feeModal.classList.add('hidden');
                feeModal.classList.remove('flex');
            }
        }

        // Close when clicking backdrop
        window.addEventListener('click', (e) => {
            if (e.target === enquiryModal) closeEnquiryModal();
            if (e.target === feeModal) closeFeeModal();
        });
    </script>
