                    <a href="https://wa.me/919839332500?text=Hello%20BSRF%20Education" target="_blank" class="hover:text-green-400 transition" title="WhatsApp"><i class="fa-brands fa-whatsapp text-sm"></i></a>
                    <a href="#" class="hover:text-blue-400 transition" title="Facebook"><i class="fa-brands fa-facebook-f text-xs"></i></a>
                    <a href="#" class="hover:text-pink-400 transition" title="Instagram"><i class="fa-brands fa-instagram text-xs"></i></a>
                </div>
                <div class="h-3 w-px bg-slate-700"></div>
                <div class="flex items-center gap-3 text-xs">
                    <a href="/education/centre/login" class="text-amber-400 hover:text-amber-300 font-bold flex items-center gap-1">
                        <i class="fa-solid fa-building-columns text-[10px]"></i> Center Login
