<%- include('header') %>

<main class="flex-1">

    <!-- 1. HERO SECTION (Inspired by makemyshiksha) -->
    <section class="relative bg-gradient-to-br from-slate-900 via-blue-950 to-indigo-950 text-white overflow-hidden py-16 lg:py-24">
        <!-- Decorative Glow Orbs -->
        <div class="absolute -top-40 -left-40 w-96 h-96 bg-blue-600/30 rounded-full blur-[120px] pointer-events-none"></div>
        <div class="absolute -bottom-40 -right-40 w-96 h-96 bg-orange-500/25 rounded-full blur-[140px] pointer-events-none"></div>

        <div class="w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
                
                <!-- Left Hero Text -->
                <div class="lg:col-span-7 space-y-6 text-center lg:text-left">
                    <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-orange-500/20 border border-orange-500/40 text-orange-300 text-xs font-bold uppercase tracking-wider">
                        <span class="w-2 h-2 rounded-full bg-orange-400 animate-ping"></span>
                        Admissions Open For Session 2026 - 2027
                    </div>

                    <h1 class="text-3xl sm:text-5xl lg:text-6xl font-black tracking-tight leading-tight">
                        Shape Your Career With <br class="hidden sm:inline">
                        <span class="text-transparent bg-clip-text bg-gradient-to-r from-orange-400 via-amber-300 to-yellow-400">
                            Top Indian Universities
                        </span>
                    </h1>

                    <p class="text-base sm:text-lg text-slate-300 font-medium max-w-2xl">
                        India's trusted Admission & Education Guidance partner. Connect directly with UGC, AICTE, and NAAC A+ approved universities for <strong class="text-white">Online, Distance, Regular & Vocational</strong> courses.
                    </p>

                    <!-- Stats Badges -->
                    <div class="grid grid-cols-2 sm:grid-cols-3 gap-4 pt-4 max-w-lg mx-auto lg:mx-0">
                        <div class="bg-white/10 backdrop-blur-md p-4 rounded-2xl border border-white/10 text-center">
                            <span class="text-xs uppercase font-bold text-orange-400 block">Placement</span>
                            <span class="text-xl sm:text-2xl font-black text-white">100% Assist</span>
                        </div>
                        <div class="bg-white/10 backdrop-blur-md p-4 rounded-2xl border border-white/10 text-center">
                            <span class="text-xs uppercase font-bold text-yellow-400 block">Universities</span>
                            <span class="text-xl sm:text-2xl font-black text-white">50+ Top Tier</span>
                        </div>
                        <div class="bg-white/10 backdrop-blur-md p-4 rounded-2xl border border-white/10 text-center col-span-2 sm:col-span-1">
                            <span class="text-xs uppercase font-bold text-green-400 block">Enrolled</span>
                            <span class="text-xl sm:text-2xl font-black text-white">15,000+</span>
                        </div>
                    </div>

                    <!-- CTA Buttons -->
                    <div class="flex flex-wrap items-center justify-center lg:justify-start gap-4 pt-4">
                        <button type="button" onclick="openEnquiryModal()" class="px-7 py-3.5 bg-gradient-to-r from-orange-500 to-amber-500 hover:from-orange-600 hover:to-amber-600 text-white font-extrabold text-sm rounded-2xl shadow-xl hover:shadow-orange-500/25 transition-all transform hover:-translate-y-0.5 flex items-center gap-2">
                            <i class="fa-solid fa-graduation-cap"></i> Apply for Online Admission
                        </button>
                        <a href="#courses-section" class="px-7 py-3.5 bg-white/10 hover:bg-white/20 text-white font-bold text-sm rounded-2xl border border-white/20 transition flex items-center gap-2">
                            <i class="fa-solid fa-book-open"></i> Explore Courses
                        </a>
                    </div>
                </div>

                <!-- Right Quick Lead Form Card -->
                <div class="lg:col-span-5">
                    <div class="bg-white text-slate-800 rounded-3xl p-6 sm:p-8 shadow-2xl border border-slate-100 relative">
                        <div class="absolute -top-3 right-6 bg-gradient-to-r from-orange-500 to-amber-500 text-white text-[11px] font-extrabold px-3 py-1 rounded-full uppercase tracking-wider shadow-md">
                            Instant Call Back
                        </div>

                        <div class="mb-5">
                            <h3 class="text-xl font-black text-slate-900 tracking-tight">Need Admission Guidance?</h3>
                            <p class="text-xs text-slate-500 mt-1">Fill out the quick form and our university counselor will guide you within 15 minutes.</p>
                        </div>

                        <form action="/education/quick-enquiry" method="POST" class="space-y-3.5 text-xs">
                            <div>
                                <label class="block font-bold text-slate-700 mb-1">Your Full Name</label>
                                <input type="text" name="name" required placeholder="Student's Name" class="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 focus:outline-none focus:border-orange-500 bg-slate-50 text-xs">
                            </div>
                            <div class="grid grid-cols-2 gap-3">
                                <div>
                                    <label class="block font-bold text-slate-700 mb-1">Phone Number</label>
                                    <input type="tel" name="phone" required placeholder="10-digit Mobile" class="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 focus:outline-none focus:border-orange-500 bg-slate-50 text-xs">
                                </div>
                                <div>
                                    <label class="block font-bold text-slate-700 mb-1">City</label>
                                    <input type="text" name="city" placeholder="e.g. Gorakhpur" class="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 focus:outline-none focus:border-orange-500 bg-slate-50 text-xs">
                                </div>
                            </div>
                            <div>
                                <label class="block font-bold text-slate-700 mb-1">Course Interested In</label>
                                <input type="text" name="courseInterested" required placeholder="e.g. MBA, BCA, MCA, B.Tech" class="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 focus:outline-none focus:border-orange-500 bg-slate-50 text-xs">
                            </div>
                            <div>
                                <label class="block font-bold text-slate-700 mb-1">Learning Mode</label>
                                <select name="mode" class="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 focus:outline-none focus:border-orange-500 bg-slate-50 text-xs font-semibold">
                                    <option value="Online">100% Online Degree (Self-paced)</option>
                                    <option value="Distance">Distance Learning Mode</option>
                                    <option value="Regular">Regular On-Campus Degree</option>
                                    <option value="Vocational">Vocational / Skill Certified</option>
                                </select>
                            </div>
                            <button type="submit" class="w-full mt-2 bg-blue-900 hover:bg-blue-800 text-white font-black py-3 rounded-xl shadow-lg transition-all text-xs tracking-wider uppercase flex items-center justify-center gap-2">
                                <i class="fa-solid fa-headset text-orange-400"></i> Request Free Counseling
                            </button>
                        </form>

                        <div class="mt-4 pt-4 border-t border-slate-100 flex items-center justify-between text-[11px] text-slate-500">
                            <span class="flex items-center gap-1.5"><i class="fa-solid fa-lock text-green-600"></i> 100% Privacy</span>
                            <span class="flex items-center gap-1.5"><i class="fa-solid fa-bolt text-amber-500"></i> Zero Registration Fee</span>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </section>

    <!-- 2. FLEXIBLE LEARNING MODES (makemyshiksha style dark section) -->
    <section class="bg-slate-900 text-white py-14 border-y border-slate-800">
        <div class="w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="text-center max-w-2xl mx-auto mb-12">
                <span class="text-orange-500 text-xs font-black uppercase tracking-wider">Our Modes</span>
                <h2 class="text-2xl sm:text-3xl font-black mt-1">Flexible Learning Options</h2>
                <div class="w-16 h-1 bg-orange-500 mx-auto mt-3 rounded-full"></div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
                <!-- Mode 1 -->
                <div class="bg-slate-800/80 hover:bg-slate-800 p-6 rounded-2xl border border-slate-700/60 transition-all transform hover:-translate-y-1">
                    <div class="w-14 h-14 rounded-2xl bg-orange-500/20 text-orange-400 flex items-center justify-center text-2xl mb-4">
                        <i class="fa-solid fa-chalkboard-user"></i>
                    </div>
                    <h3 class="text-lg font-bold text-white mb-2">Regular Learning</h3>
                    <p class="text-xs text-slate-400 leading-relaxed">
                        For students focused on campus life, direct professor mentorship, and hands-on laboratory experiences.
                    </p>
                </div>

                <!-- Mode 2 -->
                <div class="bg-slate-800/80 hover:bg-slate-800 p-6 rounded-2xl border border-slate-700/60 transition-all transform hover:-translate-y-1">
                    <div class="w-14 h-14 rounded-2xl bg-blue-500/20 text-blue-400 flex items-center justify-center text-2xl mb-4">
                        <i class="fa-solid fa-laptop-file"></i>
                    </div>
                    <h3 class="text-lg font-bold text-white mb-2">Distance Learning</h3>
                    <p class="text-xs text-slate-400 leading-relaxed">
                        Ideal for working professionals and rural students. Study at your own pace without leaving your current job.
                    </p>
                </div>

                <!-- Mode 3 -->
                <div class="bg-slate-800/80 hover:bg-slate-800 p-6 rounded-2xl border border-slate-700/60 transition-all transform hover:-translate-y-1">
                    <div class="w-14 h-14 rounded-2xl bg-green-500/20 text-green-400 flex items-center justify-center text-2xl mb-4">
                        <i class="fa-solid fa-wifi"></i>
                    </div>
                    <h3 class="text-lg font-bold text-white mb-2">Online Degree</h3>
                    <p class="text-xs text-slate-400 leading-relaxed">
                        100% digital curriculum, live interactive webinars, remote online exams, and recognized UGC-DEB credentials.
                    </p>
                </div>

                <!-- Mode 4 -->
                <div class="bg-slate-800/80 hover:bg-slate-800 p-6 rounded-2xl border border-slate-700/60 transition-all transform hover:-translate-y-1">
                    <div class="w-14 h-14 rounded-2xl bg-purple-500/20 text-purple-400 flex items-center justify-center text-2xl mb-4">
                        <i class="fa-solid fa-briefcase"></i>
                    </div>
                    <h3 class="text-lg font-bold text-white mb-2">Vocational / Skill</h3>
                    <p class="text-xs text-slate-400 leading-relaxed">
                        Industry-aligned skill certifications, guaranteed apprenticeships, and job-ready practical training.
                    </p>
                </div>
            </div>
        </div>
    </section>

    <!-- 3. COURSE CATEGORIES & EXPLORER (Full Course Model) -->
    <section id="courses-section" class="py-16 bg-slate-50">
        <div class="w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            
            <div class="text-center max-w-2xl mx-auto mb-10">
                <span class="text-orange-600 text-xs font-black uppercase tracking-wider">Academic Offerings</span>
                <h2 class="text-3xl font-black text-slate-900 mt-1">Explore Courses & Degrees</h2>
                <p class="text-xs text-slate-500 mt-2">Comprehensive UG, PG, Diploma, Certificate and Doctoral programs with transparent fee structures and eligibility criteria.</p>
                <div class="w-16 h-1 bg-orange-500 mx-auto mt-3 rounded-full"></div>
            </div>

            <!-- Category Filter Tabs -->
            <div class="flex flex-wrap items-center justify-center gap-2 mb-10">
                <button type="button" onclick="filterCourses('All')" class="filter-tab-btn active px-5 py-2.5 rounded-full text-xs font-bold transition-all bg-orange-600 text-white shadow-md">
                    All Courses
                </button>
                <button type="button" onclick="filterCourses('UG')" class="filter-tab-btn px-5 py-2.5 rounded-full text-xs font-bold transition-all bg-white text-slate-700 border border-slate-200 hover:border-orange-500">
                    Undergraduate (UG)
                </button>
                <button type="button" onclick="filterCourses('PG')" class="filter-tab-btn px-5 py-2.5 rounded-full text-xs font-bold transition-all bg-white text-slate-700 border border-slate-200 hover:border-orange-500">
                    Postgraduate (PG)
                </button>
                <button type="button" onclick="filterCourses('Diploma')" class="filter-tab-btn px-5 py-2.5 rounded-full text-xs font-bold transition-all bg-white text-slate-700 border border-slate-200 hover:border-orange-500">
                    Diploma Programs
                </button>
                <button type="button" onclick="filterCourses('Certificate')" class="filter-tab-btn px-5 py-2.5 rounded-full text-xs font-bold transition-all bg-white text-slate-700 border border-slate-200 hover:border-orange-500">
                    Certificates
                </button>
                <button type="button" onclick="filterCourses('Doctoral')" class="filter-tab-btn px-5 py-2.5 rounded-full text-xs font-bold transition-all bg-white text-slate-700 border border-slate-200 hover:border-orange-500">
                    Ph.D. / Doctoral
                </button>
            </div>

            <!-- Courses Grid -->
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" id="courses-grid">
                <% if (courses && courses.length > 0) { %>
                    <% courses.forEach(function(course) { %>
                        <div class="course-card-item bg-white rounded-2xl p-6 border border-slate-200 hover:border-orange-400 hover:shadow-xl transition-all flex flex-col justify-between" data-category="<%= course.category %>">
                            <div>
                                <div class="flex items-center justify-between mb-3">
                                    <span class="text-[10px] font-black uppercase px-2.5 py-1 rounded-md bg-blue-50 text-blue-700 border border-blue-200">
                                        <%= course.category %> &bull; <%= course.stream %>
                                    </span>
                                    <span class="text-[11px] font-bold text-emerald-600 bg-emerald-50 px-2 py-0.5 rounded-full">
                                        <i class="fa-solid fa-graduation-cap"></i> <%= course.mode %>
                                    </span>
                                </div>

                                <h3 class="text-base font-extrabold text-slate-900 leading-snug mb-1">
                                    <%= course.title %>
                                </h3>

                                <p class="text-xs text-orange-600 font-semibold mb-3 flex items-center gap-1.5">
                                    <i class="fa-solid fa-building-columns"></i> <%= course.universityName || 'Partner University' %>
                                </p>

                                <div class="space-y-1.5 text-xs text-slate-600 my-4 bg-slate-50 p-3 rounded-xl border border-slate-100">
                                    <div class="flex justify-between">
                                        <span class="text-slate-400">Duration:</span>
                                        <span class="font-bold text-slate-700"><%= course.duration %></span>
                                    </div>
                                    <div class="flex justify-between">
                                        <span class="text-slate-400">Annual Fee:</span>
                                        <span class="font-bold text-blue-900">₹<%= (course.feePerYear || 25000).toLocaleString('en-IN') %> / yr</span>
                                    </div>
                                    <div class="pt-1 border-t border-slate-200">
                                        <span class="text-slate-400 block text-[10px] uppercase font-bold">Eligibility:</span>
                                        <span class="text-[11px] text-slate-700 font-medium"><%= course.eligibility %></span>
                                    </div>
                                </div>
                            </div>

                            <div class="flex items-center gap-2 pt-2">
                                <a href="/education/student/apply" class="flex-1 text-center py-2.5 px-3 bg-orange-600 hover:bg-orange-700 text-white rounded-xl text-xs font-bold transition shadow-sm">
                                    <i class="fa-solid fa-file-pen mr-1"></i> Apply Online
                                </a>
                                <button type="button" onclick="openEnquiryModal()" class="py-2.5 px-3 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-xl text-xs font-bold transition" title="Fee details">
                                    <i class="fa-solid fa-circle-info"></i> Details
                                </button>
                            </div>
                        </div>
                    <% }); %>
                <% } else { %>
                    <div class="col-span-3 text-center py-12 bg-white rounded-2xl border border-slate-200">
                        <i class="fa-solid fa-graduation-cap text-4xl text-slate-300 mb-3"></i>
                        <p class="text-sm font-semibold text-slate-600">Courses are being synced. Please refresh in a moment.</p>
                    </div>
                <% } %>
            </div>

            <!-- View All Courses Link -->
            <div class="text-center mt-10">
                <a href="/education/courses" class="inline-flex items-center gap-2 px-8 py-3.5 bg-blue-900 hover:bg-blue-800 text-white font-bold text-xs rounded-xl shadow-md transition">
                    <i class="fa-solid fa-list-check"></i> View All Available Programs & Specializations
                </a>
            </div>

        </div>
    </section>

    <!-- 4. ACADEMIC PARTNERS (makemyshiksha style university grid) -->
    <section class="py-16 bg-white border-t border-slate-200" id="universities-section">
        <div class="w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
            
            <div class="max-w-2xl mx-auto mb-12">
                <span class="text-orange-600 text-xs font-black uppercase tracking-wider">Recognized & Accredited</span>
                <h2 class="text-3xl font-black text-slate-900 mt-1">Our Partner Universities</h2>
                <p class="text-xs text-slate-500 mt-2">Collaborating with India's top UGC, AICTE & NAAC A+ Accredited institutions</p>
                <div class="w-16 h-1 bg-orange-500 mx-auto mt-3 rounded-full"></div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 text-left">
                <% if (universities && universities.length > 0) { %>
                    <% universities.forEach(function(uni) { %>
                        <div class="bg-slate-50 hover:bg-white p-6 rounded-2xl border border-slate-200 hover:border-blue-400 hover:shadow-xl transition-all flex flex-col justify-between">
                            <div>
                                <div class="flex items-center justify-between mb-4">
                                    <div class="w-12 h-12 rounded-xl bg-white p-2 shadow-sm border border-slate-200 flex items-center justify-center font-bold text-blue-900 text-sm">
                                        <i class="fa-solid fa-university text-orange-500 text-xl"></i>
                                    </div>
                                    <span class="text-[10px] font-bold text-blue-700 bg-blue-100 px-2 py-0.5 rounded-full">
                                        Est. <%= uni.establishedYear || '2008' %>
                                    </span>
                                </div>

                                <h3 class="text-base font-extrabold text-slate-900 mb-1">
                                    <%= uni.name %>
                                </h3>

                                <p class="text-xs text-slate-500 mb-3 flex items-center gap-1">
                                    <i class="fa-solid fa-location-dot text-red-500"></i> <%= uni.location || 'India' %>
                                </p>

                                <p class="text-xs text-slate-600 line-clamp-2 mb-4">
                                    <%= uni.description %>
                                </p>

                                <!-- Approvals tags -->
                                <div class="flex flex-wrap gap-1.5 mb-4">
                                    <% if (uni.approvals && uni.approvals.length > 0) { %>
                                        <% uni.approvals.forEach(function(app) { %>
                                            <span class="text-[10px] font-bold px-2 py-0.5 bg-green-50 text-green-700 rounded border border-green-200">
                                                <i class="fa-solid fa-shield-check mr-0.5"></i> <%= app %>
                                            </span>
                                        <% }); %>
                                    <% } else { %>
                                        <span class="text-[10px] font-bold px-2 py-0.5 bg-green-50 text-green-700 rounded">UGC Approved</span>
                                    <% } %>
                                </div>
                            </div>

                            <div class="pt-4 border-t border-slate-200 flex items-center justify-between">
                                <span class="text-[11px] font-bold text-slate-500">
                                    Last Date: <strong class="text-orange-600"><%= uni.admissionDeadline || 'Open' %></strong>
                                </span>
                                <a href="/education/student/apply" class="text-xs font-bold text-blue-900 hover:text-orange-600 flex items-center gap-1">
                                    Apply <i class="fa-solid fa-arrow-right text-[10px]"></i>
                                </a>
                            </div>
                        </div>
                    <% }); %>
                <% } %>
            </div>

            <div class="mt-10">
                <a href="/education/universities" class="px-6 py-3 bg-slate-100 hover:bg-slate-200 text-slate-800 rounded-xl text-xs font-bold transition inline-flex items-center gap-2 border border-slate-200">
                    <i class="fa-solid fa-building-columns"></i> View All Partner Universities & Accreditation Details
                </a>
            </div>

        </div>
    </section>

    <!-- 5. HOW IT WORKS / ADMISSION ROADMAP (makemyshiksha process section) -->
    <section class="py-16 bg-slate-900 text-white">
        <div class="w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            
            <div class="text-center max-w-2xl mx-auto mb-14">
                <span class="text-orange-400 text-xs font-black uppercase tracking-wider">Step-by-Step Procedure</span>
                <h2 class="text-3xl font-black mt-1">Begin Your Future With Us</h2>
                <p class="text-xs text-slate-400 mt-2">Hassle-free 5-step admission process from anywhere in India</p>
                <div class="w-16 h-1 bg-orange-500 mx-auto mt-3 rounded-full"></div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-6">
                
                <!-- Step 1 -->
                <div class="bg-slate-800/90 p-5 rounded-2xl border border-slate-700 text-center relative group hover:border-orange-500 transition">
                    <div class="w-8 h-8 rounded-full bg-orange-500 text-white font-extrabold text-xs flex items-center justify-center mx-auto mb-3">1</div>
                    <div class="text-2xl text-orange-400 mb-2"><i class="fa-solid fa-file-pen"></i></div>
                    <h4 class="text-sm font-bold text-white mb-1">Online Form</h4>
                    <p class="text-xs text-slate-400">Fill your personal & academic details.</p>
                </div>

                <!-- Step 2 -->
                <div class="bg-slate-800/90 p-5 rounded-2xl border border-slate-700 text-center relative group hover:border-orange-500 transition">
                    <div class="w-8 h-8 rounded-full bg-orange-500 text-white font-extrabold text-xs flex items-center justify-center mx-auto mb-3">2</div>
                    <div class="text-2xl text-orange-400 mb-2"><i class="fa-solid fa-upload"></i></div>
                    <h4 class="text-sm font-bold text-white mb-1">Upload Docs</h4>
                    <p class="text-xs text-slate-400">Upload 10th/12th marksheets & ID proof.</p>
                </div>

                <!-- Step 3 -->
                <div class="bg-slate-800/90 p-5 rounded-2xl border border-slate-700 text-center relative group hover:border-orange-500 transition">
                    <div class="w-8 h-8 rounded-full bg-orange-500 text-white font-extrabold text-xs flex items-center justify-center mx-auto mb-3">3</div>
                    <div class="text-2xl text-orange-400 mb-2"><i class="fa-solid fa-user-check"></i></div>
                    <h4 class="text-sm font-bold text-white mb-1">Verification</h4>
                    <p class="text-xs text-slate-400">University eligibility verification.</p>
                </div>

                <!-- Step 4 -->
                <div class="bg-slate-800/90 p-5 rounded-2xl border border-slate-700 text-center relative group hover:border-orange-500 transition">
                    <div class="w-8 h-8 rounded-full bg-orange-500 text-white font-extrabold text-xs flex items-center justify-center mx-auto mb-3">4</div>
                    <div class="text-2xl text-orange-400 mb-2"><i class="fa-solid fa-envelope-open-text"></i></div>
                    <h4 class="text-sm font-bold text-white mb-1">Offer Letter</h4>
                    <p class="text-xs text-slate-400">Receive your official admission letter.</p>
                </div>

                <!-- Step 5 -->
                <div class="bg-slate-800/90 p-5 rounded-2xl border border-slate-700 text-center relative group hover:border-orange-500 transition">
                    <div class="w-8 h-8 rounded-full bg-orange-500 text-white font-extrabold text-xs flex items-center justify-center mx-auto mb-3">5</div>
                    <div class="text-2xl text-orange-400 mb-2"><i class="fa-solid fa-circle-check"></i></div>
                    <h4 class="text-sm font-bold text-white mb-1">Enrollment</h4>
                    <p class="text-xs text-slate-400">Pay fee, get LMS access & ID card.</p>
                </div>

            </div>

        </div>
    </section>

    <!-- 6. FREE EDUCATION PROJECT CALLOUT BANNER -->
