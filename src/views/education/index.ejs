<script>
    function filterCourses(category) {
        // Update active tab buttons
        const tabs = document.querySelectorAll('.filter-tab-btn');
        tabs.forEach(t => {
            t.classList.remove('bg-orange-600', 'text-white', 'shadow-md');
            t.classList.add('bg-white', 'text-slate-700');
        });
        event.currentTarget.classList.remove('bg-white', 'text-slate-700');
        event.currentTarget.classList.add('bg-orange-600', 'text-white', 'shadow-md');

        // Filter cards
        const cards = document.querySelectorAll('.course-card-item');
        cards.forEach(card => {
            const cardCat = card.getAttribute('data-category');
            if (category === 'All' || cardCat === category) {
                card.style.display = 'flex';
            } else {
                card.style.display = 'none';
            }
        });
    }
</script>

