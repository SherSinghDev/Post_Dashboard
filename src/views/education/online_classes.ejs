<%- include('header') %>

<main class="flex-1 py-12 bg-slate-50">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">

        <div class="text-center max-w-3xl mx-auto mb-10">
            <span class="text-orange-600 text-xs font-black uppercase tracking-wider">Interactive Digital Learning</span>
            <h1 class="text-3xl sm:text-4xl font-black text-slate-900 mt-1">Live & Scheduled Online Classes</h1>
            <p class="text-xs text-slate-500 mt-2">Attend interactive lectures conducted by university faculties, participate in doubts clearing sessions, and access recorded archives.</p>
            <div class="w-16 h-1 bg-orange-500 mx-auto mt-3 rounded-full"></div>
        </div>

        <!-- Schedule Notice -->
        <div class="bg-blue-50 border border-blue-200 rounded-2xl p-4 mb-8 flex items-center justify-between flex-wrap gap-4 text-xs">
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-xl bg-blue-600 text-white flex items-center justify-center text-lg flex-shrink-0">
                    <i class="fa-solid fa-video"></i>
                </div>
                <div>
                    <h4 class="font-bold text-blue-950">Next Live Interactive Session Begins Today at 11:00 AM</h4>
                    <p class="text-blue-800">Please keep your Student ID or Roll number handy before joining.</p>
                </div>
            </div>
            <a href="/education/student/login" class="px-4 py-2 bg-blue-900 text-white rounded-xl font-bold hover:bg-blue-800 transition">
                Student LMS Login
            </a>
        </div>

        <!-- Class Timetable -->
        <div class="bg-white rounded-3xl shadow-sm border border-slate-200 overflow-hidden">
            <div class="p-6 border-b border-slate-100 flex items-center justify-between">
                <h3 class="font-black text-base text-slate-900 flex items-center gap-2">
                    <i class="fa-solid fa-calendar-days text-orange-500"></i> Weekly Lecture Schedule
                </h3>
                <span class="text-[11px] font-bold text-emerald-600 bg-emerald-50 px-2.5 py-1 rounded-full border border-emerald-200">
                    <i class="fa-solid fa-circle text-[8px] animate-pulse"></i> Live Digital Classroom
                </span>
            </div>

            <div class="divide-y divide-slate-100">
                <% if (classes && classes.length > 0) { %>
                    <% classes.forEach(function(cls) { %>
                        <div class="p-6 flex flex-col md:flex-row items-start md:items-center justify-between gap-4 hover:bg-slate-50/80 transition">
                            <div class="space-y-1">
                                <div class="flex items-center gap-2">
                                    <span class="text-[10px] font-black uppercase px-2 py-0.5 rounded bg-blue-100 text-blue-800">
                                        <%= cls.courseStream %>
                                    </span>
                                    <span class="text-xs font-bold text-orange-600 flex items-center gap-1">
                                        <i class="fa-regular fa-clock"></i> <%= cls.time %>
                                    </span>
                                    <span class="text-xs text-slate-400">&bull; <%= cls.date %></span>
                                </div>
                                <h4 class="text-base font-extrabold text-slate-900"><%= cls.title %></h4>
                                <p class="text-xs text-slate-500">
                                    <strong>Subject:</strong> <%= cls.subject %> | <strong>Faculty:</strong> <%= cls.instructor %>
                                </p>
                            </div>

                            <div class="flex items-center gap-3 w-full md:w-auto">
                                <a href="<%= cls.joinUrl %>" target="_blank" class="flex-1 md:flex-initial px-5 py-2.5 bg-gradient-to-r from-orange-500 to-amber-500 hover:from-orange-600 hover:to-amber-600 text-white font-extrabold text-xs rounded-xl shadow-md transition flex items-center justify-center gap-1.5">
                                    <i class="fa-solid fa-video"></i> Join Classroom
                                </a>
                            </div>
                        </div>
                    <% }); %>
                <% } else { %>
                    <div class="p-8 text-center text-xs text-slate-500">No scheduled classes right now. Check back soon.</div>
                <% } %>
            </div>
        </div>

    </div>
</main>

<%- include('footer') %>
