<%- include('../header') %>

<main class="flex-1 py-12 bg-slate-50">
    <div class="max-w-3xl mx-auto px-4">

        <div class="bg-white rounded-3xl p-8 sm:p-10 shadow-xl border border-slate-200">
            <div class="text-center mb-8">
                <span class="text-orange-600 text-xs font-black uppercase tracking-wider">Admission Session 2026-2027</span>
                <h1 class="text-2xl sm:text-3xl font-black text-slate-900 mt-1">Online Admission Application Form</h1>
                <p class="text-xs text-slate-500 mt-1">Select university & course, review eligibility, and submit your enrollment application.</p>
                <div class="w-16 h-1 bg-orange-500 mx-auto mt-3 rounded-full"></div>
            </div>

            <form action="/education/student/apply" method="POST" class="space-y-6 text-xs">
                
                <!-- University & Course Selection -->
                <div class="p-5 bg-blue-50/60 rounded-2xl border border-blue-200 space-y-4">
                    <h3 class="font-bold text-blue-950 text-xs uppercase tracking-wider flex items-center gap-1.5">
                        <i class="fa-solid fa-graduation-cap text-orange-500"></i> Step 1: Select University & Program
                    </h3>

                    <div>
                        <label class="block font-bold text-slate-700 mb-1">Target University *</label>
                        <select id="uniSelect" name="universityId" required onchange="filterCoursesByUni()" class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 bg-white text-xs font-semibold">
                            <option value="">-- Choose University --</option>
                            <% if (universities && universities.length > 0) { %>
                                <% universities.forEach(function(u) { %>
                                    <option value="<%= u._id %>"><%= u.name %> (<%= u.location %>)</option>
                                <% }); %>
                            <% } %>
                        </select>
                    </div>

                    <div>
                        <label class="block font-bold text-slate-700 mb-1">Desired Course / Program *</label>
                        <select id="courseSelect" name="courseId" required class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 bg-white text-xs font-semibold">
                            <option value="">-- Select Course (Pick University First) --</option>
                            <% if (courses && courses.length > 0) { %>
                                <% courses.forEach(function(c) { %>
                                    <option value="<%= c._id %>" data-uni="<%= c.universityId %>" data-fee="<%= c.feePerYear %>">
                                        <%= c.title %> - <%= c.category %> (<%= c.duration %>) - ₹<%= (c.feePerYear || 25000).toLocaleString('en-IN') %>/yr
                                    </option>
                                <% }); %>
                            <% } %>
                        </select>
                    </div>

                    <div>
                        <label class="block font-bold text-slate-700 mb-1">Learning Mode</label>
                        <select name="mode" class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 bg-white text-xs font-semibold">
                            <option value="Online">100% Online Degree (Self-paced)</option>
                            <option value="Distance">Distance Learning</option>
                            <option value="Regular">Regular Campus Mode</option>
                            <option value="Vocational / Hybrid">Vocational / Skill Hybrid</option>
                        </select>
                    </div>
                </div>

                <!-- Personal Information -->
                <div class="p-5 bg-slate-50 rounded-2xl border border-slate-200 space-y-4">
                    <h3 class="font-bold text-slate-800 text-xs uppercase tracking-wider flex items-center gap-1.5">
                        <i class="fa-solid fa-user text-blue-900"></i> Step 2: Student & Parent Details
                    </h3>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        <div>
                            <label class="block font-bold text-slate-700 mb-1">Applicant Name</label>
                            <input type="text" value="<%= student.fullName %>" class="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 bg-slate-100 text-slate-700 font-bold" readonly>
                        </div>
                        <div>
                            <label class="block font-bold text-slate-700 mb-1">Father's Name *</label>
                            <input type="text" name="fatherName" value="<%= student.fatherName || '' %>" required placeholder="Father's full name" class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 bg-white">
                        </div>
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        <div>
                            <label class="block font-bold text-slate-700 mb-1">Mobile Contact *</label>
                            <input type="tel" name="phone" value="<%= student.phone %>" required class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 bg-white font-semibold">
                        </div>
                        <div>
                            <label class="block font-bold text-slate-700 mb-1">Email Address</label>
                            <input type="email" value="<%= student.email %>" class="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 bg-slate-100 text-slate-700 font-semibold" readonly>
                        </div>
                    </div>
                </div>

                <div class="p-4 bg-amber-50 rounded-2xl border border-amber-200 text-amber-900 text-[11px] leading-relaxed">
                    <i class="fa-solid fa-circle-info text-amber-600"></i> After submitting this form, you can immediately upload your 10th marksheet, 12th marksheet, photo, and Aadhar card on the student dashboard.
                </div>

                <button type="submit" class="w-full py-4 bg-gradient-to-r from-orange-500 to-amber-500 hover:from-orange-600 hover:to-amber-600 text-white font-black text-xs uppercase tracking-wider rounded-xl shadow-lg transition flex items-center justify-center gap-2">
                    <i class="fa-solid fa-paper-plane"></i> Submit University Admission Application
                </button>
            </form>
        </div>

    </div>
</main>

<script>
    function filterCoursesByUni() {
        const uniId = document.getElementById('uniSelect').value;
        const courseSelect = document.getElementById('courseSelect');
        const options = courseSelect.querySelectorAll('option');

        options.forEach(opt => {
            if (!opt.value) return; // Keep the placeholder
            const optUni = opt.getAttribute('data-uni');
            if (!uniId || optUni === uniId) {
                opt.style.display = 'block';
            } else {
                opt.style.display = 'none';
            }
        });
    }
</script>

<%- include('../footer') %>
