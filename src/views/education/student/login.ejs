<%- include('../header') %>

<main class="flex-1 py-14 bg-slate-50 flex items-center justify-center">
    <div class="max-w-md w-full mx-4">
        
        <div class="bg-white rounded-3xl p-8 sm:p-10 shadow-xl border border-slate-200">
            <div class="text-center mb-8">
                <div class="w-16 h-16 rounded-2xl bg-blue-100 text-blue-900 mx-auto flex items-center justify-center text-2xl shadow-inner mb-3">
                    <i class="fa-solid fa-user-graduate"></i>
                </div>
                <h1 class="text-2xl font-black text-slate-900 tracking-tight">Student Portal Login</h1>
                <p class="text-xs text-slate-500 mt-1">Access your admission status, fee receipts, LMS & notices</p>
            </div>

            <% if (typeof error !== 'undefined' && error) { %>
                <div class="mb-5 p-3.5 bg-red-50 border border-red-200 text-red-700 text-xs rounded-xl flex items-center gap-2">
                    <i class="fa-solid fa-circle-exclamation flex-shrink-0"></i>
                    <span><%= error %></span>
                </div>
            <% } %>

            <form action="/education/student/login" method="POST" class="space-y-4 text-xs">
                <div>
                    <label class="block font-bold text-slate-700 mb-1">Student ID / Registered Email / Mobile</label>
                    <div class="relative">
                        <i class="fa-regular fa-envelope absolute left-3.5 top-3.5 text-slate-400"></i>
                        <input type="text" name="emailOrId" required value="student@bsrf.org" placeholder="e.g. student@bsrf.org or BSRF-STU-1001" class="w-full pl-10 pr-3.5 py-3 rounded-xl border border-slate-200 focus:outline-none focus:border-orange-500 bg-slate-50 text-xs font-semibold">
                    </div>
                </div>

                <div>
                    <div class="flex justify-between items-center mb-1">
                        <label class="font-bold text-slate-700">Password</label>
                        <a href="tel:+919839332500" class="text-[11px] text-orange-600 font-bold hover:underline">Forgot password?</a>
                    </div>
                    <div class="relative">
                        <i class="fa-solid fa-lock absolute left-3.5 top-3.5 text-slate-400"></i>
                        <input type="password" name="password" required value="123456" placeholder="Enter password" class="w-full pl-10 pr-3.5 py-3 rounded-xl border border-slate-200 focus:outline-none focus:border-orange-500 bg-slate-50 text-xs font-semibold">
                    </div>
                    <p class="text-[11px] text-slate-400 mt-1">Demo login: <strong>student@bsrf.org</strong> | Password: <strong>123456</strong></p>
                </div>

                <button type="submit" class="w-full py-3.5 bg-blue-900 hover:bg-blue-800 text-white font-black text-xs uppercase tracking-wider rounded-xl shadow-lg transition flex items-center justify-center gap-2">
                    <i class="fa-solid fa-right-to-bracket"></i> Login to Student Portal
                </button>
            </form>

            <div class="mt-6 pt-6 border-t border-slate-100 text-center text-xs text-slate-500">
                Don't have a student account? 
                <a href="/education/student/register" class="font-extrabold text-orange-600 hover:underline">Register Online</a>
            </div>
        </div>

    </div>
</main>

<%- include('../footer') %>
