<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Application & Fee Receipt - <%= application.applicationNo %></title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <style>
        @media print {
            .no-print { display: none !important; }
            body { background: white !important; padding: 0 !important; }
        }
    </style>
</head>
<body class="bg-slate-100 p-4 sm:p-10 font-sans text-slate-800">

    <div class="max-w-3xl mx-auto bg-white p-8 sm:p-12 rounded-3xl shadow-lg border border-slate-200">
        
        <!-- Header -->
        <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 border-b-2 border-slate-200 pb-6 mb-6">
            <div class="flex items-center gap-3">
                <img src="https://bsrfindia.com/images/logo/logo.png" alt="BSRF Logo" class="h-14 sm:h-16 w-auto" onerror="this.src='/images/logo/logo.png'">
                <div>
                    <h1 class="text-xl sm:text-2xl font-black text-blue-900 tracking-tight">BSRF EDUCATION</h1>
                    <p class="text-xs text-slate-500 font-semibold uppercase">Binupur Seva Research Foundation</p>
                    <p class="text-[11px] text-slate-400">Panchsheel Colony Chipyana Buzurg Gaziabad Uttar Pradesh 201009 | Toll-Free: +91 9403893297</p>
                </div>
            </div>
            <div class="text-left sm:text-right">
                <span class="inline-block px-3 py-1 bg-green-100 text-green-800 rounded-full font-bold text-xs uppercase tracking-wider mb-1">
                    Official Receipt
                </span>
                <p class="text-xs text-slate-500">Date: <strong><%= new Date(application.createdAt).toLocaleDateString('en-IN') %></strong></p>
            </div>
        </div>

        <!-- Receipt Title -->
        <div class="bg-slate-50 p-4 rounded-2xl border border-slate-200 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-2 mb-6 text-xs">
            <div>
                <span class="text-slate-400 block font-bold uppercase text-[10px]">Application Number</span>
                <span class="text-base font-black text-blue-900 tracking-wider"><%= application.applicationNo %></span>
            </div>
            <div class="text-left sm:text-right">
                <span class="text-slate-400 block font-bold uppercase text-[10px]">Admission Status</span>
                <span class="text-xs font-bold text-orange-600 uppercase"><%= application.status %></span>
            </div>
        </div>

        <!-- Details Grid -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 text-xs mb-8">
            <div class="space-y-3">
                <h4 class="font-bold text-slate-400 uppercase text-[10px] tracking-wider border-b pb-1">Student Particulars</h4>
                <div>
                    <span class="text-slate-500 block">Student Name:</span>
                    <span class="font-bold text-slate-800 text-sm"><%= application.studentName %></span>
                </div>
                <div>
                    <span class="text-slate-500 block">Father's Name:</span>
                    <span class="font-bold text-slate-800"><%= application.fatherName || 'N/A' %></span>
                </div>
                <div>
                    <span class="text-slate-500 block">Contact Phone:</span>
                    <span class="font-bold text-slate-800"><%= application.phone %></span>
                </div>
                <div>
                    <span class="text-slate-500 block">Email Address:</span>
                    <span class="font-bold text-slate-800"><%= application.email %></span>
                </div>
            </div>

            <div class="space-y-3">
                <h4 class="font-bold text-slate-400 uppercase text-[10px] tracking-wider border-b pb-1">University & Course Details</h4>
                <div>
                    <span class="text-slate-500 block">Enrolled University:</span>
                    <span class="font-bold text-blue-900 text-sm"><%= application.universityName %></span>
                </div>
                <div>
                    <span class="text-slate-500 block">Course Enrolled:</span>
                    <span class="font-bold text-slate-800"><%= application.courseTitle %></span>
                </div>
                <div>
                    <span class="text-slate-500 block">Degree Level & Mode:</span>
                    <span class="font-bold text-slate-800"><%= application.category %> &bull; <%= application.mode %></span>
                </div>
                <div>
                    <span class="text-slate-500 block">Franchise / Centre:</span>
                    <span class="font-bold text-slate-800"><%= application.centerName || 'Direct Online' %></span>
                </div>
            </div>
        </div>

        <!-- Fee Ledger Table -->
        <div class="overflow-x-auto border border-slate-200 rounded-2xl mb-6">
            <table class="w-full text-xs text-left">
                <thead class="bg-slate-100 text-slate-600 uppercase text-[10px] font-bold">
                    <tr>
                        <th class="p-3">Fee Description</th>
                        <th class="p-3">Payment Mode</th>
                        <th class="p-3">Transaction / UTR ID</th>
                        <th class="p-3 text-right">Amount Paid</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100 font-semibold">
                    <tr>
                        <td class="p-3">Annual Course & Registration Fee</td>
                        <td class="p-3"><%= application.paymentMode || 'Online' %></td>
                        <td class="p-3 text-slate-500"><%= application.paymentTxnId || 'Direct Payment' %></td>
                        <td class="p-3 text-right font-black text-blue-900">₹<%= (application.feePaid || 0).toLocaleString('en-IN') %></td>
                    </tr>
                </tbody>
                <tfoot class="bg-slate-50 font-bold">
                    <tr>
                        <td colspan="3" class="p-3 text-right text-slate-600">Total Program Fee:</td>
                        <td class="p-3 text-right text-slate-800">₹<%= (application.feeAmount || 0).toLocaleString('en-IN') %></td>
                    </tr>
                </tfoot>
            </table>
        </div>

        <!-- Signatures & QR -->
        <div class="flex flex-col sm:flex-row justify-between items-start sm:items-end gap-4 pt-6 border-t border-slate-200 text-xs">
            <div>
                <img src="https://api.qrserver.com/v1/create-qr-code/?size=80x80&data=<%= encodeURIComponent(application.applicationNo + ' - ' + application.studentName) %>" alt="QR" class="w-16 h-16 rounded border p-1 mb-1">
                <span class="text-[10px] text-slate-400">Scan to verify authentic receipt</span>
            </div>
            <div class="text-left sm:text-center">
                <div class="h-10 border-b border-slate-400 w-36 mb-1"></div>
                <span class="text-[11px] font-bold text-slate-700 block">Authorized Signature</span>
                <span class="text-[10px] text-slate-400">Registrar, BSRF Education</span>
            </div>
        </div>

        <!-- Print Action -->
        <div class="mt-8 text-center no-print">
            <button onclick="window.print()" class="px-6 py-2.5 bg-blue-900 hover:bg-blue-800 text-white font-bold text-xs rounded-xl shadow transition">
                <i class="fa-solid fa-print mr-1"></i> Print / Save as PDF
            </button>
        </div>

    </div>

</body>
</html>
