<%- include('header') %>

<main class="flex-1 py-12 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6">

        <!-- Page Header -->
        <div class="text-center max-w-3xl mx-auto mb-12">
            <span class="text-orange-600 text-xs font-black uppercase tracking-wider">Accredited Academic Partners</span>
            <h1 class="text-3xl sm:text-4xl font-black text-slate-900 mt-1">UGC & NAAC A+ Approved Universities</h1>
            <p class="text-xs text-slate-500 mt-2">BSRF Education connects you with premier state, deemed and central universities offering recognized distance and digital education.</p>
            <div class="w-16 h-1 bg-orange-500 mx-auto mt-3 rounded-full"></div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            <% if (universities && universities.length > 0) { %>
                <% universities.forEach(function(uni) { %>
                    <div class="bg-white rounded-3xl p-6 sm:p-7 border border-slate-200 shadow-sm hover:shadow-xl hover:border-blue-400 transition-all flex flex-col justify-between">
                        <div>
                            <div class="flex items-center justify-between mb-4">
                                <div class="w-14 h-14 rounded-2xl bg-slate-50 p-2 border border-slate-200 flex items-center justify-center font-bold text-blue-900 text-xl shadow-inner">
                                    <i class="fa-solid fa-university text-orange-500"></i>
                                </div>
                                <span class="text-xs font-bold text-blue-900 bg-blue-50 px-2.5 py-1 rounded-full border border-blue-200">
                                    <%= uni.ranking || 'Top Ranked' %>
                                </span>
                            </div>

                            <h3 class="text-lg font-black text-slate-900 leading-snug mb-1">
                                <%= uni.name %>
                            </h3>

                            <p class="text-xs text-slate-500 mb-3 flex items-center gap-1.5">
                                <i class="fa-solid fa-location-dot text-red-500"></i> <%= uni.location %>
                            </p>

                            <p class="text-xs text-slate-600 leading-relaxed mb-4">
                                <%= uni.description %>
                            </p>

                            <!-- Approvals Tags -->
                            <div class="flex flex-wrap gap-1.5 mb-5">
                                <% if (uni.approvals && uni.approvals.length > 0) { %>
                                    <% uni.approvals.forEach(function(app) { %>
                                        <span class="text-[10px] font-bold px-2 py-0.5 bg-emerald-50 text-emerald-700 rounded-md border border-emerald-200">
                                            <i class="fa-solid fa-shield-check mr-0.5"></i> <%= app %>
                                        </span>
                                    <% }); %>
                                <% } %>
                            </div>

                            <div class="bg-slate-50 p-3.5 rounded-2xl border border-slate-100 text-xs space-y-1.5 mb-4">
                                <div class="flex justify-between">
                                    <span class="text-slate-400">Total Courses:</span>
                                    <span class="font-bold text-slate-800"><%= uni.courseCount || 12 %> Programs</span>
                                </div>
                                <div class="flex justify-between">
                                    <span class="text-slate-400">Admission Deadline:</span>
                                    <span class="font-extrabold text-orange-600"><%= uni.admissionDeadline || '30th November 2026' %></span>
                                </div>
                            </div>
                        </div>

                        <div class="pt-2 flex items-center gap-2">
                            <a href="/education/courses?search=<%= encodeURIComponent(uni.name.split(' ')[0]) %>" class="flex-1 text-center py-2.5 bg-blue-900 hover:bg-blue-800 text-white rounded-xl text-xs font-bold transition shadow-sm">
                                View Courses
                            </a>
                            <a href="/education/student/apply" class="py-2.5 px-4 bg-orange-600 hover:bg-orange-700 text-white rounded-xl text-xs font-bold transition">
                                Apply
                            </a>
                        </div>
                    </div>
                <% }); %>
            <% } %>
        </div>

    </div>
</main>

<%- include('footer') %>
