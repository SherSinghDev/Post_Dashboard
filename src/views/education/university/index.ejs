<%- include('../header') %>

<main class="flex-1 py-10 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6">

        <!-- Top Header Banner -->
        <div class="bg-gradient-to-r from-blue-900 via-indigo-900 to-slate-900 rounded-3xl p-6 sm:p-8 text-white shadow-xl mb-8 flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
            <div class="flex items-center gap-4">
                <div class="w-16 h-16 rounded-2xl bg-white/10 p-1 border border-white/20 flex items-center justify-center text-3xl font-black text-amber-400">
                    <i class="fa-solid fa-building-columns"></i>
                </div>
                <div>
                    <span class="text-[11px] font-bold text-amber-400 uppercase tracking-wider block">Institutional Management</span>
                    <h1 class="text-2xl sm:text-3xl font-black tracking-tight">University Management Panel</h1>
                    <p class="text-xs text-slate-300 mt-0.5">Manage partner universities, degree programs, deadlines, and application records</p>
                </div>
            </div>

            <div class="flex flex-wrap items-center gap-2 sm:gap-3">
                <button type="button" onclick="document.getElementById('addUniModal').classList.remove('hidden')" class="px-4 sm:px-5 py-2.5 bg-orange-600 hover:bg-orange-500 text-white font-bold text-xs rounded-xl shadow transition flex items-center gap-2">
                    <i class="fa-solid fa-plus"></i> Add New University
                </button>
                <button type="button" onclick="document.getElementById('addCourseModal').classList.remove('hidden')" class="px-4 sm:px-5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white font-bold text-xs rounded-xl shadow transition flex items-center gap-2">
                    <i class="fa-solid fa-book-medical"></i> Add Program / Course
                </button>
            </div>
        </div>

        <!-- University Cards & Accordion -->
        <div class="space-y-6">
            <% if (universities && universities.length > 0) { %>
                <% universities.forEach(function(u) { %>
                    <div class="bg-white rounded-3xl p-6 sm:p-8 shadow-sm border border-slate-200 space-y-6">
                        
                        <!-- University Header & Summary -->
                        <div class="flex flex-col lg:flex-row justify-between items-start lg:items-center gap-4 pb-6 border-b border-slate-100">
                            <div class="flex items-center gap-4">
                                <div class="w-14 h-14 rounded-2xl bg-slate-50 border border-slate-200 flex items-center justify-center text-xl text-blue-900 shadow-sm flex-shrink-0">
                                    <i class="fa-solid fa-university text-orange-500"></i>
                                </div>
                                <div>
                                    <div class="flex items-center gap-2">
                                        <span class="text-[10px] font-bold px-2 py-0.5 bg-slate-100 text-slate-700 rounded"><%= u.code || 'UNI' %></span>
                                        <span class="text-[10px] font-bold px-2 py-0.5 bg-emerald-100 text-emerald-800 rounded">Active Partner</span>
                                    </div>
                                    <h2 class="text-xl font-extrabold text-slate-900 mt-0.5"><%= u.name %></h2>
                                    <p class="text-xs text-slate-500"><i class="fa-solid fa-location-dot text-red-500"></i> <%= u.location %></p>
                                </div>
                            </div>

                            <div class="flex flex-wrap items-center gap-4 text-xs">
                                <div class="bg-slate-50 px-4 py-2 rounded-xl border border-slate-200">
                                    <span class="text-slate-400 block text-[10px] font-bold uppercase">Admission Deadline</span>
                                    <span class="font-extrabold text-orange-600"><%= u.admissionDeadline || '30 Nov 2026' %></span>
                                </div>
                                <div class="bg-slate-50 px-4 py-2 rounded-xl border border-slate-200">
                                    <span class="text-slate-400 block text-[10px] font-bold uppercase">Courses</span>
                                    <span class="font-black text-blue-900"><%= u.uniCourses ? u.uniCourses.length : 0 %></span>
                                </div>
                                <div class="bg-slate-50 px-4 py-2 rounded-xl border border-slate-200">
                                    <span class="text-slate-400 block text-[10px] font-bold uppercase">Applications</span>
                                    <span class="font-black text-emerald-700"><%= u.uniApplications ? u.uniApplications.length : 0 %></span>
                                </div>
                                <form action="/education/university/delete/<%= u._id %>" method="POST" onsubmit="return confirm('Delete this university and all its courses?')">
                                    <button type="submit" class="p-2 text-red-500 hover:text-red-700 rounded-lg hover:bg-red-50 transition" title="Delete University">
                                        <i class="fa-solid fa-trash"></i>
                                    </button>
                                </form>
                            </div>
                        </div>

                        <!-- Courses Under This University -->
                        <div>
                            <div class="flex justify-between items-center mb-3">
                                <h3 class="font-black text-sm text-slate-800 flex items-center gap-2">
                                    <i class="fa-solid fa-graduation-cap text-orange-500"></i> Programs Offered & Fee Structures
                                </h3>
                                <span class="text-[11px] text-slate-400 font-bold"><%= u.uniCourses ? u.uniCourses.length : 0 %> Total Programs</span>
                            </div>

                            <% if (u.uniCourses && u.uniCourses.length > 0) { %>
                                <div class="overflow-x-auto rounded-2xl border border-slate-200">
                                    <table class="w-full text-xs text-left">
                                        <thead class="bg-slate-50 text-slate-600 uppercase text-[10px] font-bold">
                                            <tr>
                                                <th class="p-3">Program Title</th>
                                                <th class="p-3">Category / Stream</th>
                                                <th class="p-3">Duration & Mode</th>
                                                <th class="p-3">Tuition Fee</th>
                                                <th class="p-3">Eligibility</th>
                                                <th class="p-3 text-right">Actions</th>
                                            </tr>
                                        </thead>
                                        <tbody class="divide-y divide-slate-100">
                                            <% u.uniCourses.forEach(function(c) { %>
                                                <tr class="hover:bg-slate-50/80 transition">
                                                    <td class="p-3 font-bold text-slate-900"><%= c.title %></td>
                                                    <td class="p-3"><span class="px-2 py-0.5 rounded bg-blue-50 text-blue-800 text-[10px] font-bold"><%= c.category %> &bull; <%= c.stream %></span></td>
                                                    <td class="p-3 text-slate-600"><%= c.duration %> (<%= c.mode %>)</td>
                                                    <td class="p-3 font-black text-blue-900">₹<%= (c.feePerYear || 25000).toLocaleString('en-IN') %>/yr</td>
                                                    <td class="p-3 text-slate-500 max-w-xs truncate"><%= c.eligibility %></td>
                                                    <td class="p-3 text-right">
                                                        <form action="/education/course/delete/<%= c._id %>" method="POST" onsubmit="return confirm('Delete this course?')">
                                                            <button type="submit" class="text-red-500 hover:text-red-700 text-xs font-bold" title="Delete Course">
                                                                <i class="fa-solid fa-trash"></i>
                                                            </button>
                                                        </form>
                                                    </td>
                                                </tr>
                                            <% }); %>
                                        </tbody>
                                    </table>
                                </div>
                            <% } else { %>
                                <p class="text-xs text-slate-400 italic">No courses currently added under this university.</p>
                            <% } %>
                        </div>

                        <!-- Applications Received for this University -->
                        <div>
                            <div class="flex justify-between items-center mb-3">
                                <h3 class="font-black text-sm text-slate-800 flex items-center gap-2">
                                    <i class="fa-solid fa-users text-blue-900"></i> Applications Received (<%= u.uniApplications ? u.uniApplications.length : 0 %>)
                                </h3>
                            </div>

                            <% if (u.uniApplications && u.uniApplications.length > 0) { %>
                                <div class="overflow-x-auto rounded-2xl border border-slate-200">
                                    <table class="w-full text-xs text-left">
                                        <thead class="bg-slate-50 text-slate-600 uppercase text-[10px] font-bold">
                                            <tr>
                                                <th class="p-3">Application No</th>
                                                <th class="p-3">Student Name</th>
                                                <th class="p-3">Course Applied</th>
                                                <th class="p-3">Status</th>
                                                <th class="p-3">Fee Paid</th>
                                                <th class="p-3">Date</th>
                                            </tr>
                                        </thead>
                                        <tbody class="divide-y divide-slate-100 font-semibold">
                                            <% u.uniApplications.forEach(function(a) { %>
                                                <tr>
                                                    <td class="p-3 text-blue-900 font-bold"><%= a.applicationNo %></td>
                                                    <td class="p-3 text-slate-800"><%= a.studentName %> (<%= a.phone %>)</td>
                                                    <td class="p-3 text-slate-600"><%= a.courseTitle %></td>
                                                    <td class="p-3">
                                                        <span class="px-2 py-0.5 rounded text-[10px] font-bold <%= a.status === 'Approved' ? 'bg-emerald-100 text-emerald-800' : 'bg-amber-100 text-amber-800' %>">
                                                            <%= a.status %>
                                                        </span>
                                                    </td>
                                                    <td class="p-3 font-bold text-slate-800">₹<%= (a.feePaid || 0).toLocaleString('en-IN') %></td>
                                                    <td class="p-3 text-slate-400"><%= new Date(a.createdAt).toLocaleDateString('en-IN') %></td>
                                                </tr>
                                            <% }); %>
                                        </tbody>
                                    </table>
                                </div>
                            <% } else { %>
                                <p class="text-xs text-slate-400 italic">No student applications received yet for this university.</p>
                            <% } %>
                        </div>

                    </div>
                <% }); %>
            <% } %>
        </div>

    </div>
</main>

<!-- MODAL: Add New University -->
<div id="addUniModal" class="fixed inset-0 z-[1000] hidden items-center justify-center p-3 sm:p-4 bg-black/60 backdrop-blur-sm">
    <div class="bg-white rounded-3xl max-w-xl w-full max-h-[90vh] overflow-y-auto p-5 sm:p-8 shadow-2xl border border-slate-200 animate-in fade-in zoom-in">
        <div class="flex justify-between items-center mb-6">
            <h3 class="text-xl font-black text-slate-900">Add New Partner University</h3>
            <button type="button" onclick="document.getElementById('addUniModal').classList.add('hidden')" class="text-slate-400 hover:text-slate-600">
                <i class="fa-solid fa-xmark text-xl"></i>
            </button>
        </div>
        <form action="/education/university/add" method="POST" class="space-y-4 text-xs">
            <div>
                <label class="block font-bold text-slate-700 mb-1">University Name *</label>
                <input type="text" name="name" required placeholder="e.g. SRM University, Sharda University" class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 bg-slate-50 text-xs font-semibold">
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                <div>
                    <label class="block font-bold text-slate-700 mb-1">Location / City *</label>
                    <input type="text" name="location" required placeholder="e.g. Greater Noida, UP" class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 bg-slate-50 text-xs">
                </div>
                <div>
                    <label class="block font-bold text-slate-700 mb-1">State</label>
                    <input type="text" name="state" placeholder="e.g. Uttar Pradesh" class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 bg-slate-50 text-xs">
                </div>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                <div>
                    <label class="block font-bold text-slate-700 mb-1">Website URL</label>
                    <input type="url" name="website" placeholder="https://..." class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 bg-slate-50 text-xs">
                </div>
                <div>
                    <label class="block font-bold text-slate-700 mb-1">Admission Deadline</label>
                    <input type="text" name="admissionDeadline" placeholder="e.g. 30th November 2026" class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 bg-slate-50 text-xs">
                </div>
            </div>
            <div>
                <label class="block font-bold text-slate-700 mb-1">Approvals (Comma-separated)</label>
                <input type="text" name="approvals" placeholder="e.g. UGC, AICTE, NAAC A+, WES" value="UGC Approved, AICTE, NAAC A+" class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 bg-slate-50 text-xs">
            </div>
            <div>
                <label class="block font-bold text-slate-700 mb-1">Short Description</label>
                <textarea name="description" rows="2" placeholder="Brief overview of university offerings..." class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 bg-slate-50 text-xs"></textarea>
            </div>
            <button type="submit" class="w-full py-3.5 bg-orange-600 hover:bg-orange-700 text-white font-black text-xs uppercase tracking-wider rounded-xl shadow-md transition">
                Save & Add University
            </button>
        </form>
    </div>
</div>

<!-- MODAL: Add New Course -->
<div id="addCourseModal" class="fixed inset-0 z-[1000] hidden items-center justify-center p-3 sm:p-4 bg-black/60 backdrop-blur-sm">
    <div class="bg-white rounded-3xl max-w-xl w-full max-h-[90vh] overflow-y-auto p-5 sm:p-8 shadow-2xl border border-slate-200 animate-in fade-in zoom-in">
        <div class="flex justify-between items-center mb-6">
            <h3 class="text-xl font-black text-slate-900">Add Course Under University</h3>
            <button type="button" onclick="document.getElementById('addCourseModal').classList.add('hidden')" class="text-slate-400 hover:text-slate-600">
                <i class="fa-solid fa-xmark text-xl"></i>
            </button>
        </div>
        <form action="/education/course/add" method="POST" class="space-y-4 text-xs">
            <div>
                <label class="block font-bold text-slate-700 mb-1">Select University *</label>
                <select name="universityId" required class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 bg-slate-50 text-xs font-semibold">
                    <% universities.forEach(function(u) { %>
                        <option value="<%= u._id %>"><%= u.name %></option>
                    <% }); %>
                </select>
            </div>
            <div>
                <label class="block font-bold text-slate-700 mb-1">Course Title *</label>
                <input type="text" name="title" required placeholder="e.g. Master of Business Administration (MBA)" class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 bg-slate-50 text-xs font-semibold">
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                <div>
                    <label class="block font-bold text-slate-700 mb-1">Category</label>
                    <select name="category" class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 bg-slate-50 text-xs font-semibold">
                        <option value="UG">UG (Undergraduate)</option>
                        <option value="PG">PG (Postgraduate)</option>
                        <option value="Diploma">Diploma</option>
                        <option value="Certificate">Certificate</option>
                        <option value="Doctoral">Doctoral / Ph.D.</option>
                        <option value="Vocational">Vocational</option>
                    </select>
                </div>
                <div>
                    <label class="block font-bold text-slate-700 mb-1">Stream</label>
                    <select name="stream" class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 bg-slate-50 text-xs font-semibold">
                        <option value="Management">Management</option>
                        <option value="Computer Science">Computer Science</option>
                        <option value="Engineering">Engineering</option>
                        <option value="Arts & Humanities">Arts & Humanities</option>
                        <option value="Commerce">Commerce</option>
                        <option value="Law">Law</option>
                        <option value="Pharmacy">Pharmacy</option>
                        <option value="Agriculture">Agriculture</option>
                        <option value="Doctoral Programmes">Doctoral Programmes</option>
                    </select>
                </div>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
                <div>
                    <label class="block font-bold text-slate-700 mb-1">Duration</label>
                    <input type="text" name="duration" value="3 Years" class="w-full px-3 py-2 rounded-xl border border-slate-300 bg-slate-50 text-xs">
                </div>
                <div>
                    <label class="block font-bold text-slate-700 mb-1">Mode</label>
                    <select name="mode" class="w-full px-3 py-2 rounded-xl border border-slate-300 bg-slate-50 text-xs font-semibold">
                        <option value="Online">Online</option>
                        <option value="Distance">Distance</option>
                        <option value="Regular">Regular</option>
                        <option value="Vocational / Hybrid">Vocational</option>
                    </select>
                </div>
                <div>
                    <label class="block font-bold text-slate-700 mb-1">Annual Fee (₹)</label>
                    <input type="number" name="feePerYear" value="30000" class="w-full px-3 py-2 rounded-xl border border-slate-300 bg-slate-50 text-xs font-bold text-blue-900">
                </div>
            </div>
            <div>
                <label class="block font-bold text-slate-700 mb-1">Eligibility Criteria</label>
                <input type="text" name="eligibility" value="10+2 with minimum 45% marks from recognized board" class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 bg-slate-50 text-xs">
            </div>
            <button type="submit" class="w-full py-3.5 bg-blue-900 hover:bg-blue-800 text-white font-black text-xs uppercase tracking-wider rounded-xl shadow-md transition">
                Save & Add Course
            </button>
        </form>
    </div>
</div>

<%- include('../footer') %>
