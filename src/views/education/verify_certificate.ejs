<%- include('header') %>

<main class="flex-1 py-12 bg-slate-50">
    <div class="max-w-4xl mx-auto px-4 sm:px-6">

        <div class="text-center max-w-2xl mx-auto mb-10">
            <span class="text-orange-600 text-xs font-black uppercase tracking-wider">Document Authenticity</span>
            <h1 class="text-3xl sm:text-4xl font-black text-slate-900 mt-1">Online Certificate Verification</h1>
            <p class="text-xs text-slate-500 mt-2">Verify degree certificates, marksheets, and diplomas issued by partner universities and BSRF Education.</p>
            <div class="w-16 h-1 bg-orange-500 mx-auto mt-3 rounded-full"></div>
        </div>

        <!-- Verification Search Card -->
        <div class="bg-white rounded-3xl p-6 sm:p-8 shadow-sm border border-slate-200 mb-8">
            <form action="/education/verify-certificate" method="POST" class="space-y-4">
                <div>
                    <label class="block font-bold text-slate-800 text-xs mb-1.5">
                        Enter Certificate Number or Student Roll Number *
                    </label>
                    <div class="relative">
                        <i class="fa-solid fa-stamp absolute left-4 top-3.5 text-slate-400"></i>
                        <input type="text" name="query" value="<%= typeof query !== 'undefined' ? query : '' %>" required placeholder="e.g. BSRF-CERT-2026-8899 or NIU2023BCA1092" class="w-full pl-11 pr-4 py-3 rounded-2xl border border-slate-200 focus:outline-none focus:border-orange-500 bg-slate-50 text-xs sm:text-sm font-semibold tracking-wide">
                    </div>
                </div>

                <div class="flex items-center justify-between flex-wrap gap-4 pt-2">
                    <p class="text-[11px] text-slate-400">Demo test code: <strong class="text-blue-900 cursor-pointer" onclick="document.getElementsByName('query')[0].value='BSRF-CERT-2026-8899'">BSRF-CERT-2026-8899</strong></p>
                    <button type="submit" class="px-7 py-3 bg-gradient-to-r from-orange-500 to-amber-500 hover:from-orange-600 hover:to-amber-600 text-white font-black text-xs rounded-xl shadow-md transition flex items-center gap-2">
                        <i class="fa-solid fa-shield-halved"></i> Verify Document Now
                    </button>
                </div>
            </form>
        </div>

        <!-- Result Section -->
        <% if (searched) { %>
            <% if (certificate) { %>
                <div class="bg-white rounded-3xl p-8 shadow-xl border-2 border-emerald-500 relative overflow-hidden animate-in fade-in zoom-in duration-200">
                    <div class="absolute top-0 right-0 bg-emerald-600 text-white text-[11px] font-black px-6 py-1.5 rounded-bl-2xl uppercase tracking-wider flex items-center gap-1.5 shadow">
                        <i class="fa-solid fa-circle-check"></i> Authenticity Verified
                    </div>

                    <div class="flex items-center gap-4 mb-6">
                        <div class="w-16 h-16 rounded-2xl bg-emerald-100 text-emerald-700 flex items-center justify-center text-3xl">
                            <i class="fa-solid fa-file-certificate"></i>
                        </div>
                        <div>
                            <span class="text-[10px] uppercase font-bold text-slate-400">Document Verification Report</span>
                            <h3 class="text-xl font-black text-slate-900"><%= certificate.studentName %></h3>
                            <p class="text-xs text-orange-600 font-bold"><%= certificate.courseTitle %></p>
                        </div>
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs bg-slate-50 p-5 rounded-2xl border border-slate-200 mb-6">
                        <div>
                            <span class="text-slate-400 text-[10px] font-bold block uppercase">Certificate No:</span>
                            <span class="font-bold text-slate-800"><%= certificate.certificateNo %></span>
                        </div>
                        <div>
                            <span class="text-slate-400 text-[10px] font-bold block uppercase">Roll Number:</span>
                            <span class="font-bold text-slate-800"><%= certificate.rollNo %></span>
                        </div>
                        <div>
                            <span class="text-slate-400 text-[10px] font-bold block uppercase">Awarding University:</span>
                            <span class="font-bold text-blue-900"><%= certificate.universityName %></span>
                        </div>
                        <div>
                            <span class="text-slate-400 text-[10px] font-bold block uppercase">Issue Date:</span>
                            <span class="font-bold text-slate-800"><%= certificate.issueDate %></span>
                        </div>
                        <div>
                            <span class="text-slate-400 text-[10px] font-bold block uppercase">Grade / Division:</span>
                            <span class="font-bold text-emerald-700"><%= certificate.grade %> (<%= certificate.percentage %>)</span>
                        </div>
                        <div>
                            <span class="text-slate-400 text-[10px] font-bold block uppercase">Verification Status:</span>
                            <span class="font-bold text-emerald-600 flex items-center gap-1">
                                <i class="fa-solid fa-check"></i> Genuine & Authentic Record
                            </span>
                        </div>
                    </div>

                    <div class="flex items-center justify-between flex-wrap gap-4 pt-4 border-t border-slate-100">
                        <span class="text-[11px] text-slate-400">Digitally signed & verified against central education repository.</span>
                        <button type="button" onclick="window.print()" class="px-5 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-xl text-xs font-bold transition flex items-center gap-1.5">
                            <i class="fa-solid fa-print"></i> Print Verification Sheet
                        </button>
                    </div>
                </div>
            <% } else { %>
                <div class="bg-red-50 border border-red-200 rounded-3xl p-8 text-center text-red-700">
                    <i class="fa-solid fa-circle-exclamation text-4xl text-red-500 mb-3"></i>
                    <h3 class="text-base font-black">No Certificate Found</h3>
                    <p class="text-xs text-red-600 mt-1">We could not locate any active record matching "<%= query %>". Please recheck the certificate or roll number and try again.</p>
                </div>
            <% } %>
        <% } %>

    </div>
</main>

<%- include('footer') %>
