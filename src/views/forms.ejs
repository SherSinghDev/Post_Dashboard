                })
                    .then((data) => {
                        return data.json()
                    })
                    .then((result) => {
                        // console.log(result);
                        if (result.success) {
                            Swal.fire({
                                title: "Success!",
                                icon: "success",
                                text: "Patient Form is Approved!",
                                timer: 2000

                            });
                            e.target.reset()
                            $('.approve-modal').modal('hide');
                            window.location.reload()
