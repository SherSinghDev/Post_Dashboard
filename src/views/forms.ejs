<!DOCTYPE html>
<html lang="en">
<%- include('./globals/head') %>

<body>
    <%- include('./globals/preloader') %>

    <div id="main-wrapper">
        <%- include('globals/navHeader') %>
        <%- include('globals/header') %>

        <!--**********************************
            Sidebar start
        ***********************************-->
        <% if(user.role=="Admin" || user.role=="Coordinator" || user.role=="doc" ){%>
            <%- include('./globals/sidebar') %>
                <%} else{ %>
            <%- include('./globals/doctor_sidebar') %>
        <%}%>

                        <!--**********************************
            Sidebar end
        ***********************************-->

                        <!--**********************************
          Content body start
    ***********************************-->
                        <div class="content-body">
                            <div class="container">
                                <div class="d-flex justify-content-between mb-4 flex-wrap">
                                    <div class="input-group w-auto mb-2 mb-xxl-0">
                                        <input type="text" placeholder="Search by Reg No., name, city, or mobile"
                                            class="form-control search-input" style="width: 300px;">
                                        <% if(user.assignedForm) { %>
                                        <div class="ms-3 d-flex gap-2 align-items-center" id="doctorStatusFilterButtons">
                                            <button type="button" class="btn btn-primary btn-sm doc-filter-btn" onclick="filterDoctorStatus('all', this)">All</button>
                                            <button type="button" class="btn btn-outline-primary btn-sm doc-filter-btn" onclick="filterDoctorStatus('filled', this)">Filled</button>
                                            <button type="button" class="btn btn-outline-primary btn-sm doc-filter-btn" onclick="filterDoctorStatus('unfilled', this)">Unfilled</button>
                                        </div>
                                        <% } %>
                                    </div>
                                    <% if(!user.assignedForm) { %>
                                    <div class="text-end">
                                        <a href="/patientform/<%= user.userId %>" target="_blank"
                                            class="btn btn-primary me-1 add-btn">+ New
                                            Patient</a>
                                    </div>
                                    <% } %>


                                </div>

                                <div class="row">
                                    <div class="col-xl-12">
                                        <div class="card mt-2">
                                            <div class="card-body">
                                                <div class="table-responsive text-center">
                                                    <table class="table table-striped align-middle main-table">
                                                        <thead>
                                                            <tr>
                                                                <th>Reg No.</th>
                                                                <th>Name</th>
                                                                <th>Gender</th>
                                                                <th>City</th>
                                                                <th>State</th>
                                                                <th>Mobile</th>
                                                                <th>Duration</th>
                                                                <th>Type</th>
                                                                <th>Patient Of</th>
                                                                <th>Desease Name</th>
                                                                <th>Report</th>
                                                                <th>Patient Status</th>
                                                                <th>Doctor Status</th>
                                                                <th>Support Status</th>
                                                                <th>Office Status</th>
                                                                <th>Admin Status</th>
                                                                <th>Post Office Status</th>
                                                                <th>delivery Status</th>
                                                                <th>Tracking Id</th>
                                                                <th>Track</th>
                                                                <th>Applied On</th>
                                                                <th>Actions</th>
                                                            </tr>
                                                        </thead>
                                                        <tbody>
                                                            <% if (applications.length> 0) { %>
                                                                <% applications.forEach((app, index)=> { %>
                                                                    <tr id="tr-<%= app._id %>" class="patient-row" data-doctor-status="<%= (app.otherStatus && app.otherStatus.doctorStatus) ? 'filled' : 'unfilled' %>">
                                                                        <td>
                                                                            <%= app.registerNo %>
                                                                        </td>
                                                                        <td>
                                                                            <%= app.patientName %>
                                                                        </td>
                                                                        <td>
                                                                            <%= app.gender %>
                                                                        </td>
                                                                        <td>
                                                                            <%= app.cityOrDistrict %>
                                                                        </td>
                                                                        <td>
                                                                            <%= app.state %>
                                                                        </td>
                                                                        <td>
                                                                            <a href="tel:+91 <%= app.mobileNumber %>">
                                                                                <%= app.mobileNumber %>
                                                                            </a>
                                                                        </td>
                                                                        <td>
                                                                            <%= app.duration || 'not selected' %>
                                                                        </td>

                                                                        <td>
                                                                            <%= app.type || 'NA' %>
                                                                        </td>
                                                                        <td>
                                                                            <%= app.referrer? app.referrer?.name + ' ( '
                                                                                + 'id : ' + + app.referrer.userId + ' )'
                                                                                : 'NA' %>
                                                                        </td>
                                                                        <td>
                                                                            <%= app.diseaseName %>
                                                                        </td>
                                                                        <td>
                                                                            <a href="javascript:void(0)"
                                                                                data-id="<%= app._id %>"
                                                                                class="view-btn">View Report</a>
                                                                        </td>
                                                                        <td>
                                                                            <%= app.otherStatus?.patientStatus || 'N/A'
                                                                                %>
                                                                        </td>
                                                                        <td>
                                                                            <%= app.otherStatus?.doctorStatus || 'N/A'
                                                                                %>
                                                                        </td>
                                                                        <td>
                                                                            <%= app.otherStatus?.supportStatus || 'N/A'
                                                                                %>
                                                                        </td>
                                                                        <td>
                                                                            <%= app.otherStatus?.officeStatus || 'N/A'
                                                                                %>
                                                                        </td>
                                                                        <td>
                                                                            <%= app.otherStatus?.adminStatus || 'N/A' %>
                                                                        </td>
                                                                        <td>
                                                                            <%= app.otherStatus?.postOfficeStatus
                                                                                || 'N/A' %>
                                                                        </td>
                                                                        <td>
                                                                            <%= app.otherStatus?.deliveryStatus || 'N/A'
                                                                                %>
                                                                        </td>
                                                                        <td>
                                                                            <%= app.otherStatus?.trackingIdStatus
                                                                                || 'N/A' %>
                                                                        </td>
                                                                        <td><a href="javascript:void(0)"
                                                                                data-id="<%= app.otherStatus?.trackingIdStatus%>"
                                                                                class="btn-link me-1 track-btn">Track</a>
                                                                        </td>

                                                                        <td>
                                                                            <%= new
                                                                                Date(app.createdAt).toLocaleDateString()
                                                                                %>
                                                                        </td>

                                                                        <td>
                                                                            <a href="https://wa.me/+91<%= app.mobileNumber %>"
                                                                                class=" btn btn-sm btn-success">
                                                                                <i class="fa-brands fa-whatsapp"
                                                                                    style="color:white;font-size: 16px;"></i>
                                                                                <!-- <i class="fa-solid fa-whatsapp"
                                                                                    style="color:white;"></i> -->
                                                                            </a>
                                                                            <a href="tel:+91 <%= app.mobileNumber %>"
                                                                                class=" btn btn-sm btn-info">
                                                                                <i class="fa-solid fa-phone"
                                                                                    style="color:white;"></i>
                                                                            </a>

                                                                            <a href="javascript:void(0)"
                                                                                data-id="<%= app._id %>"
                                                                                class="btn btn-sm btn-success approve-btn"><i
                                                                                    class="fa-solid fa-pen"></i></a>

                                                                            <% if(!user.assignedForm) { %>
                                                                            <a href="javascript:void(0)"
                                                                                data-id="<%= app._id %>"
                                                                                class="btn btn-sm btn-danger delete-btn">
                                                                                <i class="fa-solid fa-trash"></i>
                                                                            </a>
                                                                            <% } %>
                                                                            <% if (typeof notInterested !== 'undefined' && notInterested) { %>
                                                                                <a href="javascript:void(0)"
                                                                                    data-id="<%= app._id %>"
                                                                                    class="btn btn-sm btn-warning restore-btn" title="Restore back to unverified">
                                                                                    <i class="fa-solid fa-rotate-left" style="color:white;"></i>
                                                                                </a>
                                                                            <% } %>
                                                                        </td>
                                                                    </tr>
                                                                    <% }) %>
                                                                        <% } else { %>
                                                                            <tr>
                                                                                <td colspan="10"
                                                                                    class="text-center text-muted">
                                                                                    No Data found</td>
                                                                            </tr>
                                                                            <% } %>
                                                        </tbody>
                                                    </table>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <!--**********************************
          Content body end
    ***********************************-->

                        <!-- View Modal -->
                        <div class="modal fade view-modal bd-example-modal-xl" tabindex="-1" aria-hidden="true">
                            <div class="modal-dialog modal-lg">
                                <div class="modal-content">
                                    <div class="modal-header">
                                        <h5 class="modal-title">Medical Report</h5>
                                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                    </div>
                                    <div class="modal-body">
                                        <div id="view-details" class="p-2">

                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>


                        <!-- Approve Modal -->
                        <!-- <div class="modal fade approve-modal bd-example-modal-xl" tabindex="-1" aria-hidden="true">
                            <div class="modal-dialog modal-lg">
                                <div class="modal-content">
                                    <div class="modal-header">
                                        <h5 class="modal-title">Form Approval</h5>
                                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                    </div>
                                    <div class="modal-body">
                                        <div id="approve-details">
                                            <div class="basic-form">

                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div> -->


                        <div class="modal fade approve-modal bd-example-modal-xl" tabindex="-1" aria-hidden="true">
                            <div class="modal-dialog modal-lg">
                                <div class="modal-content">
                                    <div class="modal-header">
                                        <h5 class="modal-title">Edit Details</h5>
                                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                    </div>
                                    <div class="modal-body">
                                        <div id="approve-details">
                                            <div class="basic-form">
                                                <form action="/submit-patient-form" method="POST" id="approve-form"
                                                    enctype="multipart/form-data">

                                                    <!-- Basic Info -->
                                                    <div class="form-section-title">Personal Information</div>
                                                    <div class="row mb-3">
                                                        <div class="col-lg-6">
                                                            <label class="form-label">मरीज का नाम / Patient's Name
                                                                *</label>
                                                            <input type="text" name="patientName" class="form-control"
                                                                required />
                                                        </div>
                                                        <div class="col-lg-6">
                                                            <label class="form-label">पिता/पति का नाम / Father's or
                                                                Husband's Name *</label>
                                                            <input type="text" name="fatherOrHusbandName"
                                                                class="form-control" required />
                                                        </div>
                                                    </div>

                                                    <div class="mb-3">
                                                        <label class="form-label">लिंग / Gender *</label>
                                                        <div>
                                                            <div class="form-check form-check-inline">
                                                                <input class="form-check-input" type="radio"
                                                                    name="gender" value="Male" required />
                                                                <label class="form-check-label">Male</label>
                                                            </div>
                                                            <div class="form-check form-check-inline">
                                                                <input class="form-check-input" type="radio"
                                                                    name="gender" value="Female" />
                                                                <label class="form-check-label">Female</label>
                                                            </div>
                                                            <div class="form-check form-check-inline">
                                                                <input class="form-check-input" type="radio"
                                                                    name="gender" value="Other" />
                                                                <label class="form-check-label">Other</label>
                                                            </div>
                                                        </div>
                                                    </div>

                                                    <!-- Address Section -->
                                                    <div class="form-section-title mt-4">Address Details</div>
                                                    <div class="row mb-3">
                                                        <div class="col-lg-6">
                                                            <label class="form-label">मकान / सड़क / House / Flat /
                                                                Street *</label>
                                                            <input type="text" name="houseOrStreet" class="form-control"
                                                                required />
                                                        </div>
                                                        <div class="col-lg-6">
                                                            <label class="form-label">इलाका / गाँव / मोहल्ला / Locality
                                                                *</label>
                                                            <input type="text" name="locality" class="form-control"
                                                                required />
                                                        </div>
                                                    </div>

                                                    <div class="row mb-3">
                                                        <div class="col-lg-6">
                                                            <label class="form-label">शहर / तहसील / जिला / City /
                                                                District *</label>
                                                            <input type="text" name="cityOrDistrict"
                                                                class="form-control" required />
                                                        </div>
                                                        <div class="col-lg-6">
                                                            <label class="form-label">राज्य / State *</label>
                                                            <input type="text" name="state" class="form-control"
                                                                required />
                                                        </div>
                                                    </div>

                                                    <div class="row mb-3">
                                                        <div class="col-lg-6">
                                                            <label class="form-label">LANDMARK / नज़दीकी प्रसिद्ध स्थान
                                                                *</label>
                                                            <input type="text" name="landmark" class="form-control"
                                                                required />
                                                        </div>
                                                        <div class="col-lg-6">
                                                            <label class="form-label">पिन कोड / Pin Code *</label>
                                                            <input type="text" name="pinCode" class="form-control"
                                                                required />
                                                        </div>
                                                    </div>

                                                    <!-- Contact Section -->
                                                    <div class="form-section-title mt-4">Contact Details</div>
                                                    <div class="row mb-3">
                                                        <div class="col-lg-6">
                                                            <label class="form-label">मोबाइल नंबर / Mobile Number
                                                                *</label>
                                                            <input type="text" name="mobileNumber" class="form-control"
                                                                required />
                                                        </div>
                                                        <div class="col-lg-6">
                                                            <label class="form-label">Emergency Contact Number</label>
                                                            <input type="text" name="emergencyContact"
                                                                class="form-control" />
                                                        </div>
                                                    </div>





                                                    <!-- Medical Info -->
                                                    <div class="form-section-title mt-4">Medical Details</div>
                                                    <div class="mb-3">
                                                        <label class="form-label">बीमारी का लक्षण / Name of Disease
                                                            *</label>
                                                        <input type="text" name="diseaseName" class="form-control"
                                                            required />
                                                    </div>
                                                    <div class="mb-3">
                                                        <label class="form-label">औषधि अवधि / Treatment Duration
                                                            *</label>
                                                        <select name="duration" style="padding-block: 11px;"
                                                            class="form-select" required>
                                                            <option value="">Select Treatment Duration</option>
                                                            <option value="3 Months 299">3 Months 299</option>
                                                            <option value="6 Months 499">6 Months 499</option>
                                                            <option value="12 Months 799">12 Months 799</option>
                                                            <option value="3 Months">3 Months</option>
                                                            <option value="6 Months">6 Months</option>
                                                            <option value="9 Months">9 Months</option>
                                                            <option value="12 Months">12 Months</option>
                                                        </select>
                                                    </div>
                                                    <!-- <div class="mb-3">
                                                        <label class="form-label">Reports / यदि हो तो</label>
                                                        <input type="file" name="medicalReport" class="form-control" />
                                                    </div> -->
                                                    <% if(user.role=="Admin" || user.type=='stockorder' ){%>
                                                        <div class="row">
                                                            <div class="mb-3 col-md-6">
                                                                <label class="form-label">Patient Status</label>
                                                                <input type="text" name="patientStatus"
                                                                    class="form-control">
                                                            </div>
                                                            <div class="mb-3 col-md-6">
                                                                <label>Doctor Status </label>
                                                                <input type="text" name="doctorStatus"
                                                                    class="form-control">
                                                            </div>
                                                            <div class="mb-3 col-md-6">
                                                                <label>Support Status </label>
                                                                <input type="text" name="supportStatus"
                                                                    class="form-control">
                                                            </div>
                                                            <div class="mb-3 col-md-6">
                                                                <label>Office Status </label>
                                                                <input type="text" name="officeStatus"
                                                                    class="form-control">
                                                            </div>
                                                            <div class="mb-3 col-md-6">
                                                                <label>Admin Status </label>
                                                                <input type="text" name="adminStatus"
                                                                    class="form-control">
                                                            </div>
                                                            <div
                                                                class="mb-3 col-md-6 <%- user.type=='stockorder'?'d-none':'' %>">
                                                                <label>Post Office Status </label>
                                                                <input type="text" name="postOfficeStatus"
                                                                    class="form-control">
                                                            </div>
                                                            <div class="mb-3 col-md-6">
                                                                <label>Tracking Id Status </label>
                                                                <input type="text" name="trackingIdStatus"
                                                                    class="form-control">
                                                            </div>
                                                            <div class="mb-3 col-md-6">
                                                                <label>Delivery Status </label>
                                                                <input type="text" name="deliveryStatus"
                                                                    class="form-control">
                                                            </div>
                                                        </div>
                                                        <%}%>

                                                            <div class="text-center mt-4">
                                                                <button type="submit"
                                                                    class="btn btn-success px-5 py-2">Submit</button>
                                                                <% if(createOrder && user?.type!='stockorder' ){ %>
                                                                    <button type="button"
                                                                        class="btn btn-info px-5 py-2 create-order">Create
                                                                        Order With Proship</button>
                                                                    <button type="button" data-type="smart-ship"
                                                                        class="btn btn-primary px-5 py-2 create-order">Create
                                                                        Order With Smart Ship</button>
                                                                    <% } %>
                                                            </div>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="modal fade create-order-modal bd-example-modal-xl" tabindex="-1" aria-hidden="true">
                            <div class="modal-dialog modal-lg">
                                <div class="modal-content">
                                    <div class="modal-header">
                                        <h5 class="modal-title">Edit Details</h5>
                                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                    </div>
                                    <div class="modal-body">
                                        <div id="approve-details">
                                            <div class="basic-form">
                                                <form action="/submit-patient-form" method="POST" id="create-order-form"
                                                    enctype="multipart/form-data">

                                                    <!-- Basic Info -->
                                                    <div class="form-section-title fw-bold">Patient Information
                                                    </div>
                                                    <div class="row mb-3">
                                                        <div class="col-lg-6">
                                                            <label class="form-label">Recipient Name *</label>
                                                            <input type="text" name="patientName" class="form-control"
                                                                required />
                                                        </div>
                                                        <div class="col-lg-6">
                                                            <label class="form-label">Recipient Mobile *</label>
                                                            <input type="text" name="mobileNumber" class="form-control"
                                                                required />
                                                        </div>
                                                    </div>
                                                    <div class="row mb-3">

                                                        <div class="col-lg-6">
                                                            <label class="form-label">Complete Address *</label>
                                                            <input type="text" name="houseOrStreet" class="form-control"
                                                                required />
                                                        </div>
                                                        <div class="col-lg-6">
                                                            <label class="form-label">City *</label>
                                                            <input type="text" name="cityOrDistrict"
                                                                class="form-control" required />
                                                        </div>
                                                    </div>
                                                    <div class="row mb-3">

                                                        <div class="col-lg-6">
                                                            <label class="form-label">State *</label>
                                                            <input type="text" name="state" class="form-control"
                                                                required />
                                                        </div>
                                                        <div class="col-lg-6">
                                                            <label class="form-label">Pin Code </label>
                                                            <input type="text" name="pinCode" class="form-control" />
                                                        </div>
                                                    </div>


                                                    <div class="form-section-title fw-bold">Pickup Details</div>
                                                    <div class="row mb-3">
                                                        <div class="col-12">
                                                            <label class="form-label">Pickup Location *</label>
                                                            <select name="pickupLocation" style="padding-block: 11px;"
                                                                class="form-select" required>
                                                                <option value="">Select Pickup Location</option>
                                                                <option
                                                                    value="BSRF NGO, SARSWATI VIHAR GANGA FORM HOUSE KE SAMNE BHATI LAB WALI NEW BUILDING MELROSE BYE PASS ALIGARH UTTAR PRADESH, Aligarh, Uttar Pradesh, India, 202001">
                                                                    BSRF NGO, SARSWATI VIHAR GANGA FORM HOUSE KE SAMNE
                                                                    BHATI LAB WALI NEW BUILDING MELROSE BYE PASS ALIGARH
                                                                    UTTAR PRADESH, Aligarh, Uttar Pradesh, India, 202001
                                                                </option>
                                                                <option
                                                                    value="BSRF INDIA, 228 Durga Nagar Ram Nagar Melrose bye pass Aligarh UPB B Grirls inter college, ALIGARH, Uttar Pradesh, India, 202001">
                                                                    BSRF INDIA, 228 Durga Nagar Ram Nagar Melrose bye
                                                                    pass Aligarh UPB B Grirls inter college, ALIGARH,
                                                                    Uttar Pradesh, India, 202001</option>
                                                            </select>
                                                        </div>
                                                    </div>

                                                    <div class="form-section-title fw-bold">Order Details</div>
                                                    <div class="row mb-3">
                                                        <div class="col-lg-6">
                                                            <label class="form-label">Payment Mode *</label>
                                                            <div>
                                                                <div class="form-check form-check-inline">
                                                                    <input class="form-check-input" type="radio"
                                                                        name="paymentMode" value="Prepaid" required />
                                                                    <label class="form-check-label">Prepaid</label>
                                                                </div>
                                                                <div class="form-check form-check-inline">
                                                                    <input class="form-check-input" type="radio"
                                                                        name="paymentMode" value="COD" />
                                                                    <label class="form-check-label">COD</label>
                                                                </div>

                                                            </div>
                                                        </div>
                                                        <div class="col-lg-6">
                                                            <label class="form-label">Client Order Id </label>
                                                            <input type="text" name="orderId"
                                                                placeholder="Enter Client Order Id"
                                                                class="form-control" />
                                                        </div>
                                                    </div>
                                                    <div class="row mb-3">
                                                        <div class="col-lg-6">
                                                            <label class="form-label">Shipping Label Id </label>
                                                            <input type="text" name="labelId"
                                                                placeholder="Enter Shipping Label Id"
                                                                class="form-control" />
                                                        </div>
                                                        <div class="col-lg-6">
                                                            <label class="form-label">Channel Name</label>
                                                            <input type="text" name="channel"
                                                                placeholder="Enter Channel Name" class="form-control" />
                                                        </div>
                                                    </div>
                                                    <div class="row mb-3">
                                                        <div class="col-lg-6">
                                                            <label class="form-label">Invoice Value *</label>
                                                            <input type="text" name="invoiceValue"
                                                                placeholder="Total Invoice Amount" class="form-control"
                                                                required />
                                                        </div>
                                                        <div class="col-lg-6">
                                                            <label class="form-label">Sku Id *</label>
                                                            <input type="text" name="skuId" placeholder="Enter Sku Id"
                                                                class="form-control" required />
                                                        </div>
                                                    </div>
                                                    <div class="row mb-3">
                                                        <div class="col-lg-6">
                                                            <label class="form-label">Name *</label>
                                                            <input type="text" name="productName"
                                                                placeholder="Product Name" class="form-control"
                                                                required />
                                                        </div>
                                                        <div class="col-lg-6">
                                                            <label class="form-label">Quantity *</label>
                                                            <input type="text" name="productQuantity"
                                                                placeholder="Product Quantity" class="form-control"
                                                                required />
                                                        </div>
                                                    </div>
                                                    <div class="row mb-3">
                                                        <div class="col-lg-6">
                                                            <label class="form-label">Unit Price *</label>
                                                            <input type="text" name="unitPrice"
                                                                placeholder="Enter Unit Price" class="form-control"
