<style>
    /* Premium Sidebar White Theme Styling */
    .deznav {
        background: #ffffff !important;
        border-right: 1px solid #e2e8f0;
        box-shadow: 2px 0 12px rgba(15, 23, 42, 0.03);
    }

    .deznav .deznav-scroll {
        padding-top: 15px;
        padding-bottom: 30px;
    }

    .deznav .metismenu {
        padding: 0 12px;
    }

    .deznav .metismenu li.menu-title {
        color: #94a3b8 !important;
        font-size: 11px !important;
        font-weight: 700 !important;
        letter-spacing: 1px !important;
        text-transform: uppercase;
        padding: 14px 16px 8px !important;
    }

    .deznav .metismenu > li {
        margin-bottom: 4px;
    }

    .deznav .metismenu > li > a {
        display: flex;
        align-items: center;
        padding: 11px 16px;
        border-radius: 10px;
        color: #475569 !important;
        font-weight: 500;
        font-size: 14px;
        transition: all 0.2s ease-in-out;
        text-decoration: none;
    }

    .deznav .metismenu > li > a .nav-icon-box {
        width: 34px;
        height: 34px;
        border-radius: 8px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        margin-right: 12px;
        font-size: 15px;
        background: #f8fafc;
        color: #64748b;
        transition: all 0.2s ease-in-out;
        flex-shrink: 0;
        border: 1px solid #f1f5f9;
    }

    .deznav .metismenu > li > a:hover {
        background-color: #f1f5f9;
        color: #0f172a !important;
    }

    .deznav .metismenu > li > a:hover .nav-icon-box {
        background-color: #e0f2fe;
        color: #0284c7;
        border-color: #bae6fd;
        transform: scale(1.05);
    }

    .deznav .metismenu > li.mm-active > a,
    .deznav .metismenu > li > a.active {
        background: #e0f2fe !important;
        color: #0284c7 !important;
        font-weight: 600 !important;
    }

    .deznav .metismenu > li.mm-active > a .nav-icon-box,
    .deznav .metismenu > li > a.active .nav-icon-box {
        background: #0284c7 !important;
        color: #ffffff !important;
        border-color: #0284c7;
        box-shadow: 0 3px 8px rgba(2, 132, 199, 0.25);
    }

    .deznav-divider {
        border-top: 1px solid #e2e8f0;
        margin: 12px 10px;
    }

    .logout-nav-item a:hover .nav-icon-box {
        background-color: #ffe4e6 !important;
        color: #e11d48 !important;
        border-color: #fecdd3 !important;
    }
    .logout-nav-item a:hover {
        color: #e11d48 !important;
        background-color: #fff1f2 !important;
    }

    /* Collapsed Sidebar Alignment on Desktop (min-width: 769px) */
    @media (min-width: 769px) {
        .menu-toggle .deznav {
            width: 5rem !important;
        }

        .menu-toggle .deznav .metismenu {
            padding: 0 8px !important;
        }

        .menu-toggle .deznav .metismenu li.menu-title {
            display: none !important;
        }

        .menu-toggle .deznav .metismenu > li > a {
            padding: 10px 0 !important;
            justify-content: center !important;
            display: flex !important;
            align-items: center !important;
        }

        .menu-toggle .deznav .metismenu > li > a .nav-icon-box {
            margin-right: 0 !important;
            width: 38px !important;
            height: 38px !important;
            display: inline-flex !important;
            align-items: center !important;
            justify-content: center !important;
        }

        .menu-toggle .deznav .metismenu > li > a .nav-text {
            display: none !important;
        }

        .menu-toggle .deznav .deznav-divider {
            margin: 10px 4px !important;
        }
    }

    /* Small Screen / Mobile Devices: Full screen sidebar on toggle open */
    @media (max-width: 768px) {
        .deznav {
            position: fixed !important;
            top: 0 !important;
            left: -100% !important;
            width: 100vw !important;
            max-width: 100% !important;
            height: 100vh !important;
            height: 100dvh !important;
            z-index: 1050 !important;
            transition: left 0.3s ease-in-out !important;
            overflow-y: auto !important;
            padding-top: 60px !important;
            box-shadow: 0 0 20px rgba(0, 0, 0, 0.15) !important;
        }

        .menu-toggle .deznav {
            left: 0 !important;
            width: 100vw !important;
            max-width: 100% !important;
            display: block !important;
        }

        .menu-toggle .deznav .metismenu {
            padding: 0 16px !important;
        }

        .menu-toggle .deznav .metismenu li.menu-title {
            display: block !important;
        }

        .menu-toggle .deznav .metismenu > li > a {
            display: flex !important;
            align-items: center !important;
            justify-content: flex-start !important;
            padding: 12px 16px !important;
        }

        .menu-toggle .deznav .metismenu > li > a .nav-icon-box {
            margin-right: 12px !important;
            width: 36px !important;
            height: 36px !important;
            display: inline-flex !important;
            align-items: center !important;
            justify-content: center !important;
        }

        .menu-toggle .deznav .metismenu > li > a .nav-text {
            display: inline-block !important;
            font-size: 15px !important;
            font-weight: 500 !important;
            color: inherit !important;
        }
    }
</style>

<div class="deznav">
    <div class="deznav-scroll">
        <ul class="metismenu" id="menu">
            <li class="menu-title">Main Navigation</li>

            <!-- Dashboard -->
            <li>
                <a href="/" aria-expanded="false">
                    <span class="nav-icon-box">
                        <i class="fas fa-th-large"></i>
                    </span>
                    <span class="nav-text">Dashboard</span>
                </a>
            </li>

            <% if(user.role=='Admin') { %>
                <!-- Patients (Admin) -->
                <li>
                    <a href="/patients" aria-expanded="false">
                        <span class="nav-icon-box">
                            <i class="fas fa-user-injured"></i>
                        </span>
                        <span class="nav-text">Patients</span>
                    </a>
                </li>

                <!-- Admins -->
                <li>
                    <a href="/users/admins" aria-expanded="false">
                        <span class="nav-icon-box">
                            <i class="fas fa-user-shield"></i>
                        </span>
                        <span class="nav-text">Admins</span>
                    </a>
                </li>

                <!-- Rojgaar Sathi -->
                <li>
                    <a href="/applications/rojgaar/applied" aria-expanded="false">
                        <span class="nav-icon-box">
                            <i class="fas fa-briefcase"></i>
                        </span>
                        <span class="nav-text">Rojgaar Sathi</span>
                    </a>
                </li>

                <!-- Applied Applications -->
                <li>
                    <a href="/applications/applied" aria-expanded="false">
                        <span class="nav-icon-box">
                            <i class="fas fa-user-clock"></i>
                        </span>
                        <span class="nav-text">Unverified Users</span>
                    </a>
                </li>

                <!-- Courier Orders -->
                <li>
                    <a href="/patientorder/allorders" aria-expanded="false">
                        <span class="nav-icon-box">
                            <i class="fas fa-shipping-fast"></i>
                        </span>
                        <span class="nav-text">Courier Orders</span>
                    </a>
                </li>

                <!-- Teleconsult Bookings -->
                <li>
                    <a href="/teleconsult/admin" aria-expanded="false">
                        <span class="nav-icon-box">
                            <i class="fas fa-video"></i>
                        </span>
                        <span class="nav-text">Teleconsult Bookings</span>
                    </a>
                </li>

                <!-- Not Interested Patients -->
                <li>
                    <a href="/patientform/notinterestedpatients" aria-expanded="false">
                        <span class="nav-icon-box">
                            <i class="fas fa-user-times"></i>
                        </span>
                        <span class="nav-text">Not Interested Patients</span>
                    </a>
                </li>
            <% } %>

            <% if(user.role!='doc' && user.type!='stockorder') { %>
                <!-- Verified Users / Your Users -->
                <li>
                    <a href="/users" aria-expanded="false">
                        <span class="nav-icon-box">
                            <i class="fas fa-users"></i>
                        </span>
                        <span class="nav-text">
                            <%= (user.role=='Admin') ? 'Verified Users' : 'Your Users' %>
                        </span>
                    </a>
                </li>
            <% } %>

            <!-- Unverified Patient -->
            <li class="<%- (user.type=='stockorder' && user.position!='Centre Head') ? 'd-none' : '' %>">
                <a href="/patientform/patients" aria-expanded="false">
                    <span class="nav-icon-box">
                        <i class="fas fa-hospital-user"></i>
                    </span>
                    <span class="nav-text">Unverified Patients</span>
                </a>
            </li>

            <!-- Verified Patient -->
            <li class="<%- (user.type=='stockorder' && user.position!='Centre Head') ? 'd-none' : '' %>">
                <a href="/patientform/varifiedpatients" aria-expanded="false">
                    <span class="nav-icon-box">
                        <i class="fas fa-user-check"></i>
                    </span>
                    <span class="nav-text">Verified Patients</span>
                </a>
            </li>

            <!-- Pending Patient -->
            <li class="<%- (user.type=='stockorder' && user.position!='Centre Head') ? 'd-none' : '' %>">
                <a href="/patientform/pendingpatients" aria-expanded="false">
                    <span class="nav-icon-box">
                        <i class="fas fa-hourglass-half"></i>
                    </span>
                    <span class="nav-text">Pending Patients</span>
                </a>
            </li>

            <% if(user.role!='doc') { %>
                <!-- Patient Orders -->
                <li class="<%- user.type=='stockorder' ? 'd-none' : '' %>">
                    <a href="/patientform/orders" aria-expanded="false">
                        <span class="nav-icon-box">
                            <i class="fas fa-box-open"></i>
                        </span>
                        <span class="nav-text">Patient Orders</span>
                    </a>
                </li>

                <% if(user.role=='Admin') { %>
                    <!-- Total Work -->
                    <li>
                        <a href="/patientorder/work" aria-expanded="false">
                            <span class="nav-icon-box">
                                <i class="fas fa-tasks"></i>
                            </span>
                            <span class="nav-text">Total Work</span>
                        </a>
                    </li>
                <% } %>

                <!-- Delivered Orders -->
                <li class="<%- (user.type=='stockorder' && user.position!='Centre Head') ? 'd-none' : '' %>">
                    <a href="/patientform/delivered" aria-expanded="false">
                        <span class="nav-icon-box">
                            <i class="fas fa-truck-loading"></i>
                        </span>
                        <span class="nav-text">Delivered Orders</span>
                    </a>
                </li>

                <% if(user.role!='doc' && user.type!='singleorder') { %>
                    <!-- Money Transactions -->
                    <li>
                        <a href="/stock/moneytransactions" aria-expanded="false">
                            <span class="nav-icon-box">
                                <i class="fas fa-money-bill-transfer"></i>
                            </span>
                            <span class="nav-text">Money Transactions</span>
                        </a>
                    </li>

                    <!-- Stock Transactions -->
                    <li>
                        <a href="/stock/stocktransactions" aria-expanded="false">
                            <span class="nav-icon-box">
                                <i class="fas fa-boxes-stacked"></i>
                            </span>
                            <span class="nav-text">Stock Transactions</span>
                        </a>
                    </li>

                    <!-- My Stock -->
                    <li>
                        <a href="/stock/mystock" aria-expanded="false">
                            <span class="nav-icon-box">
                                <i class="fas fa-warehouse"></i>
                            </span>
                            <span class="nav-text">My Stock</span>
                        </a>
                    </li>
                <% } %>

                <!-- Profile -->
                <li>
                    <a href="/users/profile" aria-expanded="false">
                        <span class="nav-icon-box">
                            <i class="fas fa-id-badge"></i>
                        </span>
                        <span class="nav-text">Profile</span>
                    </a>
                </li>
            <% } %>

            <div class="deznav-divider"></div>

            <!-- Log Out -->
            <li class="logout-nav-item">
                <a href="javascript:void(0);" class="logout-btn" aria-expanded="false">
                    <span class="nav-icon-box text-danger">
                        <i class="fas fa-power-off"></i>
                    </span>
                    <span class="nav-text">Log Out</span>
                </a>
            </li>

        </ul>
    </div>
</div>