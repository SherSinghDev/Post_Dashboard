                <button id="theme-toggle"
                    class="p-2 rounded-lg text-gray-500 dark:text-slate-400 hover:bg-gray-100 dark:hover:bg-slate-800 focus:outline-none transition-colors"
                    aria-label="Toggle Dark Mode"
                    style="background-color: transparent; border: none; cursor: pointer; display: flex; align-items: center; justify-content: center; width: 40px; height: 40px;">
                    <i id="moon-icon" class="fa-solid fa-moon text-lg" style="display: none;"></i>
                    <i id="sun-icon" class="fa-solid fa-sun text-lg" style="display: none;"></i>
                </button>

                <!-- Favourites -->
                <button onclick="toggleFavDropdown()" class="relative p-2 text-gray-600 dark:text-slate-300 hover:text-red-500 transition-colors">
                    <i class="fa-regular fa-heart text-xl"></i>
