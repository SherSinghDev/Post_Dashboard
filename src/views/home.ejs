        if (togglePasswordBtn) {
            togglePasswordBtn.addEventListener('click', function () {
                const type = passwordInput.getAttribute('type') === 'password' ? 'text' : 'password';
                passwordInput.setAttribute('type', type);
                togglePasswordIcon.classList.toggle('fa-eye');
                togglePasswordIcon.classList.toggle('fa-eye-slash');
            });
        }

        // Form Submission
        $(document).on('submit', '#login-form', function (e) {
            e.preventDefault();
            const form = this;
            const email = form.email.value.trim();
            const password = form.password.value;
            const submitBtn = $('#submitBtn');
            const btnSpinner = $('#btnSpinner');
            const btnText = $('#btnText');
            const btnArrow = $('#btnArrow');

            if (!email || !password) {
                Swal.fire({
                    icon: "error",
                    title: "Missing Fields",
                    text: "Please enter both your email and password.",
                    confirmButtonColor: "#2563eb"
                });
                return;
            }

            // Set loading state
            submitBtn.prop('disabled', true);
            btnSpinner.show();
            btnArrow.hide();
            btnText.text('Signing In...');

            $.ajax({
                url: '/auth/login',
                method: "POST",
                data: JSON.stringify({ email, password }),
                headers: {
                    "Content-Type": "application/json"
                },
                success: function (data) {
                    if (data.login) {
                        Swal.fire({
                            icon: "success",
                            title: "Welcome!",
                            text: data.message || "Logged in successfully",
                            showConfirmButton: false,
                            timer: 1000
                        }).then(() => {
                            if (data.isStockOrder) {
                                sessionStorage.setItem('stock_order_show_notice', 'true');
                            }
                            if (data.loginType === 'user') {
                                window.location.href = '/';
                            } else if (data.loginType === 'support agent') {
                                window.location.href = '/support/dashboard';
                            } else if (data.loginType === 'recruiter') {
                                window.location.href = '/jobs/dashboard';
                            } else {
                                window.location.href = '/doctors/dashboard';
                            }
                        });
                    } else {
                        submitBtn.prop('disabled', false);
                        btnSpinner.hide();
                        btnArrow.show();
                        btnText.text('Sign In');

                        Swal.fire({
                            icon: "error",
                            title: "Login Failed",
                            text: data.message || "Invalid credentials",
                            confirmButtonColor: "#2563eb"
                        });
                    }
                },
                error: function (err) {
                    submitBtn.prop('disabled', false);
                    btnSpinner.hide();
                    btnArrow.show();
                    btnText.text('Sign In');

                    console.error(err);
                    Swal.fire({
                        icon: "error",
                        title: "Server Error",
                        text: "Something went wrong. Please try again later.",
                        confirmButtonColor: "#2563eb"
                    });
                }
            });
        });
    </script>
</body>

</html>