<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>BINUPUR SEVA RESEARCH FOUNDATION</title>
    <link rel="shortcut icon" type="image/png" href="/images/logo/logo.png">
    <!-- Load Tailwind CSS CDN for modern styling -->
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        /* Custom styles for Hero Section background and overlay */
        .hero-background {
            /* Removed fixed background-image here; it is now set dynamically by JavaScript */
            background-size: 100% 100%;
            background-position: center;
            position: relative;
            transition: background-image 0.8s ease-in-out;
            /* Smooth transition for background image change */
        }

        .hero-overlay {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background-color: rgba(0, 0, 0, 0.1);
            /* Dark overlay for text readability */
        }

        /* Using Inter font, as requested for good design */
        body {
            font-family: 'Inter', sans-serif;
            scroll-behavior: smooth;
        }

        /* Simple transition for interactive elements */
        .transition-all {
            transition: all 0.3s ease;
        }

        /* Custom styles for smooth carousel transitions (text fades) */
        .carousel-slide {
            transition: opacity 0.7s ease-in-out;
        }
    </style>
</head>

<body class="bg-gray-50">

    <!-- Navbar Section -->
    <nav class="sticky top-0 z-50 shadow-lg" style="background-color: rgb(241, 241, 241);">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between items-center h-16">
                <!-- Logo/Brand -->
                <a href="/home" class="flex-shrink-0 text-xl font-extrabold text-indigo-700"
                    style="display: flex; align-items: center;">
                    <img src="https://bsrfindia.com/images/logo/logo.png" alt="" width="50">
                    <span>BSRF <span class="text-gray-900 font-medium">INDIA</span></span>
                </a>

                <!-- Desktop Menu -->
                <div class="hidden md:block">
                    <div class="ml-10 flex items-baseline space-x-4">
                        <a href="/applications"
                            class="text-gray-600 hover:bg-indigo-50 hover:text-indigo-700 px-3 py-2 rounded-md text-sm font-medium transition-all">Member
                            Form</a>
                        <a href="/patientform/form1"
                            class="text-gray-600 hover:bg-indigo-50 hover:text-indigo-700 px-3 py-2 rounded-md text-sm font-medium transition-all">Patient
                            Form</a>
                        <!-- <a href="#cta"
                            class="text-gray-600 hover:bg-indigo-50 hover:text-indigo-700 px-3 py-2 rounded-md text-sm font-medium transition-all">Download
                            Id</a>
                        <a href="#cta"
                            class="text-gray-600 hover:bg-indigo-50 hover:text-indigo-700 px-3 py-2 rounded-md text-sm font-medium transition-all">Jobs</a> -->
                        <a href="/auth/login"
                            class="bg-red-500 text-white hover:bg-red-600 px-4 py-2 rounded-full text-sm font-semibold transition-all shadow-md">Login</a>
                    </div>
                </div>

                <!-- Mobile Menu Button -->
                <div class="-mr-2 flex md:hidden">
                    <button id="mobile-menu-button" type="button"
                        class="inline-flex items-center justify-center p-2 rounded-md text-gray-400 hover:text-gray-500 hover:bg-gray-100 focus:outline-none focus:ring-2 focus:ring-inset focus:ring-indigo-500"
                        aria-controls="mobile-menu" aria-expanded="false">
                        <svg class="block h-6 w-6" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
                            stroke="currentColor" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M4 6h16M4 12h16M4 18h16" />
                        </svg>
                        <svg class="hidden h-6 w-6" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
                            stroke="currentColor" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M6 18L18 6M6 6l12 12" />
                        </svg>
                    </button>
                </div>
            </div>
        </div>

        <!-- Mobile Menu (Hidden by default) -->
        <div class="md:hidden hidden" id="mobile-menu">
            <div class="px-2 pt-2 pb-3 space-y-1 sm:px-3">
                <a href="/applications"
                    class="block text-gray-700 hover:bg-indigo-50 hover:text-indigo-700 px-3 py-2 rounded-md text-base font-medium transition-all">Member
                    Form</a>
                <a href="/patientform/form1"
                    class="block text-gray-700 hover:bg-indigo-50 hover:text-indigo-700 px-3 py-2 rounded-md text-base font-medium transition-all">Patient
                            Form</a>
                <!-- <a href="#cta"
                    class="block text-gray-700 hover:bg-indigo-50 hover:text-indigo-700 px-3 py-2 rounded-md text-base font-medium transition-all">Contact
                    Us</a> -->
                <a href="/auth/login"
                    class="block bg-red-500 text-white hover:bg-red-600 px-3 py-2 rounded-md text-base font-semibold transition-all text-center mt-2">Login</a>
            </div>
        </div>
    </nav>

    <!-- Hero Section (CAROUSEL IMPLEMENTATION) -->
    <header id="home"
        class="hero-background h-[50vh] md:h-screen flex items-center justify-center text-white relative overflow-hidden">
        <div class="hero-overlay"></div>

        <!-- Carousel Container -->
        <div id="hero-carousel" class="relative w-full h-full">

            <!-- Slide 1: Serving Humanity (Default/Justice Focus) -->
            <div class="carousel-slide absolute inset-0 flex items-center justify-center text-center transition-opacity duration-700"
                data-slide="0">

            </div>

            <!-- Slide 2: Health Focus -->
            <div class="carousel-slide hidden absolute inset-0 flex items-center justify-center text-center transition-opacity duration-700"
                data-slide="1">

            </div>

            <!-- Slide 3: Education Focus -->
            <div class="carousel-slide hidden absolute inset-0 flex items-center justify-center text-center transition-opacity duration-700"
                data-slide="2">

            </div>

            <!-- Carousel Navigation (Arrows) -->
            <button id="prev-slide"
                class="absolute top-1/2 left-4 transform -translate-y-1/2 p-3 bg-black/50 hover:bg-black/70 rounded-full transition-all z-20">
                <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"
                    xmlns="http://www.w3.org/2000/svg">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
                </svg>
            </button>
            <button id="next-slide"
                class="absolute top-1/2 right-4 transform -translate-y-1/2 p-3 bg-black/50 hover:bg-black/70 rounded-full transition-all z-20">
                <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"
                    xmlns="http://www.w3.org/2000/svg">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                </svg>
            </button>

            <!-- Carousel Indicators (Dots) -->
            <div id="carousel-dots" class="absolute bottom-6 left-1/2 transform -translate-x-1/2 flex space-x-3 z-20">
                <!-- Dots will be generated here by JavaScript -->
            </div>
        </div>
    </header>



    <!-- JavaScript for Mobile Menu Toggle and Carousel Logic -->
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            // --- Mobile Menu Toggle Logic ---
            const menuButton = document.getElementById('mobile-menu-button');
            const mobileMenu = document.getElementById('mobile-menu');

            menuButton.addEventListener('click', () => {
                const isExpanded = menuButton.getAttribute('aria-expanded') === 'true';
                menuButton.setAttribute('aria-expanded', !isExpanded);
                mobileMenu.classList.toggle('hidden');

                // Toggle icon
                const iconOpen = menuButton.querySelector('svg:first-child');
                const iconClosed = menuButton.querySelector('svg:last-child');
                iconOpen.classList.toggle('hidden');
                iconClosed.classList.toggle('hidden');
            });


            // --- Carousel Logic ---
            const slides = document.querySelectorAll('.carousel-slide');
            const dotsContainer = document.getElementById('carousel-dots');
            const prevButton = document.getElementById('prev-slide');
            const nextButton = document.getElementById('next-slide');
            const heroHeader = document.getElementById('home'); // The element whose background we will change

            let currentSlideIndex = 0;
            const slideIntervalTime = 5000; // 5 seconds
            let slideInterval;

            // Define background images corresponding to slides
            const backgroundImages = [
                'https://bsrfjjss.in/testinomial-img/1000171123_04252024040049.jpg', // Slide 0 (General/Justice)
                'https://bsrfjjss.in/testinomial-img/ayurvedic-pcd-pharma-franchise_02152024064917.jpg', // Slide 1 (Health)
                'https://bsrfjjss.in/testinomial-img/%E0%A4%A8%E0%A4%B6%E0%A4%BE%20%E0%A4%AE%E0%A5%81%E0%A4%95%E0%A5%8D%E0%A4%A4%20%E0%A4%AD%E0%A4%BE%E0%A4%B0%E0%A4%A4%20%E0%A4%85%E0%A4%AD%E0%A4%BF%E0%A4%AF%E0%A4%BE%E0%A4%A8_02182024071008.jpeg'    // Slide 2 (Education)
            ];


            if (slides.length > 0) {

                // 1. Create Dots based on number of slides
                slides.forEach((_, index) => {
                    const dot = document.createElement('button');
                    dot.classList.add('w-3', 'h-3', 'rounded-full', 'bg-white/50', 'hover:bg-white', 'transition-all');
                    dot.setAttribute('data-index', index);
                    dot.addEventListener('click', () => {
                        resetInterval();
                        showSlide(index);
                    });
                    dotsContainer.appendChild(dot);
                });

                const dots = dotsContainer.querySelectorAll('button');

                // 2. Function to display the correct slide and update dots
                const showSlide = (index) => {
                    currentSlideIndex = index;

                    // *** Dynamic Background Change ***
                    heroHeader.style.backgroundImage = `url('${backgroundImages[currentSlideIndex]}')`;

                    // Hide all slides, show the current one
                    slides.forEach((slide, i) => {
                        if (i === currentSlideIndex) {
                            slide.classList.remove('hidden');
                            slide.style.opacity = '1';
                        } else {
                            slide.classList.add('hidden');
                            slide.style.opacity = '0';
                        }
                    });

                    // Update dot colors
                    dots.forEach((dot, i) => {
                        if (i === currentSlideIndex) {
                            dot.classList.remove('bg-white/50');
                            dot.classList.add('bg-white', 'w-5'); // Highlight current dot
                        } else {
                            dot.classList.remove('bg-white', 'w-5');
                            dot.classList.add('bg-white/50');
                        }
                    });
                };

                // 3. Navigation Functions
                const nextSlide = () => {
                    let newIndex = (currentSlideIndex + 1) % slides.length;
                    showSlide(newIndex);
                };

                const prevSlide = () => {
                    let newIndex = (currentSlideIndex - 1 + slides.length) % slides.length;
                    showSlide(newIndex);
                };

                // 4. Interval Management
                const startInterval = () => {
                    slideInterval = setInterval(nextSlide, slideIntervalTime);
                };

                const resetInterval = () => {
                    clearInterval(slideInterval);
                    startInterval();
                };

                // Attach event listeners for arrows
                nextButton.addEventListener('click', () => {
                    nextSlide();
                    resetInterval(); // Restart timer on manual interaction
                });

                prevButton.addEventListener('click', () => {
                    prevSlide();
                    resetInterval(); // Restart timer on manual interaction
                });

                // Initialize the carousel
                showSlide(currentSlideIndex);
                startInterval();

            } else {
                console.error("No slides found for the carousel.");
            }
        });
    </script>

</body>

</html>