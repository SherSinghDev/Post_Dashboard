    <style>
        .quick-links {
            display: grid;
            grid-template-columns: 1fr;
            gap: 16px;
            width: 100%;
        }

        .quick-link-item {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            padding: 12px 16px;
            background: #f8fafc;
            border: 1px solid #edf2f7;
            border-radius: 12px;
            font-size: 15px;
            font-weight: 600;
            color: #334155;
            text-decoration: none;
            transition: all 0.2s;
        }

        .quick-link-item i {
            color: #2563eb;
            font-size: 18px;
        }

        .quick-link-item:hover {
            background: #eff6ff;
            color: #2563eb;
            border-color: #bfdbfe;
            transform: translateY(-2px);
        }

        .promo-section {
            display: flex;
            flex-direction: column;
            gap: 24px;
            width: 100%;
        }

        .promo-card {
            background: #f8fafc;
            border: 1px solid #e2e8f0;
            border-radius: 16px;
            overflow: hidden;
            text-decoration: none;
            color: #1e293b;
            transition: all 0.2s;
            display: flex;
            flex-direction: column;
        }

        .promo-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 12px 24px -4px rgba(0, 0, 0, 0.1);
            border-color: #cbd5e1;
        }

        .promo-image {
            width: 100%;
            height: auto;
            display: block;
        }

        .promo-content {
            padding: 16px 20px;
            display: flex;
            align-items: center;
            gap: 16px;
            background: #ffffff;
            border-top: 1px solid #e2e8f0;
        }

        .promo-icon {
            color: #25D366;
            font-size: 32px;
            flex-shrink: 0;
        }

        .promo-text-wrapper {
            display: flex;
            flex-direction: column;
            overflow: hidden;
            width: 100%;
        }

        .promo-title {
            font-size: 18px;
            font-weight: 700;
            color: #1e293b;
        }

        .promo-link {
            font-size: 14px;
            color: #2563eb;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            margin-top: 4px;
        }

        @media (min-width: 480px) {
            .quick-links {
                grid-template-columns: repeat(2, 1fr);
            }

            .quick-link-item {
                padding: 16px 20px;
                font-size: 16px;
            }
        }

        @media (min-width: 768px) {
            .quick-links {
                grid-template-columns: repeat(2, 1fr);
            }

            .promo-section {
                flex-direction: row;
                align-items: flex-start;
            }

            .promo-card {
                flex: 1;
            }
        }

        @media (min-width: 1024px) {
            .quick-links {
                grid-template-columns: repeat(4, 1fr);
            }
        }

        /* Login Form Styles */
        .login-card {
