<!DOCTYPE html>
<html lang="en">

<%- include('./globals/head') %>

    <body>

        <!--*******************
        Preloader start
    ********************-->
        <!-- <div id="preloader">
		<div class="loader-wrapper">
			<div class="loader-box">
				<div class="icon">
				  <i class="fas fa-utensils"></i>
				</div>
			</div>
		</div>
	</div>	 -->


        <%- include('./globals/preloader') %>

            <!--*******************
        Preloader end
    ********************-->

            <!--**********************************
        Main wrapper start
    ***********************************-->
            <div id="main-wrapper">
                <!--**********************************
            Nav header start
        ***********************************-->


                <%- include('globals/navHeader') %>
                    <!--**********************************
            Nav header end
        ***********************************-->



                    <!--**********************************
            Header start
        ***********************************-->
                    <%- include('globals/header') %>
                        <!--**********************************
            Header end ti-comment-alt
        ***********************************-->

                        <!--**********************************
            Sidebar start
        ***********************************-->
                        <%- include('globals/sidebar') %>

                            <!--**********************************
            Sidebar end
        ***********************************-->

                            <!--**********************************
            Content body start
        ***********************************-->
                            <div class="content-body">
                                <div class="container">
                                    <% if(user.role=="Coordinator" ){ %>
                                        <div class="d-grid gap-2 d-sm-flex  flex-wrap mb-4">
                                            <a href="/patientform/<%= user.userId %>" target="_blank"
                                                class="btn btn-primary shadow-sm fw-semibold px-3">
                                                <i class="fas fa-file-medical me-1"></i> Patient Form
                                            </a>


                                            <% if (user.type=='stockorder' ) { %>
                                                <a href="/users/network"
                                                    class="btn btn-success flex-grow-1 flex-md-grow-0"><i
                                                        class="fas fa-sitemap me-1"></i>My 5 Steps Economic Help</a>
                                                <button type="button"
                                                    class="btn btn-danger fw-bold flex-grow-1 flex-md-grow-0"
                                                    data-bs-toggle="modal" data-bs-target="#stockOrderNoticeModal">
                                                    <i class="fas fa-bullhorn me-1"></i>आवश्यक सूचना
                                                </button>
                                                <% } %>
                                        </div>
                                        <% } %>
                                            <%- include('globals/dash_cards_style') %>

                                                <!-- Quick Actions for Admin -->
                                                <% if(user.role=="Admin" ){ %>
                                                    <div class="coordinator-actions mb-3">
                                                        <span class="fw-bold text-dark me-2" style="font-size: 13.5px;">
                                                            <i class="fas fa-bolt text-warning me-1"></i> Admin Actions:
                                                        </span>
                                                        <a href="/patientform/admin"
                                                            class="btn btn-sm btn-outline-primary">
                                                            <i class="fa-solid fa-file-medical me-1"></i> Patient Form
                                                        </a>
                                                    </div>
                                                    <% } %>

                                                        <!-- Quick Actions for Coordinator -->
                                                        <% if(user.role=="Coordinator" ){ %>
                                                            <div
                                                                class="coordinator-actions mb-4 p-3 bg-white rounded shadow-sm border">
                                                                <div
                                                                    class="d-flex flex-column flex-md-row align-items-center justify-content-center gap-3">
                                                                    <span class="fw-bold text-dark text-center"
                                                                        style="font-size: 15px; min-width: max-content;">
                                                                        <i
                                                                            class="fas fa-bolt text-warning fs-5 align-middle me-1"></i>
                                                                        Quick Actions
                                                                    </span>
                                                                    <div
                                                                        class="d-flex flex-wrap justify-content-center gap-2">

                                                                        <a href="/users/idcard/<%= user._id %>"
                                                                            target="_blank"
                                                                            class="btn btn-info shadow-sm fw-semibold px-3 py-2 text-white">
                                                                            <i class="fas fa-id-card me-1"></i> ID Card
                                                                        </a>
                                                                        <a href="/users/letter/<%= user._id %>"
                                                                            target="_blank"
                                                                            class="btn btn-warning shadow-sm fw-semibold px-3 py-2">
                                                                            <i class="fas fa-file-alt me-1"></i>
                                                                            Appointment Letter
                                                                        </a>
                                                                        <a href="/users/donation/<%= user._id %>"
                                                                            target="_blank"
                                                                            class="btn btn-primary shadow-sm fw-semibold px-3 py-2">
                                                                            <i class="fas fa-receipt me-1"></i> Donation
                                                                            Receipt
                                                                        </a>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                            <% } %>

                                                                <!-- Filter Bar with Search & Tabs -->
                                                                <div class="dash-filter-container">
                                                                    <div
                                                                        class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3">
                                                                        <!-- Filter Category Pills -->
                                                                        <div class="filter-pills"
                                                                            id="dashboardFilterPills">
                                                                            <button type="button"
                                                                                class="filter-btn active"
                                                                                data-filter="all">All Modules</button>
                                                                            <button type="button" class="filter-btn"
                                                                                data-filter="users">Users</button>
                                                                            <button type="button" class="filter-btn"
                                                                                data-filter="patients">Patients</button>
                                                                            <button type="button" class="filter-btn"
                                                                                data-filter="orders">Orders &
                                                                                Courier</button>
                                                                            <button type="button" class="filter-btn"
                                                                                data-filter="stock">Stock &
                                                                                Finance</button>
                                                                            <button type="button" class="filter-btn"
                                                                                data-filter="support">Support</button>
                                                                        </div>

                                                                        <!-- Live Search Bar -->
                                                                        <div class="position-relative">
                                                                            <i
                                                                                class="fas fa-search search-icon-wrapper"></i>
                                                                            <input type="text" id="dashboardSearch"
                                                                                class="form-control dash-search-input"
                                                                                placeholder="Search cards...">
                                                                        </div>
                                                                    </div>
                                                                </div>

                                                                <!-- Cards Grid -->
                                                                <div class="row" id="dashboardCardsContainer">

                                                                    <!-- Card: Verified Users -->
                                                                    <div class="col-xl-4 col-lg-6 col-sm-6 dash-card-item <%- (user.role=='doc' || user.type=='stockorder')?'d-none':'' %>"
                                                                        data-category="users"
                                                                        data-title="verified users your users">
                                                                        <div class="dash-card">
                                                                            <div
                                                                                class="d-flex align-items-start justify-content-between mb-3">
                                                                                <div>
                                                                                    <div class="dash-card-title">
                                                                                        <%= (user.role=='Admin' )
                                                                                            ? 'Verified Users'
                                                                                            : 'Your Users' %>
                                                                                    </div>
                                                                                    <h3 class="dash-card-value">
                                                                                        <%= verified || 0 %>
                                                                                    </h3>
                                                                                </div>
                                                                                <div class="dash-card-icon icon-blue">
                                                                                    <i class="fas fa-user-check"></i>
                                                                                </div>
                                                                            </div>
                                                                            <a href="/users" class="dash-card-action">
                                                                                <span>View All Users</span>
                                                                                <i class="fas fa-arrow-right"></i>
                                                                            </a>
                                                                        </div>
                                                                    </div>

                                                                    <!-- Card: Unverified Users -->
                                                                    <div class="col-xl-4 col-lg-6 col-sm-6 dash-card-item <%- (user.role=='doc' || user.type=='stockorder')?'d-none':'' %>"
                                                                        data-category="users"
                                                                        data-title="unverified users pending applications">
                                                                        <div class="dash-card">
                                                                            <div
                                                                                class="d-flex align-items-start justify-content-between mb-3">
                                                                                <div>
                                                                                    <div class="dash-card-title">
                                                                                        Unverified Users
                                                                                    </div>
                                                                                    <h3 class="dash-card-value"
                                                                                        style="color: #d97706;">
                                                                                        <%= unverified || 0 %>
                                                                                    </h3>
                                                                                </div>
                                                                                <div class="dash-card-icon icon-amber">
                                                                                    <i class="fas fa-user-clock"></i>
                                                                                </div>
                                                                            </div>
                                                                            <a href="/applications/applied"
                                                                                class="dash-card-action">
                                                                                <span>Verify Users</span>
                                                                                <i class="fas fa-arrow-right"></i>
                                                                            </a>
                                                                        </div>
                                                                    </div>

                                                                    <!-- Card: Direct Members (Step 1) - Stock Order -->
                                                                    <div class="col-xl-4 col-lg-6 col-sm-6 dash-card-item <%- (user.role=='doc' || user.type!='stockorder')?'d-none':'' %>"
                                                                        data-category="users"
                                                                        data-title="level 1 direct child members referrals network">
                                                                        <div class="dash-card">
                                                                            <div
                                                                                class="d-flex align-items-start justify-content-between mb-3">
                                                                                <div>
                                                                                    <div class="dash-card-title">Direct
                                                                                        Members
                                                                                        (Step 1) / सीधे सदस्य (चरण 1)
                                                                                    </div>
                                                                                    <h3 class="dash-card-value"
                                                                                        style="color: #2563eb;">
                                                                                        <%= (typeof networkCounts
                                                                                            !=='undefined' &&
                                                                                            networkCounts.l1) || 0 %>
                                                                                    </h3>
                                                                                </div>
                                                                                <div class="dash-card-icon icon-blue">
                                                                                    <i class="fas fa-user-friends"></i>
                                                                                </div>
                                                                            </div>
                                                                            <a href="/users/network?level=1"
                                                                                class="dash-card-action">
                                                                                <span>View Direct Team</span>
                                                                                <i class="fas fa-arrow-right"></i>
                                                                            </a>
                                                                        </div>
                                                                    </div>

                                                                    <!-- Card: 5 Steps Economic Help - Stock Order -->
                                                                    <div class="col-xl-4 col-lg-6 col-sm-6 dash-card-item <%- (user.role=='doc' || user.type!='stockorder')?'d-none':'' %>"
                                                                        data-category="users"
                                                                        data-title="5 Steps Economic Help total team hierarchy downline">
                                                                        <div class="dash-card">
                                                                            <div
                                                                                class="d-flex align-items-start justify-content-between mb-3">
                                                                                <div>
                                                                                    <div class="dash-card-title">5 Steps
                                                                                        Economic Help / 5 कदम आर्थिक मदद
                                                                                    </div>
                                                                                    <h3 class="dash-card-value"
                                                                                        style="color: #7c3aed;">
                                                                                        <%= (typeof networkCounts
                                                                                            !=='undefined' &&
                                                                                            networkCounts.total) || 0 %>
                                                                                    </h3>
                                                                                </div>
                                                                                <div class="dash-card-icon icon-purple">
                                                                                    <i class="fas fa-sitemap"></i>
                                                                                </div>
                                                                            </div>
                                                                            <a href="/users/network"
                                                                                class="dash-card-action">
                                                                                <span>Explore 5 Steps</span>
                                                                                <i class="fas fa-arrow-right"></i>
                                                                            </a>
                                                                        </div>
                                                                    </div>

                                                                    <!-- Card: Platform Wallet Amount - Stock Order -->
                                                                    <div class="col-xl-4 col-lg-6 col-sm-6 dash-card-item <%- (user.role=='doc' || user.type!='stockorder')?'d-none':'' %>"
                                                                        data-category="stock"
                                                                        data-title="platform wallet amount commission earnings balance">
                                                                        <div class="dash-card"
                                                                            style="border-left: 4px solid #059669;">
                                                                            <div
                                                                                class="d-flex align-items-start justify-content-between mb-3">
                                                                                <div>
                                                                                    <div class="dash-card-title">
                                                                                        Platform Wallet / प्लेटफॉर्म
                                                                                        वॉलेट</div>
                                                                                    <h3 class="dash-card-value"
                                                                                        style="color: #059669; font-size:22px;">
                                                                                        &#8377;<%= (platformWalletAmount
                                                                                            ||
                                                                                            0).toLocaleString('en-IN')
                                                                                            %>
                                                                                    </h3>
                                                                                    <div
                                                                                        style="font-size:11.5px; color:#94a3b8; margin-top:2px;">
                                                                                        Commission Earned</div>
                                                                                </div>
                                                                                <div
                                                                                    class="dash-card-icon icon-emerald">
                                                                                    <i class="fas fa-coins"></i>
                                                                                </div>
                                                                            </div>
                                                                            <a href="/stock/commissionhistory"
                                                                                class="dash-card-action"
                                                                                style="color:#059669;">
                                                                                <span>View Commission History</span>
                                                                                <i class="fas fa-arrow-right"></i>
                                                                            </a>
                                                                        </div>
                                                                    </div>

                                                                    <!-- Card: Unverified Patients -->

                                                                    <div class="col-xl-4 col-lg-6 col-sm-6 dash-card-item"
                                                                        data-category="patients"
                                                                        data-title="unverified patients">
                                                                        <div class="dash-card">
                                                                            <div
                                                                                class="d-flex align-items-start justify-content-between mb-3">
                                                                                <div>
                                                                                    <div class="dash-card-title">
                                                                                        Unverified Patients<%-
                                                                                            (user.type=='stockorder' )
                                                                                            ? ' / असत्यापित मरीज़' : ''
                                                                                            %>
                                                                                    </div>
                                                                                    <h3 class="dash-card-value">
                                                                                        <%= patients %>
                                                                                    </h3>
                                                                                </div>
                                                                                <div class="dash-card-icon icon-cyan">
                                                                                    <i class="fas fa-hospital-user"></i>
                                                                                </div>
                                                                            </div>
                                                                            <a href="/patientform/patients"
                                                                                class="dash-card-action">
                                                                                <span>View Patients</span>
                                                                                <i class="fas fa-arrow-right"></i>
                                                                            </a>
                                                                        </div>
                                                                    </div>

                                                                    <!-- Card: Pending Patients -->
                                                                    <div class="col-xl-4 col-lg-6 col-sm-6 dash-card-item"
                                                                        data-category="patients"
                                                                        data-title="pending patients">
                                                                        <div class="dash-card">
                                                                            <div
                                                                                class="d-flex align-items-start justify-content-between mb-3">
                                                                                <div>
                                                                                    <div class="dash-card-title">Pending
                                                                                        Patients<%-
                                                                                            (user.type=='stockorder' )
                                                                                            ? ' / लंबित मरीज़' : '' %>
                                                                                    </div>
                                                                                    <h3 class="dash-card-value">
                                                                                        <%= pendingpatients %>
                                                                                    </h3>
                                                                                </div>
                                                                                <div class="dash-card-icon icon-rose">
                                                                                    <i class="fas fa-clock"></i>
                                                                                </div>
                                                                            </div>
                                                                            <a href="/patientform/pendingpatients"
                                                                                class="dash-card-action">
                                                                                <span>Manage Pending</span>
                                                                                <i class="fas fa-arrow-right"></i>
                                                                            </a>
                                                                        </div>
                                                                    </div>

                                                                    <!-- Card: Verified Patients -->
                                                                    <div class="col-xl-4 col-lg-6 col-sm-6 dash-card-item"
                                                                        data-category="patients"
                                                                        data-title="verified patients">
                                                                        <div class="dash-card">
                                                                            <div
                                                                                class="d-flex align-items-start justify-content-between mb-3">
                                                                                <div>
                                                                                    <div class="dash-card-title">
                                                                                        Verified Patients<%-
                                                                                            (user.type=='stockorder' )
                                                                                            ? ' / सत्यापित मरीज़' : ''
                                                                                            %>
                                                                                    </div>
                                                                                    <h3 class="dash-card-value">
                                                                                        <%= varifiedPatients %>
                                                                                    </h3>
                                                                                </div>
                                                                                <div
                                                                                    class="dash-card-icon icon-emerald">
                                                                                    <i class="fas fa-check-double"></i>
                                                                                </div>
                                                                            </div>
                                                                            <a href="/patientform/varifiedpatients"
                                                                                class="dash-card-action">
                                                                                <span>View Verified</span>
                                                                                <i class="fas fa-arrow-right"></i>
                                                                            </a>
                                                                        </div>
                                                                    </div>

                                                                    <!-- Card: Track Orders -->
                                                                    <div class="col-xl-4 col-lg-6 col-sm-6 dash-card-item <%- (user.role=='doc' || user.type=='stockorder')?'d-none':'' %>"
                                                                        data-category="orders"
                                                                        data-title="track orders courier all orders">
                                                                        <div class="dash-card">
                                                                            <div
                                                                                class="d-flex align-items-start justify-content-between mb-3">
                                                                                <div>
                                                                                    <div class="dash-card-title">Track
                                                                                        Orders</div>
                                                                                    <h3 class="dash-card-value"
                                                                                        style="font-size: 19px; color: #0284c7; padding-top: 4px;">
                                                                                        Courier Portal</h3>
                                                                                </div>
                                                                                <div class="dash-card-icon icon-indigo">
                                                                                    <i class="fas fa-shipping-fast"></i>
                                                                                </div>
                                                                            </div>
                                                                            <a href="/patientorder/allorders"
                                                                                class="dash-card-action">
                                                                                <span>Track Courier Orders</span>
                                                                                <i class="fas fa-arrow-right"></i>
                                                                            </a>
                                                                        </div>
                                                                    </div>

                                                                    <!-- Card: Patient Orders -->
                                                                    <div class="col-xl-4 col-lg-6 col-sm-6 dash-card-item <%- (user.role=='doc' || user.type=='stockorder')?'d-none':'' %>"
                                                                        data-category="orders"
                                                                        data-title="patient orders">
                                                                        <div class="dash-card">
                                                                            <div
                                                                                class="d-flex align-items-start justify-content-between mb-3">
                                                                                <div>
                                                                                    <div class="dash-card-title">Patient
                                                                                        Orders
                                                                                    </div>
                                                                                    <h3 class="dash-card-value">
                                                                                        <%= patientsOrders %>
                                                                                    </h3>
                                                                                </div>
                                                                                <div
                                                                                    class="dash-card-icon icon-emerald">
                                                                                    <i class="fas fa-box"></i>
                                                                                </div>
                                                                            </div>
                                                                            <a href="/patientform/orders"
                                                                                class="dash-card-action">
                                                                                <span>View Orders</span>
                                                                                <i class="fas fa-arrow-right"></i>
                                                                            </a>
                                                                        </div>
                                                                    </div>

                                                                    <!-- Card: Delivered Orders -->
                                                                    <div class="col-xl-4 col-lg-6 col-sm-6 dash-card-item <%- (user.role=='doc' || user.type=='stockorder') ?'d-none':'' %>"
                                                                        data-category="orders"
                                                                        data-title="total delivered orders">
                                                                        <div class="dash-card">
                                                                            <div
                                                                                class="d-flex align-items-start justify-content-between mb-3">
                                                                                <div>
                                                                                    <div class="dash-card-title">
                                                                                        Delivered Orders
                                                                                    </div>
                                                                                    <h3 class="dash-card-value">
                                                                                        <%= deliveredOrders %>
                                                                                    </h3>
                                                                                </div>
                                                                                <div class="dash-card-icon icon-amber">
                                                                                    <i
                                                                                        class="fas fa-truck-ramp-box"></i>
                                                                                </div>
                                                                            </div>
                                                                            <a href="/patientform/delivered"
                                                                                class="dash-card-action">
                                                                                <span>View Delivered</span>
                                                                                <i class="fas fa-arrow-right"></i>
                                                                            </a>
                                                                        </div>
                                                                    </div>

                                                                    <!-- Card: Money Transactions -->
                                                                    <div class="col-xl-4 col-lg-6 col-sm-6 dash-card-item d-none"
                                                                        data-category="stock"
                                                                        data-title="money transactions payments finance">
                                                                        <div class="dash-card">
                                                                            <div
                                                                                class="d-flex align-items-start justify-content-between mb-3">
                                                                                <div>
                                                                                    <div class="dash-card-title">Money
                                                                                        Transactions
                                                                                    </div>
                                                                                    <h3 class="dash-card-value"
                                                                                        style="font-size: 19px; color: #059669; padding-top: 4px;">
                                                                                        Ledger & Flow</h3>
                                                                                </div>
                                                                                <div
                                                                                    class="dash-card-icon icon-emerald">
                                                                                    <i
                                                                                        class="fas fa-money-bill-wave"></i>
                                                                                </div>
                                                                            </div>
                                                                            <a href="/stock/moneytransactions"
                                                                                class="dash-card-action">
                                                                                <span>View Transactions</span>
                                                                                <i class="fas fa-arrow-right"></i>
                                                                            </a>
                                                                        </div>
                                                                    </div>

                                                                    <!-- Card: Stock Transactions -->
                                                                    <div class="col-xl-4 col-lg-6 col-sm-6 dash-card-item <%- (user.type!='stockorder' && user.role!='Admin') ?'d-none':'' %>"
                                                                        data-category="stock"
                                                                        data-title="stock transactions inventory logs">
                                                                        <div class="dash-card">
                                                                            <div
                                                                                class="d-flex align-items-start justify-content-between mb-3">
                                                                                <div>
                                                                                    <div class="dash-card-title">Stock
                                                                                        Transactions<%-
                                                                                            (user.type=='stockorder' )
                                                                                            ? ' / स्टॉक लेनदेन' : '' %>
                                                                                    </div>
                                                                                    <h3 class="dash-card-value"
                                                                                        style="font-size: 19px; color: #d97706; padding-top: 4px;">
                                                                                        Inventory Activity</h3>
                                                                                </div>
                                                                                <div class="dash-card-icon icon-amber">
                                                                                    <i class="fas fa-boxes-stacked"></i>
                                                                                </div>
                                                                            </div>
                                                                            <a href="/stock/stocktransactions"
                                                                                class="dash-card-action">
                                                                                <span>View Logs</span>
                                                                                <i class="fas fa-arrow-right"></i>
                                                                            </a>
                                                                        </div>
                                                                    </div>

                                                                    <!-- Card: My Stock -->
                                                                    <div class="col-xl-4 col-lg-6 col-sm-6 dash-card-item <%- (user.role!='Admin') ?'d-none':'' %>"
                                                                        data-category="stock"
                                                                        data-title="my stock inventory available balance">
                                                                        <div class="dash-card">
                                                                            <div
                                                                                class="d-flex align-items-start justify-content-between mb-3">
                                                                                <div>
                                                                                    <div class="dash-card-title">Stock
                                                                                        Balance</div>
                                                                                    <h3 class="dash-card-value"
                                                                                        style="font-size: 19px; color: #0284c7; padding-top: 4px;">
                                                                                        Available Items</h3>
                                                                                </div>
                                                                                <div class="dash-card-icon icon-blue">
                                                                                    <i class="fas fa-warehouse"></i>
                                                                                </div>
                                                                            </div>
                                                                            <a href="/stock/mystock"
                                                                                class="dash-card-action">
                                                                                <span>Inspect Stock</span>
                                                                                <i class="fas fa-arrow-right"></i>
                                                                            </a>
                                                                        </div>
                                                                    </div>

                                                                    <!-- Card: Profile -->
                                                                    <div class="col-xl-4 col-lg-6 col-sm-6 dash-card-item"
                                                                        data-category="support"
                                                                        data-title="profile account my account">
                                                                        <div class="dash-card">
                                                                            <div
                                                                                class="d-flex align-items-start justify-content-between mb-3">
                                                                                <div>
                                                                                    <div class="dash-card-title">My
                                                                                        Account<%-
                                                                                            (user.type=='stockorder' )
                                                                                            ? ' / मेरा खाता' : '' %>
                                                                                    </div>
                                                                                    <h3 class="dash-card-value"
                                                                                        style="font-size: 19px; color: #475569; padding-top: 4px;">
                                                                                        <%= user.name || 'User Profile'
                                                                                            %>
                                                                                    </h3>
                                                                                </div>
                                                                                <div class="dash-card-icon icon-purple">
                                                                                    <i class="fas fa-user-gear"></i>
                                                                                </div>
                                                                            </div>
