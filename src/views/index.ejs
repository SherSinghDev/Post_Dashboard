                            spaceBetween: 10,
                        },
                        1788: {
                            slidesPerView: 5,
                            spaceBetween: 20,
                        },
                    },
                });


                $(document).on('click', '.logout-btn', function (e) {
                    Swal.fire({
                        title: "Do you want to Logout?",
                        showDenyButton: true,
                        // showCancelButton: true,
                        confirmButtonText: "Yes",
                        denyButtonText: `Cancel`
                    }).then((result) => {
                        /* Read more about isConfirmed, isDenied below */
                        if (result.isConfirmed) {

                            $.ajax({
                                url: `/auth/logout`,
                                method: "POST",
                                success: function (data) {
                                    console.log(data);
                                    if (data.logout) {
                                        window.location.href = '/'
                                    }
                                    else {
                                        Swal.fire({
                                            icon: "error",
                                            title: "Oops...",
                                            text: "Something Went Wrong",
                                            timer: 1500
                                        });
                                    }
                                },
                                error: function (err) {
                                    console.log(err);
                                }
                            })
                        }
                    });
                })

                var handleNavigation = function () {
                    $(".nav-control").on('click', function () {

                        $('#main-wrapper').toggleClass("menu-toggle");

                        $(".hamburger").toggleClass("is-active");
                    });
                }

                handleNavigation()

                // Dashboard Cards Filtering & Search Logic
                $(document).ready(function () {
                    var currentFilter = 'all';

                    function filterCards() {
                        var searchTerm = $('#dashboardSearch').val().toLowerCase().trim();
                        var visibleCount = 0;

                        $('.dash-card-item').each(function () {
                            // Check if hidden by server-side EJS condition
                            if ($(this).hasClass('d-none')) {
                                return;
                            }

                            var category = $(this).data('category') || '';
                            var title = ($(this).data('title') || '').toLowerCase();
                            var cardText = $(this).text().toLowerCase();

                            var matchesCategory = (currentFilter === 'all') || (category === currentFilter);
                            var matchesSearch = !searchTerm || title.includes(searchTerm) || cardText.includes(searchTerm);

                            if (matchesCategory && matchesSearch) {
                                $(this).fadeIn(150);
                                visibleCount++;
                            } else {
                                $(this).fadeOut(100);
                            }
                        });

                        if (visibleCount === 0) {
                            $('#noCardsFound').removeClass('d-none').fadeIn(150);
                        } else {
                            $('#noCardsFound').addClass('d-none');
                        }
                    }

                    // Category Pill Click
                    $('#dashboardFilterPills .filter-btn').on('click', function () {
                        $('#dashboardFilterPills .filter-btn').removeClass('active');
                        $(this).addClass('active');
                        currentFilter = $(this).data('filter');
                        filterCards();
                    });

                    // Search input event
                    $('#dashboardSearch').on('input', function () {
                        filterCards();
                    });
                });
            </script>



