            <script>
                var swiper = new Swiper(".mySwiper", {
                    slidesPerView: 5,
                    //spaceBetween: 30,
                    pagination: {
                        el: ".swiper-pagination",
                        clickable: true,
                    },
                    breakpoints: {

                        300: {
                            slidesPerView: 1,
                            spaceBetween: 20,
                        },
                        416: {
                            slidesPerView: 2,
                            spaceBetween: 20,
                        },
                        768: {
