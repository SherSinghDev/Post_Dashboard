<!DOCTYPE html>
<html lang="en">
<%- include('./globals/head') %>
    <style>
        .masonry-grid {
            column-count: 1;
            column-gap: 1.5rem;
        }
        @media (min-width: 768px) {
            .masonry-grid { column-count: 2; }
        }
        @media (min-width: 992px) {
            .masonry-grid { column-count: 3; }
        }
        .masonry-item {
            break-inside: avoid;
            page-break-inside: avoid;
            display: inline-block;
            width: 100%;
        }
        .about-us-container {
        font-family: 'Plus Jakarta Sans', sans-serif;
        color: #333;
        line-height: 1.6;
        background-color: #fff;
        padding: 40px;
        border-radius: 12px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.05);
        margin-bottom: 30px;
    }
    [data-theme-version="dark"] .about-us-container,
    body[data-theme="dark"] .about-us-container {
        background-color: #1A2732;
        color: #e0e0e0;
        box-shadow: 0 4px 15px rgba(0,0,0,0.4);
    }
    .about-header {
        text-align: center;
        margin-bottom: 40px;
        border-bottom: 2px solid #00f2fe;
        padding-bottom: 20px;
    }
    .about-header h2 {
        color: #4facfe;
        font-weight: 700;
        font-size: 2.2rem;
        margin-bottom: 10px;
    }
    .about-header h3 {
        font-weight: 600;
        font-size: 1.3rem;
        color: #555;
    }
    [data-theme-version="dark"] .about-header h3 {
        color: #bbb;
    }
    .about-section {
        margin-bottom: 25px;
    }
    .about-section h4 {
        color: #4facfe;
        font-weight: 700;
        font-size: 1.2rem;
        margin-bottom: 10px;
    }
    .about-section p {
        font-size: 1.05rem;
        margin-bottom: 0;
    }
    .about-footer {
        margin-top: 50px;
        padding-top: 30px;
        border-top: 1px solid #ddd;
        text-align: center;
    }
    [data-theme-version="dark"] .about-footer {
        border-top: 1px solid #333;
    }
    .about-footer h4 {
        font-size: 1.5rem;
        color: #4facfe;
        font-weight: 700;
        margin-bottom: 10px;
    }
    .about-footer p {
        font-size: 1.1rem;
        font-weight: 600;
        margin-bottom: 30px;
    }
    .founders-section {
        display: flex;
        justify-content: center;
        gap: 50px;
        flex-wrap: wrap;
        margin-top: 40px;
    }
    .founder-card {
        text-align: center;
        max-width: 250px;
    }
    .founder-card img {
        width: 200px;
        height: 250px;
        object-fit: cover;
        border-radius: 12px;
        box-shadow: 0 4px 10px rgba(0,0,0,0.1);
        margin-bottom: 15px;
        border: 3px solid #4facfe;
    }
    .founder-name {
        font-weight: 700;
        font-size: 1.2rem;
        color: #333;
        margin-bottom: 5px;
    }
    [data-theme-version="dark"] .founder-name {
        color: #fff;
    }
    .founder-title {
        font-size: 0.95rem;
        color: #666;
        font-weight: 600;
    }
    [data-theme-version="dark"] .founder-title {
        color: #bbb;
    }
</style>
<body>
    <%- include('./globals/preloader') %>
    <div id="main-wrapper">
        <style>
            /* Override sidebar gap for full width page */
            .content-body {
                margin-left: 0 !important;
            }
        </style>
        
        <script src="https://cdn.tailwindcss.com"></script>
        <script>
            tailwind.config = {
                corePlugins: {
                    preflight: false,
                },
                darkMode: 'class'
            }
        </script>
        


        <%- include('globals/public_navbar') %>

        <div class="content-body" style="padding-top: 20px;">
            <div class="container-fluid">
                <div class="row page-titles">
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item active"><a href="javascript:void(0)">Dashboard</a></li>
                        <li class="breadcrumb-item"><a href="javascript:void(0)">Legal Documents</a></li>
                    </ol>
                </div>
                
                <div class="row justify-content-center">
                    <div class="col-xl-9 col-lg-10 mx-auto">
                        <div class="about-us-container">
                            <div class="about-header">
                                <h2>Legal Documents</h2>
                                <h3>Business Representation</h3>
                                <p class="mt-3 fw-bold">Official documents and verifications</p>
                            </div>

                            <div class="about-content">
                                <div class="masonry-grid">
                                    <% if (typeof images !== 'undefined' && images.length > 0) { %>
                                        <% images.forEach(function(img) { %>
                                            <div class="masonry-item mb-4">
                                                <div class="card shadow-sm border-0 rounded overflow-hidden">
                                                    <img src="/images/legal/<%= img %>" class="card-img-top img-fluid" alt="Legal Document" onclick="window.open(this.src, '_blank')" style="cursor: pointer; width: 100%; height: auto;">
                                                </div>
                                            </div>
                                        <% }); %>
                                    <% } else { %>
                                        <div class="text-center text-muted w-100">
                                            <p>No legal documents found.</p>
                                        </div>
                                    <% } %>
                                </div>
                            </div>
                        </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <script src="/vendor/global/global.min.js"></script>
    <script src="/vendor/bootstrap-select/dist/js/bootstrap-select.min.js"></script>
    <script src="/js/custom.js"></script>
    <script src="/js/deznav-init.js"></script>
    <script src="/js/demo.js"></script>
    <script src="/js/styleSwitcher.js"></script>
</body>
</html>
