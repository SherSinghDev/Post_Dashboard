<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no, viewport-fit=cover">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="description" content="BSRF Parcel Management System">
    <title>BSRF - Login</title>
    
    <!-- FAVICON -->
    <link rel="shortcut icon" type="image/png" href="https://bsrfindia.com/images/logo/logo.png">
    
    <!-- FONTS & ICONS -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/sweetalert2/11.23.0/sweetalert2.min.css">

    <style>
        :root {
            --primary: #2563eb;
            --primary-hover: #1d4ed8;
            --primary-gradient: linear-gradient(135deg, #1d4ed8 0%, #2563eb 100%);
            --bg-body: #0f172a;
            --dark: #0f172a;
            --text-main: #1e293b;
            --text-muted: #64748b;
            --border-color: #e2e8f0;
            --card-bg: #ffffff;
        }

        *, *::before, *::after {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            -webkit-tap-highlight-color: transparent;
        }

        html, body {
            width: 100%;
            min-height: 100%;
            background-color: var(--bg-body);
        }

        body {
            min-height: 100vh;
            min-height: 100dvh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: clamp(12px, 3vh, 32px) clamp(12px, 3vw, 24px);
        }

        .login-wrapper {
            width: 100%;
            max-width: 440px;
            margin: auto;
        }

        .card {
            background: var(--card-bg);
            border: 1px solid #e2e8f0;
            border-radius: clamp(14px, 2.5vw, 20px);
            padding: clamp(20px, 4vw, 36px) clamp(16px, 3.5vw, 32px);
            box-shadow: 0 20px 45px -10px rgba(0, 0, 0, 0.5);
            width: 100%;
        }

        .brand-section {
            text-align: center;
            margin-bottom: clamp(14px, 2.5vh, 22px);
        }

        .brand-logo {
            height: auto;
            max-height: clamp(44px, 7vw, 62px);
            max-width: min(100%, 180px);
            object-fit: contain;
            margin-bottom: clamp(6px, 1.5vh, 12px);
        }

        .brand-title {
            font-size: clamp(19px, 3.5vw, 23px);
            font-weight: 800;
            color: var(--dark);
            letter-spacing: -0.4px;
            line-height: 1.25;
        }

        .brand-subtitle {
            font-size: clamp(12px, 2vw, 13.5px);
            color: var(--text-muted);
            margin-top: 3px;
            font-weight: 500;
        }

        .form-group {
            margin-bottom: clamp(10px, 1.8vh, 16px);
        }

        .form-label {
            display: block;
            font-size: clamp(11.5px, 1.8vw, 13px);
            font-weight: 600;
            color: var(--text-main);
            margin-bottom: 5px;
        }

        .input-group {
            position: relative;
            display: flex;
            align-items: center;
            width: 100%;
        }

        .input-icon {
            position: absolute;
            left: 13px;
            color: #94a3b8;
            font-size: clamp(13px, 2vw, 15px);
            pointer-events: none;
            transition: color 0.2s ease;
        }

        .form-control {
            width: 100%;
            padding: clamp(9px, 1.5vh, 12px) 14px clamp(9px, 1.5vh, 12px) 38px;
            border-radius: 10px;
            border: 1.5px solid var(--border-color);
            background: #f8fafc;
            font-size: clamp(13.5px, 2vw, 14.5px);
            color: var(--text-main);
            outline: none;
            transition: all 0.2s ease;
        }

        .form-control:focus {
            background: #ffffff;
            border-color: var(--primary);
            box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.12);
        }

        .input-group:focus-within .input-icon {
            color: var(--primary);
        }

        .toggle-password {
            position: absolute;
            right: 12px;
            background: none;
            border: none;
            color: #94a3b8;
            cursor: pointer;
            font-size: 14px;
            padding: 6px;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: color 0.2s ease;
        }

        .toggle-password:hover,
        .toggle-password:focus {
            color: var(--text-main);
            outline: none;
        }

        .btn-submit {
            width: 100%;
            padding: clamp(10px, 1.6vh, 12.5px);
            margin-top: 6px;
            background: var(--primary-gradient);
            border: none;
            border-radius: 10px;
            color: white;
            font-size: clamp(13.5px, 2vw, 15px);
            font-weight: 700;
            cursor: pointer;
            box-shadow: 0 8px 16px -3px rgba(37, 99, 235, 0.35);
            transition: all 0.2s ease;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
        }

        .btn-submit:hover {
            transform: translateY(-1px);
            box-shadow: 0 12px 20px -3px rgba(37, 99, 235, 0.45);
        }

        .btn-submit:active {
            transform: translateY(0);
        }

        .btn-submit:disabled {
            opacity: 0.75;
            cursor: not-allowed;
            transform: none;
        }

        .divider {
            display: flex;
            align-items: center;
            text-align: center;
            margin: clamp(14px, 2.2vh, 20px) 0 clamp(10px, 1.6vh, 14px);
            color: #94a3b8;
            font-size: clamp(10.5px, 1.6vw, 11.5px);
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.75px;
        }

        .divider::before,
        .divider::after {
            content: '';
            flex: 1;
            border-bottom: 1px solid var(--border-color);
        }

        .divider::before {
            margin-right: 10px;
        }

        .divider::after {
            margin-left: 10px;
        }

        .quick-links {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: clamp(6px, 1.2vw, 9px);
            width: 100%;
        }

        .quick-link-item {
            display: flex;
            align-items: center;
            gap: 7px;
            padding: clamp(7px, 1.2vh, 9px) clamp(8px, 1.5vw, 11px);
            background: #f8fafc;
            border: 1px solid #edf2f7;
            border-radius: 8px;
            font-size: clamp(11px, 1.7vw, 12px);
            font-weight: 600;
            color: #334155;
            text-decoration: none;
            transition: all 0.2s ease;
            min-height: 38px;
        }

        .quick-link-item i {
            color: var(--primary);
            font-size: clamp(11.5px, 1.7vw, 13px);
            flex-shrink: 0;
        }

        .quick-link-item span {
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .quick-link-item:hover,
        .quick-link-item:focus {
            background: #eff6ff;
            color: var(--primary);
            border-color: #bfdbfe;
            transform: translateY(-1px);
        }

        .quick-link-full {
            grid-column: span 2;
        }

        .spinner {
            display: none;
            width: 16px;
            height: 16px;
            border: 2px solid rgba(255, 255, 255, 0.3);
            border-radius: 50%;
            border-top-color: white;
            animation: spin 0.8s linear infinite;
        }

        @keyframes spin {
            to {
                transform: rotate(360deg);
            }
        }

        /* Small Phones (iPhone SE, Galaxy A series, 320px - 400px) */
        @media (max-width: 380px) {
            body {
                padding: 10px 8px;
            }

            .card {
                padding: 18px 12px;
                border-radius: 12px;
            }

            .quick-links {
                grid-template-columns: 1fr;
            }

            .quick-link-full {
                grid-column: span 1;
            }
            
            .quick-link-item span {
                white-space: normal;
            }
        }

        /* Landscape Mobile & Short Height Screens */
        @media (max-height: 650px) and (orientation: landscape) {
            body {
                padding: 12px;
                align-items: flex-start;
            }

            .brand-logo {
                max-height: 38px;
                margin-bottom: 4px;
            }

            .brand-section {
                margin-bottom: 10px;
            }

            .form-group {
                margin-bottom: 8px;
            }

            .divider {
                margin: 10px 0 8px;
            }
        }
    </style>
</head>

<body>
    <div class="login-wrapper">
        <div class="card">
            <div class="brand-section">
                <img src="/images/logo/logo.png" alt="BSRF Logo" class="brand-logo" onerror="this.src='https://bsrfindia.com/images/logo/logo.png'">
                <h1 class="brand-title">Welcome Back</h1>
                <p class="brand-subtitle">Log in to your BSRF Management account</p>
            </div>

            <form id="login-form">
                <div class="form-group">
                    <label class="form-label" for="email">Email Address</label>
                    <div class="input-group">
                        <i class="fa-regular fa-envelope input-icon"></i>
                        <input type="email" id="email" name="email" class="form-control" placeholder="name@example.com" required autocomplete="email">
                    </div>
                </div>

                <div class="form-group">
                    <label class="form-label" for="password">Password</label>
                    <div class="input-group">
                        <i class="fa-solid fa-lock input-icon"></i>
                        <input type="password" id="password" name="password" class="form-control" placeholder="••••••••" required autocomplete="current-password">
                        <button type="button" class="toggle-password" id="togglePasswordBtn" aria-label="Toggle password visibility">
                            <i class="fa-regular fa-eye" id="togglePasswordIcon"></i>
                        </button>
                    </div>
                </div>

                <button type="submit" class="btn-submit" id="submitBtn">
                    <span class="spinner" id="btnSpinner"></span>
                    <span id="btnText">Sign In</span>
                    <i class="fa-solid fa-arrow-right" id="btnArrow"></i>
                </button>
            </form>

            <div class="divider">Quick Portals</div>

            <div class="quick-links">
                <a href="/applications/rojgaar" class="quick-link-item">
                    <i class="fa-solid fa-briefcase"></i>
                    <span>Rojgaar Samadhan</span>
                </a>
                <a href="/teleconsult" class="quick-link-item">
                    <i class="fa-solid fa-user-doctor"></i>
                    <span>Teleconsult</span>
                </a>
                <a href="/applications/type/singleorder" class="quick-link-item">
                    <i class="fa-solid fa-box"></i>
                    <span>Single Order</span>
                </a>
                <a href="/applications/type/stockorder" class="quick-link-item">
                    <i class="fa-solid fa-boxes-stacked"></i>
                    <span>Stock Order</span>
                </a>
                <a href="/patientform/02" class="quick-link-item quick-link-full">
                    <i class="fa-solid fa-file-medical"></i>
                    <span>Patient Registration Form</span>
                </a>
            </div>
        </div>
    </div>

    <!-- SCRIPTS -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/sweetalert2/11.23.0/sweetalert2.min.js"></script>
    <script>
        // Password Visibility Toggle
        const togglePasswordBtn = document.getElementById('togglePasswordBtn');
        const passwordInput = document.getElementById('password');
        const togglePasswordIcon = document.getElementById('togglePasswordIcon');

        togglePasswordBtn.addEventListener('click', function () {
            const type = passwordInput.getAttribute('type') === 'password' ? 'text' : 'password';
            passwordInput.setAttribute('type', type);
            togglePasswordIcon.classList.toggle('fa-eye');
            togglePasswordIcon.classList.toggle('fa-eye-slash');
        });

        // Form Submission
        $(document).on('submit', '#login-form', function (e) {
            e.preventDefault();
            const form = this;
            const email = form.email.value.trim();
            const password = form.password.value;
            const submitBtn = $('#submitBtn');
            const btnSpinner = $('#btnSpinner');
            const btnText = $('#btnText');
            const btnArrow = $('#btnArrow');

            if (!email || !password) {
                Swal.fire({
                    icon: "error",
                    title: "Missing Fields",
                    text: "Please enter both your email and password.",
                    confirmButtonColor: "#2563eb"
                });
                return;
            }

            // Set loading state
            submitBtn.prop('disabled', true);
            btnSpinner.show();
            btnArrow.hide();
            btnText.text('Signing In...');

            $.ajax({
                url: '/auth/login',
                method: "POST",
                data: JSON.stringify({ email, password }),
                headers: {
                    "Content-Type": "application/json"
                },
                success: function (data) {
                    if (data.login) {
                        Swal.fire({
                            icon: "success",
                            title: "Welcome!",
                            text: data.message || "Logged in successfully",
                            showConfirmButton: false,
                            timer: 1000
                        }).then(() => {
                            if (data.loginType === 'user') {
                                window.location.href = '/';
                            } else if (data.loginType === 'support agent') {
                                window.location.href = '/support/dashboard';
                            } else if (data.loginType === 'recruiter') {
                                window.location.href = '/jobs/dashboard';
                            } else {
                                window.location.href = '/doctors/dashboard';
                            }
                        });
                    } else {
                        submitBtn.prop('disabled', false);
                        btnSpinner.hide();
                        btnArrow.show();
                        btnText.text('Sign In');

                        Swal.fire({
                            icon: "error",
                            title: "Login Failed",
                            text: data.message || "Invalid credentials",
                            confirmButtonColor: "#2563eb"
                        });
                    }
                },
                error: function (err) {
                    submitBtn.prop('disabled', false);
                    btnSpinner.hide();
                    btnArrow.show();
                    btnText.text('Sign In');

                    console.error(err);
                    Swal.fire({
                        icon: "error",
                        title: "Server Error",
                        text: "Something went wrong. Please try again later.",
                        confirmButtonColor: "#2563eb"
                    });
                }
            });
        });
    </script>
</body>

</html>