                patientName,
                mobileNumber,
                houseOrStreet,
                cityOrDistrict,
                state,
                pinCode,
                pickupLocation,
                paymentMode,
                skuId,
                invoiceValue,
                productName,
                productQuantity,
                unitPrice,
                weight,
                length,
                breadth,
                height,
                channel
            }


            let err = []

            for (let key in inputs) {
                if (!inputs[key].value) {
                    let text = inputs[key].previousElementSibling?.innerText
                    err.push(text)
                }
            }

            if (err.length > 0) {
                Swal.fire({
                    icon: "error",
                    title: "Oops...",
                    html: err.join('<br>'),
                });
            }
            else {
                let data = {}
                for (let key in inputs) {
                    data = { ...data, [key]: inputs[key].value }
                }

                data = { ...data, id }
                // console.log(data);
                fetch(`/patientorder/create-order`, {
                    method: "POST",
                    body: JSON.stringify(data),
                    // body: new FormData(e.target),
                    headers: {
                        "Content-Type": "application/json"
                    },
                })
                    .then((data) => {
                        return data.json()
                    })
                    .then((result) => {
                        console.log(result);
                        if (result.success) {
