    <script>
        // $('.pay-option').css('display', 'none')
        $('.pay-option').hide()

        $('.pay-btn').click(function () {
            // $('.pay-option').css('display', 'block')
            $('.pay-option').show()
        })

        $(document).on('change', '#relationType', function () {
            let val = $(this).val()
            // console.log(val);
            let placeVal = ''

            if (val == 's/o') {
                placeVal = 'Son of'
            }
            if (val == 'd/o') {
                placeVal = 'Daughter of'
            }
            if (val == 'w/o') {
                placeVal = 'Wife of'
            }

            $('#relationOption').attr('placeholder', placeVal)
        })

        $(document).on('submit', '#register-form', async function (e) {
            e.preventDefault();
            const form = e.target;
            const formData = new FormData(form);

            // Your validation logic...
            let err = [];
            const mobile = form.mobile.value.trim();
            if (mobile.length !== 10) {
                err.push("Mobile Number Should Be Of 10 Digits!");
            }

            if (err.length > 0) {
                Swal.fire({
                    icon: "error",
                    title: "Oops...",
                    html: err.join('<br>'),
                });
                return;
            }

            try {
                const res = await fetch('/applications/rojgaar/apply', {
                    method: "POST",
                    body: new FormData(e.target),
                });
                const result = await res.json();

                if (result.created) {
                    Swal.fire({
                        title: "Success!",
                        icon: "success",
                        text: result.message,
                        timer: 1500,
                        showConfirmButton: false,
                    });
                    setTimeout(() => {
                        window.location.href = '/';
                    }, 1500);
                } else {
                    Swal.fire({
                        icon: "error",
                        title: "Oops...",
                        text: result.message,
                    });
                }
            } catch (err) {
                console.error(err);
                Swal.fire({
                    icon: "error",
                    title: "Network Error",
                    text: err.message,
                });
            }
        });


        $(document).on('change', '#select-role', function (e) {

            if (e.target.value == 'Coordinator') {
                $('.referred').removeClass('d-none')
            }
            else {
                $('.referred').addClass('d-none')
            }
        })

        const plans = {
            "One year Membership Fee (₹365)": 365,
            "Life time membership Fee (₹500)": 500,
            "One year membership Fee And Life time membership Fee (₹865)": 865,
        };

        let selectedAmount = 0;

        $('#membershipType').change(function () {
            selectedAmount = plans[this.value] || 0;
            $('#amount').val("₹ " + selectedAmount);
        });

        

        $('#payNow').click(async function () {

            let isValid = true;
            let firstEmptyField = null;

            // 🔹 Validate ALL inputs, selects & textareas inside the form
            $('#register-form')
                .find('input, select, textarea')
                .each(function () {
                    const value = $(this).val()?.trim();
                    const type = $(this).attr('type');

                    // Ignore buttons & hidden fields
                    if (type === 'button' || type === 'submit' || type === 'hidden' || type === 'hidden') return;
                    console.log(this.previousElementSibling.innerText);
                    // if (this.previousElementSibling.innerText == 'Referrer Name' || this.previousElementSibling.innerText == 'Referrer Id') return;


                    if (!value) {
                        isValid = false;
                        firstEmptyField = $(this);
                        return false; // break loop
                    }
                });

            if (!isValid) {
                Swal.fire("Please fill all required fields");
                firstEmptyField.focus();
                return;
            }

            // 🔹 Extra validations
            const email = $('input[name="email"]').val().trim();
            const mobile = $('input[name="mobile"]').val().trim();

            const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
            if (!emailRegex.test(email)) {
                Swal.fire("Please enter a valid email");
                $('input[name="email"]').focus();
                return;
            }

            if (!/^[6-9]\d{9}$/.test(mobile)) {
                Swal.fire("Please enter a valid 10-digit mobile number");
                $('input[name="mobile"]').focus();
                return;
            }

            // 🔹 Membership validation
            if (!selectedAmount || !$('#membershipType').val()) {
                Swal.fire("Please select a membership");
                return;
            }

            $('#register-form').submit()

            // const res = await fetch('/users/payment/create-order', {
            //     // 🔹 Create order
            //     method: "POST",
            //     headers: { "Content-Type": "application/json" },
            //     body: JSON.stringify({
            //         amount: selectedAmount,
            //         membershipType: $('#membershipType').val(),
            //         name: $('input[name="name"]').val().trim(),
            //         email,
            //         mobile
            //     })
            // });
            // const data = await res.json();
            // console.log(data);

            // if (!data.success) {
            //     Swal.fire({

            //         icon: "error",
            //         title: "Oops...",
            //         text: data.message,
            //     });
            //     return;
            // }
            // const options = {
            //     key: data.key,

            //     amount: selectedAmount * 100,
            //     currency: "INR",
            //     name: "BSRF",
            //     description: "Membership Fee",
            //     order_id: data.order.id,

            //     handler: async function (response) {
            //         const verify = await fetch('/users/payment/verify', {
            //             method: "POST",
            //             headers: { "Content-Type": "application/json" },
            //             body: JSON.stringify(response)
            //         });

            //         const result = await verify.json();

            //         if (result.success) {
            //             $('#register-form').submit(); // ✅ submit only after payment success
            //         } else {
            //             Swal.fire("Payment verification failed");
            //         }
            //     }
            // };
            // const rzp = new Razorpay(options);
            // rzp.open();
        });


    </script>

</body>

</html>