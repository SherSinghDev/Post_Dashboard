<!DOCTYPE html>
<html lang="en" class="h-100">

<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="description" content="BSRF Parcel Mangament System">
    <!-- PAGE TITLE HERE -->
    <title>BSRF Parcel Mangament System</title>
    <!-- FAVICONS ICON -->
    <link rel="shortcut icon" type="image/png" href="https://bsrfindia.com/images/logo/logo.png">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/sweetalert2/11.23.0/sweetalert2.min.css">
    <link href="/css/style.css" rel="stylesheet">

</head>

<body class="vh-100" style=" background-position:center; overflow: scroll;">
    <div class="authincation py-5">
        <div class="container">
            <div class="row justify-content-center align-items-center">
                <div class="col-md-10">
                    <div class="authincation-content">
                        <div class="row no-gutters">
                            <div class="col-xl-12">
                                <div class="auth-form">
                                    <div class="mb-4">
                                        <button type="button" onclick="if (window.history.length > 1) { window.history.back(); } else { window.location.href = '/'; }" class="btn btn-outline-primary d-inline-flex align-items-center justify-content-center" style="width: 40px; height: 40px; border-radius: 50%; padding: 0;" title="Back to Previous Page">
                                            <i class="fas fa-arrow-left fa-lg"></i>
                                        </button>
                                    </div>

                                    <form action="/register" id="register-form" method="POST"
                                        enctype="multipart/form-data">
                                        <h3 class="mb-3 text-center">Rojgaar Samadhan Form</h3>

                                        <div class="row mb-3">
                                            <div class="col-md-6">
                                                <label class="mb-1"><strong>Full Name*</strong></label>
                                                <input type="text" name="name" class="form-control" placeholder="Enter your full name" required>
                                            </div>
                                            <div class="col-md-6">
                                                <label class="mb-1"><strong>Mobile Number*</strong></label>
                                                <input type="text" name="mob" class="form-control" placeholder="Enter 10-digit mobile number" required>
                                            </div>
                                        </div>

                                        <div class="row mb-3">
                                            <div class="col-md-6">
                                                <label class="mb-1"><strong>Age*</strong></label>
                                                <input type="number" name="age" class="form-control" placeholder="Enter your age" required>
                                            </div>
                                            <div class="col-md-6">
                                                <label class="mb-1"><strong>Qualification*</strong></label>
                                                <input type="text" name="qualification" class="form-control" placeholder="Enter highest qualification" required>
                                            </div>
                                        </div>

                                        <div class="row mb-3">
                                            <div class="col-md-6">
                                                <label class="mb-1"><strong>Choose your post*</strong></label>
                                                <select name="post" class="form-select" style="padding-block: 11px;" required>
                                                    <option value="">Select Post</option>
                                                    <option value="State Manager">State Manager</option>
                                                    <option value="Team Manager">Team Manager</option>
                                                    <option value="Block head">Block head</option>
                                                </select>
                                            </div>
                                        </div>

                                        <div class="mb-3">
                                            <label class="mb-1"><strong>Address*</strong></label>
                                            <textarea name="address" class="form-control" placeholder="Enter full address" required></textarea>
                                        </div>

                                        <div class="row mb-3">
                                            <div class="col-md-4">
                                                <label class="mb-1"><strong>Self Photo*</strong></label>
                                                <input type="file" name="selfPhoto" class="form-control" accept="image/*" required>
                                            </div>
                                            <div class="col-md-4">
                                                <label class="mb-1"><strong>ID Proof Front*</strong></label>
                                                <input type="file" name="idProofFront" class="form-control" accept="image/*" required>
                                            </div>
                                            <div class="col-md-4">
                                                <label class="mb-1"><strong>ID Proof Back*</strong></label>
                                                <input type="file" name="idProofBack" class="form-control" accept="image/*" required>
                                            </div>
                                        </div>

                                        <div class="mb-3">
                                            <label class="mb-1"><strong>Experience / Fresher*</strong></label>
                                            <select name="isExperienced" id="isExperienced" class="form-select" style="padding-block: 11px;" required>
                                                <option value="">Select Status</option>
                                                <option value="false">Fresher</option>
                                                <option value="true">Experienced</option>
                                            </select>
                                        </div>

                                        <div id="experienceSection" class="mb-3" style="display: none;">
                                            <label class="mb-1"><strong>Experiences</strong></label>
                                            <div id="experienceList">
                                                <div class="experience-item row mb-2">
                                                    <div class="col-md-4">
                                                        <input type="text" class="form-control exp-company" placeholder="Company Name">
                                                    </div>
                                                    <div class="col-md-4">
                                                        <input type="text" class="form-control exp-duration" placeholder="Duration (e.g. 2 years)">
                                                    </div>
                                                    <div class="col-md-4">
                                                        <input type="text" class="form-control exp-designation" placeholder="Designation">
                                                    </div>
                                                </div>
                                            </div>
                                            <button type="button" id="addExperienceBtn" class="btn btn-sm btn-primary mt-2">Add More Experience</button>
                                        </div>

                                        <!-- Hidden input to store experiences JSON -->
                                        <input type="hidden" name="experiences" id="experiencesHidden">
                                        <button type="button" id="payNow" class="btn btn-success mt-3">
                                            Register
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!--**********************************
	Scripts
***********************************-->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/sweetalert2/11.23.0/sweetalert2.min.js"></script>


    <script>
        $('#isExperienced').change(function() {
            if ($(this).val() === 'true') {
                $('#experienceSection').show();
            } else {
                $('#experienceSection').hide();
            }
        });

        $('#addExperienceBtn').click(function() {
            const expItem = `
                <div class="experience-item row mb-2 mt-2 pt-2 border-top">
                    <div class="col-md-4">
                        <input type="text" class="form-control exp-company" placeholder="Company Name">
                    </div>
                    <div class="col-md-4">
                        <input type="text" class="form-control exp-duration" placeholder="Duration (e.g. 2 years)">
                    </div>
                    <div class="col-md-4 d-flex gap-2">
                        <input type="text" class="form-control exp-designation" placeholder="Designation">
                        <button type="button" class="btn btn-danger btn-sm remove-exp"><i class="fas fa-trash"></i></button>
                    </div>
                </div>
            `;
            $('#experienceList').append(expItem);
        });

        $(document).on('click', '.remove-exp', function() {
            $(this).closest('.experience-item').remove();
        });

        $('#payNow').click(async function () {
            let isValid = true;
            let firstEmptyField = null;

            // Validate standard required fields
            $('#register-form').find('input[required], select[required], textarea[required]').each(function () {
                const value = $(this).val()?.trim();
                if (!value) {
                    isValid = false;
                    firstEmptyField = $(this);
                    return false;
                }
            });

            if (!isValid) {
                Swal.fire("Please fill all required fields");
                firstEmptyField.focus();
                return;
            }

            // Extra validations
            const mobile = $('input[name="mob"]').val().trim();
            if (!/^[6-9]\d{9}$/.test(mobile)) {
                Swal.fire("Please enter a valid 10-digit mobile number");
                $('input[name="mob"]').focus();
                return;
            }

            // Parse experiences
            if ($('#isExperienced').val() === 'true') {
                let exps = [];
                let expValid = true;
                $('.experience-item').each(function() {
                    const comp = $(this).find('.exp-company').val().trim();
                    const dur = $(this).find('.exp-duration').val().trim();
                    const desig = $(this).find('.exp-designation').val().trim();
                    if(comp || dur || desig) {
                        if(!comp || !dur || !desig) {
                            expValid = false;
                        } else {
                            exps.push({ companyName: comp, duration: dur, designation: desig });
                        }
                    }
                });

                if(!expValid) {
                    Swal.fire("Please fill all fields for added experiences, or remove them if not needed.");
                    return;
                }
                if(exps.length === 0) {
                    Swal.fire("Please add at least one experience or select Fresher.");
                    return;
                }
                $('#experiencesHidden').val(JSON.stringify(exps));
            } else {
                $('#experiencesHidden').val('[]');
            }

            // Submit form
            const form = document.getElementById('register-form');
            try {
                const res = await fetch('/applications/rojgaar/apply', {
                    method: "POST",
                    body: new FormData(form),
                });
                const result = await res.json();

                if (result.created) {
                    Swal.fire({
                        title: "Success!",
                        icon: "success",
                        text: result.message,
                        timer: 1500,
                        showConfirmButton: false,
                    });
                    setTimeout(() => {
                        window.location.href = '/';
                    }, 1500);
                } else {
                    Swal.fire({
                        icon: "error",
                        title: "Oops...",
                        text: result.message,
                    });
                }
            } catch (err) {
                console.error(err);
                Swal.fire({
                    icon: "error",
                    title: "Network Error",
                    text: err.message,
                });
            }
        });
    </script>


    </script>

</body>

</html>