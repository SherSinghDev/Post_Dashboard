<!DOCTYPE html>
<html lang="en">
<%- include('./globals/head') %>

    <body>
        <%- include('./globals/preloader') %>

            <div id="main-wrapper">
                <%- include('globals/navHeader') %>
                    <%- include('globals/header') %>
                        <%- include('globals/sidebar') %>

                            <!--**********************************
          Content body start
    ***********************************-->
                            <div class="content-body">
                                <div class="container">
                                    <div class="d-flex justify-content-between mb-4 flex-wrap">
                                        <div class="input-group w-auto mb-2 mb-xxl-0">
                                            <input type="text" placeholder="Search by name, city, or mobile"
                                                class="form-control search-input" style="width: 300px;">
                                        </div>


                                    </div>

                                    <div class="row">
                                        <div class="col-xl-12">
                                            <div class="card mt-2">
                                                <div class="card-body">
                                                    <div class="table-responsive text-center">
                                                        <table class="table table-striped align-middle main-table">
                                                            <thead>
                                                                <tr>
                                                                    <th>#</th>
                                                                    <th>Name</th>
                                                                    <th>Mobile</th>
                                                                    <th>Age</th>
                                                                    <th>Qualification</th>
                                                                    <th>Post</th>
                                                                    <th>Experienced</th>
                                                                    <th>Address</th>
                                                                    <th>Applied On</th>
                                                                    <th>Actions</th>
                                                                </tr>
                                                            </thead>
                                                            <tbody>
                                                                <% if (applications.length> 0) { %>
                                                                    <% applications.forEach((app, index)=> { %>
                                                                        <tr id="tr-<%= app._id %>">
                                                                            <td>
                                                                                <%= index + 1 %>
                                                                            </td>
                                                                            <td>
                                                                                <%= app.name %>
                                                                            </td>
                                                                            <td>
                                                                                <%= app.mob %>
                                                                            </td>
                                                                            <td>
                                                                                <%= app.age %>
                                                                            </td>
                                                                            <td>
                                                                                <%= app.qualification %>
                                                                            </td>
                                                                            <td>
                                                                                <%= app.post %>
                                                                            </td>
                                                                            <td>
                                                                                <%= app.isExperienced ? 'Yes' : 'No' %>
                                                                            </td>
                                                                            <td>
                                                                                <%= app.address %>
                                                                            </td>
                                                                            <td>
                                                                                <%= new Date(app.createdAt).toLocaleString() %>
                                                                            </td>
                                                                            <td>
                                                                                <a href="tel:+91 <%= app.mob %>"
                                                                                    class=" btn btn-sm btn-info">
                                                                                    <i class="fa-solid fa-phone"
                                                                                        style="color:white;"></i>
                                                                                </a>
                                                                                <a href="javascript:void(0)"
                                                                                    data-id="<%= app._id %>"
                                                                                    class="btn btn-sm btn-success view-btn"
                                                                                    title="View Details"><i
                                                                                        class="fa-solid fa-eye"></i></a>
                                                                                <a href="javascript:void(0)"
                                                                                    data-id="<%= app._id %>"
                                                                                    class="btn btn-sm btn-danger delete-btn"><i
                                                                                        class="fa-solid fa-trash"></i></a>
                                                                            </td>
                                                                        </tr>
                                                                        <% }) %>
                                                                            <% } else { %>
                                                                                <tr>
                                                                                    <td colspan="10"
                                                                                        class="text-center text-muted">
                                                                                        No applications found</td>
                                                                                </tr>
                                                                                <% } %>
                                                            </tbody>
                                                        </table>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <!--**********************************
          Content body end
    ***********************************-->

                            <!-- View Modal -->
                            <div class="modal fade view-modal bd-example-modal-xl" tabindex="-1" aria-hidden="true">
                                <div class="modal-dialog modal-lg">
                                    <div class="modal-content">
                                        <div class="modal-header">
                                            <h5 class="modal-title">Transfer To Verify</h5>
                                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                        </div>
                                        <div class="modal-body">
                                            <!-- <div id="view-details" class="p-2">

                                            </div> -->

                                            <form action="/register" id="approve-form" method="POST"
                                                enctype="multipart/form-data">

                                                <!-- Row 1: Name & Mobile -->
                                                <div class="row mb-3">
                                                    <div class="col-md-6">
                                                        <label class="mb-1"><strong>Full Name</strong></label>
                                                        <input type="text" name="name" class="form-control" readonly>
                                                    </div>
                                                    <div class="col-md-6">
                                                        <label class="mb-1"><strong>Mobile Number</strong></label>
                                                        <input type="text" name="mob" class="form-control" readonly>
                                                    </div>
                                                </div>

                                                <!-- Row 2: Age & Qualification & Post -->
                                                <div class="row mb-3">
                                                    <div class="col-md-4">
                                                        <label class="mb-1"><strong>Age</strong></label>
                                                        <input type="number" name="age" class="form-control" readonly>
                                                    </div>
                                                    <div class="col-md-4">
                                                        <label class="mb-1"><strong>Qualification</strong></label>
                                                        <input type="text" name="qualification" class="form-control" readonly>
                                                    </div>
                                                    <div class="col-md-4">
                                                        <label class="mb-1"><strong>Post</strong></label>
                                                        <input type="text" name="post" class="form-control" readonly>
                                                    </div>
                                                </div>

                                                <!-- Address -->
                                                <div class="mb-3">
                                                    <label class="mb-1"><strong>Address</strong></label>
                                                    <textarea name="address" class="form-control" readonly></textarea>
                                                </div>

                                                <!-- Experience -->
                                                <div class="row mb-3">
                                                    <div class="col-md-12">
                                                        <label class="mb-1"><strong>Experience Status</strong></label>
                                                        <input type="text" name="isExperiencedDisplay" class="form-control" readonly>
                                                    </div>
                                                </div>
                                                
                                                <div class="row mb-3">
                                                    <div class="col-md-12">
                                                        <label class="mb-1"><strong>Experiences</strong></label>
                                                        <div id="modal-experiences-list" class="p-2 border rounded">
                                                            <em class="text-muted">No experiences available</em>
                                                        </div>
                                                    </div>
                                                </div>

                                                <!-- Documents Upload (Preview only) -->
                                                <div class="row mb-3">
                                                    <div class="col-md-4">
                                                        <label class="mb-1"><strong>Self Photo</strong></label>
                                                        <input type="text" name="selfPhoto" class="form-control d-none">
                                                    </div>
                                                    <div class="col-md-4">
                                                        <label class="mb-1"><strong>ID Proof Front</strong></label>
                                                        <input type="text" name="idProofFront" class="form-control d-none">
                                                    </div>
                                                    <div class="col-md-4">
                                                        <label class="mb-1"><strong>ID Proof Back</strong></label>
                                                        <input type="text" name="idProofBack" class="form-control d-none">
                                                    </div>
                                                </div>

                                                <div class="text-center mt-4">
                                                    <button type="button" class="btn btn-primary btn-block" data-bs-dismiss="modal">Close</button>
                                                </div>

                                            </form>

                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!--**********************************
          Footer start
    ***********************************-->

                            <!--**********************************
          Footer end
    ***********************************-->

            </div>

