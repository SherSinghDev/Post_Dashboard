            <script>
                // 🔍 Search filter
                $(document).on('keyup', '.search-input', function () {
                    const value = $(this).val().toLowerCase();
                    $('tbody tr').filter(function () {
                        $(this).toggle($(this).text().toLowerCase().indexOf(value) > -1);
                    });
                });

                $(document).on('change', '#relationType', function () {
                    let val = $(this).val()
                    // console.log(val);
                    let placeVal = ''

                    if (val == 's/o') {
                        placeVal = 'Son of'
                    }
                    if (val == 'd/o') {
                        placeVal = 'Daughter of'
                    }
                    if (val == 'w/o') {
                        placeVal = 'Wife of'
                    }

                    $('#relationOption').attr('placeholder', placeVal)
                })

                // 👁 View application details
                $(document).on('click', '.view-btn', function () {
                    const id = $(this).data('id');
                    $('#approve-form').attr('data-id', id)

                    fetch(`/applications/rojgaar/one/${id}`)
                        .then(res => res.json())
                        .then(data => {
                            if (data.success) {
                                const app = data.data;
                                // console.log(data.options);
                                
                                $('#parentuser').html(data.options)
                                const form = document.getElementById('approve-form');

                                // 🧩 Function to fill form and show previews
                                const fillForm = (dataObj, prefix = '') => {
                                    Object.keys(dataObj).forEach(key => {
                                        // console.log(key);


                                        let fieldName = prefix
                                            ? `${prefix}${key.charAt(0).toUpperCase() + key.slice(1)}`
                                            : key;

                                        if (key === 'receiptUrl') fieldName = 'receiptUrl';
                                        const field = form.querySelector(`[name="${fieldName}"]`);
                                        let value = dataObj[key];
                                        // console.log(value);

                                        if (!field) return;
                                        if (key === 'referredBy') value = app.referralUser ? `${app.referredBy}` : `${app.referredBy}`

                                        // console.log(key);
                                        // console.log(app[key]);

                                        // 🖼 Handle all file/document/image fields
                                        if (
                                            field.type === 'file' ||
                                            key.toLowerCase().includes('file') ||
                                            key.toLowerCase().includes('document') ||
                                            key.toLowerCase().includes('image') ||
                                            key.toLowerCase().includes('photo') ||
                                            key.toLowerCase().includes('proof') ||
                                            key.toLowerCase().includes('url')
                                        ) {
                                            const previewContainerId = `${fieldName}-preview-container`;
                                            let container = document.getElementById(previewContainerId);

                                            if (!container) {
                                                container = document.createElement('div');
                                                container.id = previewContainerId;
                                                container.style.marginTop = '10px';
                                                field.insertAdjacentElement('afterend', container);
                                            }

                                            container.innerHTML = '';

                                            if (value && typeof value === 'string' && (value.startsWith('http') || value.startsWith('/'))) {
                                                const base = window.location.origin;
                                                const url = value.startsWith('http') ? value : `${base}${value}`;

                                                // 🧩 Create thumbnail image
                                                const thumb = document.createElement('img');
                                                thumb.src = url;
                                                thumb.style.width = '120px';
                                                thumb.style.height = '120px';
                                                thumb.style.objectFit = 'cover';
                                                thumb.style.border = '1px solid #ddd';
                                                thumb.style.borderRadius = '6px';
                                                thumb.style.cursor = 'pointer';
                                                thumb.style.transition = 'transform 0.2s ease';
                                                thumb.addEventListener('mouseenter', () => thumb.style.transform = 'scale(1.05)');
                                                thumb.addEventListener('mouseleave', () => thumb.style.transform = 'scale(1)');

                                                // Click → open full preview
                                                thumb.addEventListener('click', () => openFullPreview(url));

                                                container.appendChild(thumb);
                                            }

                                            return;
                                        }

                                        // 🗓 Date fields
                                        if (field.type === 'date' && value) {
                                            field.value = new Date(value).toISOString().split('T')[0];
                                            return;
                                        }

                                        // 🔘 Others
                                        if (field.tagName === 'SELECT') {
                                            field.value = value || '';
                                        } else if (field.type === 'radio' || field.type === 'checkbox') {
                                            form.querySelectorAll(`[name="${fieldName}"]`).forEach(el => {
                                                el.checked = el.value === value;
                                            });
                                        } else {
                                            field.value = value || '';
                                        }
                                    });
                                };

                                // 🧩 Fill top-level and nested data
                                fillForm(app);

                                // Setup custom fields
                                form.querySelector('[name="isExperiencedDisplay"]').value = app.isExperienced ? "Yes" : "No";

                                const expContainer = document.getElementById('modal-experiences-list');
                                expContainer.innerHTML = '';
                                if (app.isExperienced && app.experiences && app.experiences.length > 0) {
                                    let expHtml = '<ul class="list-group">';
                                    app.experiences.forEach(exp => {
                                        expHtml += `<li class="list-group-item">
                                            <strong>${exp.companyName}</strong><br>
                                            <span class="text-muted">${exp.designation} (${exp.duration})</span>
                                        </li>`;
                                    });
                                    expHtml += '</ul>';
                                    expContainer.innerHTML = expHtml;
                                } else {
                                    expContainer.innerHTML = '<em class="text-muted">No experiences available</em>';
                                }

                                if (app.payment && typeof app.payment === 'object') fillForm(app.payment, 'payment');
                                if (app.documents && typeof app.documents === 'object') fillForm(app.documents, 'documents');

                                $('.view-modal').modal('show');
                            }
                        })
                        .catch(err => console.error(err));
                });


                // 🧩 Function to open fullscreen preview popup
                function openFullPreview(url) {
                    let overlay = document.getElementById('fullscreen-preview');
                    if (!overlay) {
                        overlay = document.createElement('div');
                        overlay.id = 'fullscreen-preview';
                        overlay.style.position = 'fixed';
                        overlay.style.top = 0;
                        overlay.style.left = 0;
                        overlay.style.width = '100vw';
                        overlay.style.height = '100vh';
                        overlay.style.backgroundColor = 'rgba(0,0,0,0.85)';
                        overlay.style.display = 'flex';
                        overlay.style.alignItems = 'center';
                        overlay.style.justifyContent = 'center';
                        overlay.style.zIndex = 2000;

                        // close button
                        const closeBtn = document.createElement('span');
                        closeBtn.innerHTML = '&times;';
                        closeBtn.style.position = 'absolute';
                        closeBtn.style.top = '20px';
                        closeBtn.style.right = '30px';
                        closeBtn.style.fontSize = '40px';
                        closeBtn.style.color = '#fff';
                        closeBtn.style.cursor = 'pointer';
                        closeBtn.addEventListener('click', () => overlay.remove());
                        overlay.appendChild(closeBtn);

                        // content
                        const content = document.createElement('div');
                        content.id = 'preview-content';
                        content.style.maxWidth = '90vw';
                        content.style.maxHeight = '85vh';
                        content.style.overflow = 'auto';
                        overlay.appendChild(content);

                        document.body.appendChild(overlay);
                    }

                    const content = document.getElementById('preview-content');
                    content.innerHTML = '';

                    // 🖼 If image
                    if (url.match(/\.(jpeg|jpg|png|gif|webp)$/i)) {
                        const img = document.createElement('img');
                        img.src = url;
                        img.style.maxWidth = '100%';
                        img.style.maxHeight = '85vh';
                        img.style.borderRadius = '10px';
                        img.style.boxShadow = '0 0 15px rgba(255,255,255,0.2)';
                        content.appendChild(img);
                    }
                    // 📄 If PDF
                    else if (url.endsWith('.pdf')) {
                        const iframe = document.createElement('iframe');
                        iframe.src = url;
                        iframe.style.width = '90vw';
                        iframe.style.height = '85vh';
                        iframe.style.border = 'none';
                        iframe.style.borderRadius = '10px';
                        content.appendChild(iframe);
                    }
                    // 🔗 Else just show link
                    else {
                        const link = document.createElement('a');
                        link.href = url;
                        link.textContent = 'View Document';
                        link.target = '_blank';
                        link.style.color = '#fff';
                        link.style.fontSize = '20px';
                        content.appendChild(link);
                    }
                }







