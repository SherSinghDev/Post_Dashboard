                $(document).on('submit', '#approve-form', async function (e) {
                    e.preventDefault();

                    const form = e.target;
                    const formData = new FormData(form);
                    let id = $(this).attr('data-id')

                    let err = [];

                    // === Basic Validations ===
                    const name = form.name.value.trim();
                    console.log("hii");
                    
                    const mobile = form.mobile.value.trim();
                    console.log("hii");
                    const gender = form.gender.value;
                    console.log("hii");
                    const dob = form.dateOfBirth.value;
                    console.log("hii");
                    const membershipType = form.membershipType.value;
                    console.log("hii");
                    // const paymentMode = form.paymentMode.value;
                    // const referredBy = form.referredBy.value.trim();
                    const authority = form.authority.value.trim();
                    console.log("hii");
                    const head = form.head.value.trim();
                    console.log("hii");
                    const validstart = form.validstart.value.trim();
                    console.log("hii");
                    const validend = form.validend.value.trim();
                    console.log("hii");
                    const parentUser = form.parentuser.value.trim();
                    console.log("hii");
                    const position = form.position.value.trim();
                    console.log("hii");
                    const type = form.type.value.trim();
                    console.log("hii");

                    // Name validation
                    if (!name) err.push("Full Name is required!");

                    // Gender validation
                    if (!gender) err.push("Please select your Gender!");

                    // DOB validation
                    if (!dob) err.push("Date of Birth is required!");

                    // Mobile validation
                    if (!/^\d{10}$/.test(mobile)) err.push("Mobile Number should be exactly 10 digits!");

                    // Membership validation
                    if (!membershipType) err.push("Please select Membership Type!");

                    // Payment mode validation
                    // if (!paymentMode) err.push("Please select a Payment Mode!");

                    // Optional but recommended field
                    // if (!referredBy) err.push("Please enter Referred By!");

                    if (!authority) err.push("Please enter Authority!");
                    if (!head) err.push("Please enter Head!");
                    if (!validstart) err.push("Please enter Valid Start!");
                    if (!validend) err.push("Please enter Valid End!");
                    if (!type) err.push("Please enter Form Type!");
                    if (!position) err.push("Please enter Valid Position!");
                    if (!parentUser) err.push("Please enter Valid Parent User!");

                    // File validations (if required)
                    // const receiptFile = form.receiptUrl.files[0];
                    // if (!receiptFile && !$('#receiptUrl-preview').length) {
                    //     err.push("Payment Receipt is required!");
                    // }

                    // const profilePic = form.profilePicture.files[0];
                    // if (!profilePic && !$('#profilePicture-preview').length) {
                    //     err.push("Profile Picture is required!");
                    // }

                    // const idDocument = form.idDocument.files[0];
                    // if (!idDocument && !$('#idDocument-preview').length) {
                    //     err.push("ID Document is required!");
                    // }

                    // If errors, show alert and stop
                    if (err.length > 0) {
                        Swal.fire({
                            icon: "error",
                            title: "Form Validation Error",
                            html: err.join("<br>"),
                        });
                        return;
                    }

                    // === Confirm before submitting ===
                    const confirmation = await Swal.fire({
                        title: "Are you sure?",
                        text: "Once approved, this application will be submitted!",
                        icon: "question",
                        showCancelButton: true,
                        confirmButtonText: "Yes, Submit",
                        cancelButtonText: "Cancel",
                    });

                    if (!confirmation.isConfirmed) return;

                    try {
                        const res = await fetch(`/applications/approve/${id}`, {
                            method: "POST",
                            body: new FormData(e.target),
                        });

                        const result = await res.json();

                        if (result.success) {
                            Swal.fire({
                                title: "Success!",
                                icon: "success",
                                text: result.message || "Application approved successfully!",
                                timer: 1500,
                                showConfirmButton: false,
                            });

                            setTimeout(() => {
                                $('.view-modal').modal('hide');
                                location.reload();
                            }, 1500);
                        } else {
                            Swal.fire({
                                icon: "error",
                                title: "Oops...",
                                text: result.message || "Something went wrong while approving.",
                            });
                        }
                    } catch (err) {
                        console.error(err);
                        Swal.fire({
                            icon: "error",
                            title: "Network Error",
                            text: err.message,
                        });
                    }
                });







