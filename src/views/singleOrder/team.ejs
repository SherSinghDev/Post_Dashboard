<!DOCTYPE html>
<html lang="en">
<%- include('../globals/head') %>

<style>
    /* Single Order Organization Team Dashboard Styling */
    .team-stat-card {
        background: #ffffff;
        border-radius: 14px;
        padding: 18px 20px;
        border: 1px solid #e2e8f0;
        box-shadow: 0 4px 14px -3px rgba(15, 23, 42, 0.05);
        display: flex;
        align-items: center;
        justify-content: space-between;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }
    .team-stat-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 20px -3px rgba(15, 23, 42, 0.08);
    }
    .team-stat-title {
        font-size: 12.5px;
        color: #64748b;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin-bottom: 4px;
    }
    .team-stat-val {
        font-size: 26px;
        font-weight: 800;
        line-height: 1.1;
    }
    .team-stat-icon {
        width: 48px;
        height: 48px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 20px;
    }

    /* Position Badges - Base & Light Mode */
    .pos-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 4px 11px;
        border-radius: 20px;
        font-size: 11.5px;
        font-weight: 700;
        letter-spacing: 0.3px;
        white-space: nowrap;
        line-height: 1.4;
    }
    .pos-badge i {
        font-size: 10.5px;
    }
    .badge-pos-state { background-color: #f3e8ff; color: #7e22ce; border: 1px solid #e9d5ff; }
    .badge-pos-district { background-color: #dbeafe; color: #1d4ed8; border: 1px solid #bfdbfe; }
    .badge-pos-block { background-color: #fef3c7; color: #b45309; border: 1px solid #fde68a; }
    .badge-pos-field { background-color: #d1fae5; color: #047857; border: 1px solid #a7f3d0; }
    .badge-pos-default { background-color: #f1f5f9; color: #475569; border: 1px solid #cbd5e1; }

    /* Hierarchy Level Badges */
    .level-badge {
        display: inline-flex;
        align-items: center;
        padding: 4px 10px;
        border-radius: 20px;
        font-size: 11px;
        font-weight: 600;
        background: #f1f5f9;
        border: 1px solid #e2e8f0;
        color: #475569;
        white-space: nowrap;
    }

    /* User ID Code Badge */
    .team-uid-badge {
        display: inline-block;
        font-family: var(--bs-font-monospace, monospace);
        font-size: 11.5px;
        font-weight: 700;
        padding: 2px 7px;
        border-radius: 6px;
        background: #f1f5f9;
        color: #334155;
        border: 1px solid #e2e8f0;
        letter-spacing: 0.3px;
        line-height: 1.3;
    }

    /* Avatar Circle */
    .team-avatar-circle {
        width: 36px;
        height: 36px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        font-size: 14px;
        background: #e0f2fe;
        color: #0284c7;
        border: 1px solid #bae6fd;
        flex-shrink: 0;
    }

    /* Referrer Level Pill (L1, L2, L3) */
    .referrer-lvl-pill {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 10px;
        font-weight: 700;
        padding: 1px 6px;
        border-radius: 10px;
        background: #e2e8f0;
        color: #475569;
        border: 1px solid #cbd5e1;
    }

    /* Patient Disease Tag */
    .patient-disease-tag {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        font-size: 12px;
        font-weight: 600;
        padding: 4px 9px;
        border-radius: 6px;
        background: #f8fafc;
        color: #1e293b;
        border: 1px solid #e2e8f0;
        white-space: nowrap;
    }

    /* Patient Status Badges */
    .patient-status-badge {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 5px 10px;
        border-radius: 6px;
        font-size: 11.5px;
        font-weight: 600;
        white-space: nowrap;
    }
    .patient-status-delivered {
        background: #dcfce7;
        color: #15803d;
        border: 1px solid #bbf7d0;
    }
    .patient-status-verified {
        background: #e0f2fe;
        color: #0369a1;
        border: 1px solid #bae6fd;
    }
    .patient-status-pending {
        background: #fef3c7;
        color: #b45309;
        border: 1px solid #fde68a;
    }

    /* Action Table Button */
    .btn-table-action {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 32px;
        height: 32px;
        border-radius: 8px;
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        color: #64748b;
        transition: all 0.2s ease;
        cursor: pointer;
    }
    .btn-table-action:hover {
        background: #0284c7;
        border-color: #0284c7;
        color: #ffffff;
    }

    /* Call Button & Pill Styling */
    .btn-call-member {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 5px 12px;
        border-radius: 6px;
        font-size: 12px;
        font-weight: 700;
        background-color: #10b981;
        color: #ffffff !important;
        border: 1px solid #059669;
        text-decoration: none;
        transition: all 0.2s ease;
        white-space: nowrap;
    }
    .btn-call-member:hover {
        background-color: #059669;
        color: #ffffff !important;
        transform: translateY(-1px);
        box-shadow: 0 4px 10px rgba(16, 185, 129, 0.3);
    }
    .btn-call-member:active {
        transform: translateY(0);
    }

    .table-call-pill {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 3px 8px;
        border-radius: 6px;
        font-weight: 600;
        font-size: 12px;
        background: rgba(16, 185, 129, 0.1);
        color: #047857;
        border: 1px solid rgba(16, 185, 129, 0.25);
        transition: all 0.2s ease;
        text-decoration: none;
    }
    .table-call-pill:hover {
        background: #10b981;
        color: #ffffff !important;
        border-color: #10b981;
    }
    .table-call-pill:hover i {
        color: #ffffff !important;
    }

    /* Table text styling */
    .table-main-text {
        color: #0f172a;
    }
    .table-sub-text {
        color: #64748b;
    }

    /* Filter Pills */
    .filter-pill-btn {
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        color: #475569;
        font-size: 13px;
        font-weight: 600;
        padding: 7px 16px;
        border-radius: 20px;
        transition: all 0.2s ease;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }
    .filter-pill-btn:hover {
        background: #f1f5f9;
        color: #0f172a;
    }
    .filter-pill-btn.active {
        background: #0284c7;
        color: #ffffff;
        border-color: #0284c7;
        box-shadow: 0 4px 10px rgba(2, 132, 199, 0.25);
    }
    .filter-pill-btn .pill-count {
        background: rgba(0, 0, 0, 0.08);
        padding: 1px 7px;
        border-radius: 10px;
        font-size: 11px;
    }
    .filter-pill-btn.active .pill-count {
        background: rgba(255, 255, 255, 0.25);
        color: #ffffff;
    }

    /* Custom Navigation Tabs */
    .team-tabs {
        border-bottom: 2px solid #e2e8f0;
        display: flex;
        gap: 10px;
        margin-bottom: 20px;
    }
    .team-tab-btn {
        padding: 12px 22px;
        font-size: 15px;
        font-weight: 600;
        color: #64748b;
        background: none;
        border: none;
        border-bottom: 3px solid transparent;
        margin-bottom: -2px;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        transition: all 0.2s ease;
    }
    .team-tab-btn:hover {
        color: #0284c7;
    }
    .team-tab-btn.active {
        color: #0284c7;
        border-bottom-color: #0284c7;
        font-weight: 700;
    }
    .team-tab-btn .tab-badge {
        font-size: 12px;
        padding: 3px 9px;
        border-radius: 20px;
        background: #e2e8f0;
        color: #475569;
    }
    .team-tab-btn.active .tab-badge {
        background: #e0f2fe;
        color: #0284c7;
    }

    /* Custom Tables */
    .team-table thead th {
        background: #f8fafc;
        color: #475569;
        font-size: 11.5px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        border-bottom: 2px solid #e2e8f0;
        padding: 12px 14px;
        white-space: nowrap;
    }
    .team-table tbody td {
        padding: 13px 14px;
        vertical-align: middle;
        font-size: 13px;
        border-bottom: 1px solid #f1f5f9;
    }
    .team-table tbody tr:hover td {
        background-color: #f8fafc;
    }

    /* Hierarchy path display */
    .hierarchy-chain {
        font-size: 11.5px;
        color: #64748b;
        display: flex;
        align-items: center;
        gap: 4px;
    }

    /* ========================================================
       DARK MODE OVERRIDES FOR SINGLE ORDER TEAM & PATIENTS
       ======================================================== */
    [data-theme-version="dark"] .team-stat-card {
        background: #0f172a !important;
        border-color: #1e293b !important;
        box-shadow: 0 4px 16px rgba(0, 0, 0, 0.3) !important;
    }
    [data-theme-version="dark"] .team-stat-card:hover {
        border-color: #38bdf8 !important;
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4) !important;
    }
    [data-theme-version="dark"] .team-stat-title {
        color: #94a3b8 !important;
    }
    [data-theme-version="dark"] .team-stat-icon {
        opacity: 0.95;
    }

    /* Cards & Containers in Dark Mode */
    [data-theme-version="dark"] .card {
        background: #0f172a !important;
        border: 1px solid #1e293b !important;
        box-shadow: 0 4px 16px rgba(0, 0, 0, 0.3) !important;
    }

    /* Tabs */
    [data-theme-version="dark"] .team-tabs {
        border-bottom-color: #334155 !important;
    }
    [data-theme-version="dark"] .team-tab-btn {
        color: #94a3b8 !important;
    }
    [data-theme-version="dark"] .team-tab-btn:hover {
        color: #38bdf8 !important;
    }
    [data-theme-version="dark"] .team-tab-btn.active {
        color: #38bdf8 !important;
        border-bottom-color: #38bdf8 !important;
    }
    [data-theme-version="dark"] .team-tab-btn .tab-badge {
        background: #1e293b !important;
        color: #94a3b8 !important;
    }
    [data-theme-version="dark"] .team-tab-btn.active .tab-badge {
        background: rgba(2, 132, 199, 0.25) !important;
        color: #38bdf8 !important;
    }

    /* Filter Buttons */
    [data-theme-version="dark"] .filter-pill-btn {
        background: #1e293b !important;
        border-color: #334155 !important;
        color: #cbd5e1 !important;
    }
    [data-theme-version="dark"] .filter-pill-btn:hover {
        background: #334155 !important;
        color: #f8fafc !important;
        border-color: #475569 !important;
    }
    [data-theme-version="dark"] .filter-pill-btn.active {
        background: #0284c7 !important;
        color: #ffffff !important;
        border-color: #0284c7 !important;
        box-shadow: 0 4px 12px rgba(2, 132, 199, 0.4) !important;
    }

    /* Table Structure & Text Contrast */
    [data-theme-version="dark"] .team-table thead th {
        background: #1e293b !important;
        color: #cbd5e1 !important;
        border-bottom-color: #334155 !important;
    }
    [data-theme-version="dark"] .team-table tbody td {
        border-bottom-color: #1e293b !important;
        color: #cbd5e1 !important;
    }
    [data-theme-version="dark"] .team-table tbody tr:hover td {
        background-color: #1e293b !important;
    }

    /* Text elements in Dark Mode */
    [data-theme-version="dark"] .table-main-text,
    [data-theme-version="dark"] .text-dark,
    [data-theme-version="dark"] .team-table .text-dark,
    [data-theme-version="dark"] h3.text-dark,
    [data-theme-version="dark"] .fw-bold.text-dark,
    [data-theme-version="dark"] .fw-semibold.text-dark {
        color: #f1f5f9 !important;
    }
    [data-theme-version="dark"] .table-sub-text,
    [data-theme-version="dark"] .text-muted,
    [data-theme-version="dark"] .team-table .text-muted {
        color: #94a3b8 !important;
    }
    [data-theme-version="dark"] .hierarchy-chain {
        color: #94a3b8 !important;
    }

    /* Avatars in Dark Mode */
    [data-theme-version="dark"] .team-avatar-circle {
        background: rgba(2, 132, 199, 0.22) !important;
        color: #38bdf8 !important;
        border: 1px solid rgba(56, 189, 248, 0.4) !important;
    }

    /* User ID Badge in Dark Mode */
    [data-theme-version="dark"] .team-uid-badge {
        background: #1e293b !important;
        color: #93c5fd !important;
        border: 1px solid #334155 !important;
    }

    /* Hierarchy Level Badges in Dark Mode */
    [data-theme-version="dark"] .level-badge {
        background: rgba(30, 41, 59, 0.85) !important;
        border: 1px solid #334155 !important;
        color: #cbd5e1 !important;
    }
    [data-theme-version="dark"] .level-badge i.text-primary {
        color: #38bdf8 !important;
    }
    [data-theme-version="dark"] .level-badge i.text-muted {
        color: #94a3b8 !important;
    }

    /* Referrer Downline Level Pill in Dark Mode */
    [data-theme-version="dark"] .referrer-lvl-pill {
        background: #1e293b !important;
        color: #cbd5e1 !important;
        border: 1px solid #334155 !important;
    }

    /* Disease Tag in Dark Mode */
    [data-theme-version="dark"] .patient-disease-tag {
        background: #1e293b !important;
        color: #f1f5f9 !important;
        border: 1px solid #334155 !important;
    }

    /* Position Badges in Dark Mode - High Contrast Translucent Aesthetic */
    [data-theme-version="dark"] .pos-badge.badge-pos-state,
    [data-theme-version="dark"] .badge-pos-state {
        background-color: rgba(168, 85, 247, 0.2) !important;
        color: #d8b4fe !important;
        border: 1px solid rgba(168, 85, 247, 0.45) !important;
    }
    [data-theme-version="dark"] .pos-badge.badge-pos-district,
    [data-theme-version="dark"] .badge-pos-district {
        background-color: rgba(56, 189, 248, 0.2) !important;
        color: #38bdf8 !important;
        border: 1px solid rgba(56, 189, 248, 0.45) !important;
    }
    [data-theme-version="dark"] .pos-badge.badge-pos-block,
    [data-theme-version="dark"] .badge-pos-block {
        background-color: rgba(245, 158, 11, 0.2) !important;
        color: #fbbf24 !important;
        border: 1px solid rgba(245, 158, 11, 0.45) !important;
    }
    [data-theme-version="dark"] .pos-badge.badge-pos-field,
    [data-theme-version="dark"] .badge-pos-field {
        background-color: rgba(52, 211, 153, 0.2) !important;
        color: #34d399 !important;
        border: 1px solid rgba(52, 211, 153, 0.45) !important;
    }
    [data-theme-version="dark"] .pos-badge.badge-pos-default,
    [data-theme-version="dark"] .badge-pos-default {
        background-color: rgba(148, 163, 184, 0.2) !important;
        color: #cbd5e1 !important;
        border: 1px solid rgba(148, 163, 184, 0.4) !important;
    }

    /* Patient Status Badges in Dark Mode */
    [data-theme-version="dark"] .patient-status-delivered {
        background-color: rgba(34, 197, 94, 0.18) !important;
        color: #4ade80 !important;
        border: 1px solid rgba(34, 197, 94, 0.4) !important;
    }
    [data-theme-version="dark"] .patient-status-verified {
        background-color: rgba(56, 189, 248, 0.18) !important;
        color: #38bdf8 !important;
        border: 1px solid rgba(56, 189, 248, 0.4) !important;
    }
    [data-theme-version="dark"] .patient-status-pending {
        background-color: rgba(245, 158, 11, 0.18) !important;
        color: #fbbf24 !important;
        border: 1px solid rgba(245, 158, 11, 0.4) !important;
    }

    /* Action Buttons in Dark Mode */
    [data-theme-version="dark"] .btn-table-action {
        background: #1e293b !important;
        border-color: #334155 !important;
        color: #94a3b8 !important;
    }
    [data-theme-version="dark"] .btn-table-action:hover {
        background: #0284c7 !important;
        border-color: #0284c7 !important;
        color: #ffffff !important;
    }
    [data-theme-version="dark"] .btn-call-member {
        background-color: #059669 !important;
        border-color: #10b981 !important;
        color: #ffffff !important;
    }
    [data-theme-version="dark"] .btn-call-member:hover {
        background-color: #10b981 !important;
        border-color: #34d399 !important;
        box-shadow: 0 4px 12px rgba(16, 185, 129, 0.4) !important;
    }
    [data-theme-version="dark"] .table-call-pill {
        background: rgba(16, 185, 129, 0.18) !important;
        color: #34d399 !important;
        border-color: rgba(16, 185, 129, 0.4) !important;
    }
    [data-theme-version="dark"] .table-call-pill:hover {
        background: #059669 !important;
        color: #ffffff !important;
        border-color: #059669 !important;
    }

    /* Search & Inputs */
    [data-theme-version="dark"] .input-group-text.bg-light {
        background-color: #1e293b !important;
        border-color: #334155 !important;
        color: #94a3b8 !important;
    }
    [data-theme-version="dark"] #memberSearchInput,
    [data-theme-version="dark"] #patientSearchInput,
    [data-theme-version="dark"] #patientStatusFilter {
        background-color: #0f172a !important;
        border-color: #334155 !important;
        color: #f1f5f9 !important;
    }
    [data-theme-version="dark"] #memberSearchInput::placeholder,
    [data-theme-version="dark"] #patientSearchInput::placeholder {
        color: #64748b !important;
    }
    [data-theme-version="dark"] #memberSearchInput:focus,
    [data-theme-version="dark"] #patientSearchInput:focus,
    [data-theme-version="dark"] #patientStatusFilter:focus {
        border-color: #38bdf8 !important;
        box-shadow: 0 0 0 0.2rem rgba(56, 189, 248, 0.2) !important;
    }
    [data-theme-version="dark"] #patientStatusFilter option {
        background-color: #0f172a !important;
        color: #f1f5f9 !important;
    }

    /* Buttons in Dark Mode */
    [data-theme-version="dark"] .btn-outline-primary {
        border-color: #38bdf8 !important;
        color: #38bdf8 !important;
    }
    [data-theme-version="dark"] .btn-outline-primary:hover {
        background-color: #0284c7 !important;
        color: #ffffff !important;
    }
    [data-theme-version="dark"] .btn-outline-info {
        border-color: #06b6d4 !important;
        color: #22d3ee !important;
    }
    [data-theme-version="dark"] .btn-outline-info:hover {
        background-color: #0891b2 !important;
        color: #ffffff !important;
    }
    [data-theme-version="dark"] .btn-outline-secondary {
        border-color: #64748b !important;
        color: #cbd5e1 !important;
    }
    [data-theme-version="dark"] .btn-outline-secondary:hover {
        background-color: #334155 !important;
        color: #f8fafc !important;
    }

    /* Modal in Dark Mode */
    [data-theme-version="dark"] #patientQuickModal .modal-content {
        background-color: #0f172a !important;
        border: 1px solid #1e293b !important;
        color: #f1f5f9 !important;
    }
    [data-theme-version="dark"] #patientQuickModal .modal-header.bg-light,
    [data-theme-version="dark"] #patientQuickModal .modal-footer.bg-light {
        background-color: #1e293b !important;
        border-color: #334155 !important;
        color: #f1f5f9 !important;
    }
    [data-theme-version="dark"] #patientQuickModal .modal-title {
        color: #f1f5f9 !important;
    }
    [data-theme-version="dark"] #patientQuickModal .border-bottom {
        border-bottom-color: #1e293b !important;
    }
    [data-theme-version="dark"] #patientQuickModal .text-muted {
        color: #94a3b8 !important;
    }
    [data-theme-version="dark"] #patientQuickModal .btn-close {
        filter: invert(1) grayscale(100%) brightness(200%);
    }

    /* Empty state rows */
    [data-theme-version="dark"] #emptyMemberRow td,
    [data-theme-version="dark"] #emptyPatientRow td {
        color: #94a3b8 !important;
    }
    [data-theme-version="dark"] #emptyMemberRow i,
    [data-theme-version="dark"] #emptyPatientRow i {
        color: #334155 !important;
    }
</style>

<body>
    <%- include('../globals/preloader') %>

    <div id="main-wrapper" class="show">
        <%- include('../globals/navHeader') %>
        <%- include('../globals/header') %>
        <%- include('../globals/sidebar') %>

        <div class="content-body">
            <div class="container-fluid">

                <!-- Page Header -->
                <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
                    <div>
                        <h3 class="fw-bold text-dark mb-1">
                            <i class="fas fa-sitemap text-primary me-2"></i>My Organization Team & Referred Patients
                        </h3>
                        <p class="text-muted mb-0 small">
                            Hierarchy: <strong>State Head</strong> &rarr; <strong>District Officer</strong> &rarr; <strong>Block Officer</strong> &rarr; <strong>Field Officer</strong>
                        </p>
                    </div>
                    <div class="d-flex gap-2 flex-wrap">
                        <a href="/patientform/<%= user.userId %>" target="_blank" class="btn btn-outline-primary fw-semibold">
                            <i class="fas fa-file-medical me-1"></i>Refer Patient
                        </a>
                        <a href="/applications/type/singleorder" target="_blank" class="btn btn-primary fw-semibold">
                            <i class="fas fa-user-plus me-1"></i>Refer Team Member
                        </a>
                    </div>
                </div>

                <!-- Summary Overview Cards -->
                <div class="row g-3 mb-4">
                    <!-- Direct Child Officers -->
                    <div class="col-xl-3 col-sm-6">
                        <div class="team-stat-card">
                            <div>
                                <div class="team-stat-title">Direct Officers / सीधे अधिकारी</div>
                                <div class="team-stat-val text-primary"><%= counts.direct || 0 %></div>
                                <small class="text-muted">Directly reporting to you</small>
                            </div>
                            <div class="team-stat-icon" style="background: #e0f2fe; color: #0284c7;">
                                <i class="fas fa-user-friends"></i>
                            </div>
                        </div>
                    </div>

                    <!-- Total Team Downline -->
                    <div class="col-xl-3 col-sm-6">
                        <div class="team-stat-card">
                            <div>
                                <div class="team-stat-title">Total Team / कुल संगठन टीम</div>
                                <div class="team-stat-val" style="color: #7c3aed;"><%= counts.totalTeam || 0 %></div>
                                <small class="text-muted">All descendants in network</small>
                            </div>
                            <div class="team-stat-icon" style="background: #f3e8ff; color: #7c3aed;">
                                <i class="fas fa-users-line"></i>
                            </div>
                        </div>
                    </div>

                    <!-- Total Team Referred Patients -->
                    <div class="col-xl-3 col-sm-6">
                        <div class="team-stat-card">
                            <div>
                                <div class="team-stat-title">Team Patients / टीम के मरीज</div>
                                <div class="team-stat-val text-info"><%= counts.totalPatients || 0 %></div>
                                <small class="text-muted">Forms filled by team</small>
                            </div>
                            <div class="team-stat-icon" style="background: #cffafe; color: #0891b2;">
                                <i class="fas fa-hospital-user"></i>
                            </div>
                        </div>
                    </div>

                    <!-- Verified Patients -->
                    <div class="col-xl-3 col-sm-6">
                        <div class="team-stat-card">
                            <div>
                                <div class="team-stat-title">Verified Patients / सत्यापित मरीज</div>
                                <div class="team-stat-val text-success"><%= counts.verifiedPatients || 0 %></div>
                                <small class="text-muted">Doctor approved forms</small>
                            </div>
                            <div class="team-stat-icon" style="background: #dcfce7; color: #16a34a;">
                                <i class="fas fa-check-circle"></i>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Navigation Tabs -->
                <div class="team-tabs">
                    <button type="button" class="team-tab-btn active" id="tabBtnMembers" onclick="switchTeamTab('members')">
                        <i class="fas fa-users"></i>
                        <span>Team Members / संगठन सदस्य</span>
                        <span class="tab-badge" id="membersCountBadge"><%= descendants.length %></span>
                    </button>
                    <button type="button" class="team-tab-btn" id="tabBtnPatients" onclick="switchTeamTab('patients')">
                        <i class="fas fa-file-medical-alt"></i>
                        <span>Team Referred Patients / टीम द्वारा रेफर मरीज</span>
                        <span class="tab-badge" id="patientsCountBadge"><%= patients.length %></span>
                    </button>
                </div>

                <!-- ========================================== -->
                <!-- TAB 1: TEAM MEMBERS LIST                   -->
                <!-- ========================================== -->
                <div id="sectionMembers" class="team-section">
                    <div class="card border-0 shadow-sm mb-4">
                        <div class="card-body p-3">
                            <!-- Filters & Search Toolbar -->
                            <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-3">
                                <!-- Position Filter Pills -->
                                <div class="d-flex flex-wrap gap-2 align-items-center" id="memberPositionFilters">
                                    <span class="text-muted small fw-bold me-1">Position:</span>
                                    <button type="button" class="filter-pill-btn active" data-pos="all" onclick="filterMembersByPos('all', this)">
                                        All <span class="pill-count"><%= descendants.length %></span>
                                    </button>
                                    <% ['State Head', 'District Officer', 'Block Officer', 'Field Officer'].forEach(function(pos) { %>
                                        <% const count = (counts.byPosition && counts.byPosition[pos]) || 0; %>
                                        <% if (count > 0 || distinctPositions.includes(pos)) { %>
                                            <button type="button" class="filter-pill-btn" data-pos="<%= pos %>" onclick="filterMembersByPos('<%= pos %>', this)">
                                                <%= pos %> <span class="pill-count"><%= count %></span>
                                            </button>
                                        <% } %>
                                    <% }); %>
                                </div>

                                <!-- Search Input -->
                                <div class="input-group" style="max-width: 320px;">
                                    <span class="input-group-text bg-light border-end-0">
                                        <i class="fas fa-search text-muted"></i>
                                    </span>
                                    <input type="text" id="memberSearchInput" class="form-control border-start-0 ps-0" placeholder="Search member by name, ID, mobile, district...">
                                </div>
                            </div>

                            <!-- Members Table -->
                            <div class="table-responsive">
                                <table class="table table-hover team-table mb-0" id="membersTable">
                                    <thead>
                                        <tr>
                                            <th>#</th>
                                            <th>Member / अधिकारी</th>
                                            <th>Position / पद</th>
                                            <th>Hierarchy Level</th>
                                            <th>Reporting To / पालक</th>
                                            <th>Location / क्षेत्र</th>
                                            <th style="min-width: 145px;">Contact / संपर्क</th>
                                            <th class="text-center">Referred Patients</th>
                                            <th>Joined Date</th>
                                            <th class="text-end" style="min-width: 180px;">Action</th>
                                        </tr>
                                    </thead>
                                    <tbody id="membersTableBody">
                                        <% if (descendants && descendants.length > 0) { %>
                                            <% descendants.forEach(function(m, idx) { %>
                                                <% 
                                                    let posClass = 'badge-pos-default';
                                                    if (m.normPosition === 'State Head') posClass = 'badge-pos-state';
                                                    else if (m.normPosition === 'District Officer') posClass = 'badge-pos-district';
                                                    else if (m.normPosition === 'Block Officer') posClass = 'badge-pos-block';
                                                    else if (m.normPosition === 'Field Officer') posClass = 'badge-pos-field';
                                                %>
                                                <tr class="member-row" 
                                                    data-pos="<%= m.normPosition || '' %>"
                                                    data-raw-pos="<%= m.position || '' %>"
                                                    data-id="<%= m.userId || '' %>"
                                                    data-search="<%= (m.name || '') + ' ' + (m.userId || '') + ' ' + (m.mobile || '') + ' ' + (m.district || '') + ' ' + (m.block || '') + ' ' + (m.normPosition || '') %>">
                                                    <td class="text-muted"><%= idx + 1 %></td>
                                                    <td>
                                                        <div class="d-flex align-items-center gap-2">
                                                            <div class="team-avatar-circle">
                                                                <%= (m.name || 'U').charAt(0).toUpperCase() %>
                                                            </div>
                                                            <div>
                                                                <div class="fw-bold table-main-text"><%= m.name %></div>
                                                                <div class="d-flex align-items-center gap-1 mt-1">
                                                                    <span class="table-sub-text small">ID:</span>
                                                                    <span class="team-uid-badge">#<%= m.userId || 'N/A' %></span>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </td>
                                                    <td>
                                                        <span class="pos-badge <%= posClass %>">
                                                            <i class="fas fa-id-badge"></i> <%= m.position || m.normPosition %>
                                                        </span>
                                                    </td>
                                                    <td>
                                                        <span class="level-badge">
                                                            <% if (m.level === 1) { %>
                                                                <i class="fas fa-check-circle text-primary me-1"></i>Direct Child (L1)
                                                            <% } else { %>
                                                                <i class="fas fa-level-down-alt text-muted me-1"></i>Level <%= m.level %> Downline
                                                            <% } %>
                                                        </span>
                                                    </td>
                                                    <td>
                                                        <div>
                                                            <div class="fw-semibold table-main-text small"><%= m.parentName || 'Direct' %></div>
                                                            <div class="hierarchy-chain">
                                                                <span><%= m.parentPosition || '' %></span>
                                                                <% if (m.parentDisplayId) { %>
                                                                    <span>[ID: <%= m.parentDisplayId %>]</span>
                                                                <% } %>
                                                            </div>
                                                        </div>
                                                    </td>
                                                    <td>
                                                        <div class="small">
                                                            <div class="fw-semibold table-main-text"><%= m.district || m.city || 'N/A' %></div>
                                                            <div class="table-sub-text"><%= m.block ? 'Block: ' + m.block + ', ' : '' %><%= m.state || '' %></div>
                                                        </div>
                                                    </td>
                                                    <td>
                                                        <div class="small">
                                                            <% if (m.mobile) { %>
                                                                <div>
                                                                    <a href="tel:<%= m.mobile %>" class="table-call-pill" title="Click to Call <%= m.mobile %>">
                                                                        <i class="fas fa-phone-alt text-success me-1"></i><%= m.mobile %>
                                                                    </a>
                                                                </div>
                                                            <% } else { %>
                                                                <div class="table-sub-text"><i class="fas fa-phone-slash me-1"></i>N/A</div>
                                                            <% } %>
                                                            <% if (m.email) { %>
                                                                <div class="table-sub-text mt-1"><i class="fas fa-envelope table-sub-text me-1"></i><%= m.email %></div>
                                                            <% } %>
                                                        </div>
                                                    </td>
                                                    <td class="text-center">
                                                        <span class="badge rounded-pill <%= m.totalPatientsReferred > 0 ? 'bg-info text-white' : 'team-uid-badge' %> px-3 py-2 fw-bold" style="font-size: 13px;">
                                                            <%= m.totalPatientsReferred || 0 %>
                                                        </span>
                                                    </td>
                                                    <td class="table-sub-text small">
                                                        <%= m.createdAt ? new Date(m.createdAt).toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric' }) : 'N/A' %>
                                                    </td>
                                                    <td class="text-end">
                                                        <div class="d-inline-flex align-items-center gap-1 justify-content-end">
                                                            <% if (m.mobile) { %>
                                                                <a href="tel:<%= m.mobile %>" 
                                                                   class="btn-call-member" 
                                                                   title="Call <%= m.name %> (<%= m.mobile %>)">
                                                                    <i class="fas fa-phone-alt"></i> Call
                                                                </a>
                                                            <% } %>
                                                            <button type="button" 
                                                                    class="btn btn-sm btn-outline-info" 
                                                                    title="View Patients Referred by this Member"
                                                                    onclick="filterPatientsByMember('<%= m.userId %>', '<%= m.name %>')">
                                                                <i class="fas fa-notes-medical me-1"></i>Patients
                                                            </button>
                                                        </div>
                                                    </td>
                                                </tr>
                                            <% }); %>
                                        <% } else { %>
                                            <tr id="emptyMemberRow">
                                                <td colspan="10" class="text-center py-5 text-muted">
                                                    <i class="fas fa-users-slash fa-3x text-light mb-3 d-block"></i>
                                                    <h5>No Team Members Found</h5>
                                                    <p class="small">You do not have any child users reporting under your organization hierarchy yet.</p>
                                                    <a href="/applications/type/singleorder" target="_blank" class="btn btn-sm btn-primary">
                                                        <i class="fas fa-user-plus me-1"></i>Refer First Member
                                                    </a>
                                                </td>
                                            </tr>
                                        <% } %>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- ========================================== -->
                <!-- TAB 2: TEAM REFERRED PATIENTS LIST         -->
                <!-- ========================================== -->
                <div id="sectionPatients" class="team-section" style="display: none;">
                    <div class="card border-0 shadow-sm mb-4">
                        <div class="card-body p-3">
                            <!-- Filters & Search Toolbar -->
                            <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-3">
                                <!-- Filter Pills by Referrer's Position -->
                                <div class="d-flex flex-wrap gap-2 align-items-center" id="patientPositionFilters">
                                    <span class="text-muted small fw-bold me-1">Referrer Position:</span>
                                    <button type="button" class="filter-pill-btn active" data-pos="all" onclick="filterPatientsByPos('all', this)">
                                        All Positions <span class="pill-count"><%= patients.length %></span>
                                    </button>
                                    <% ['State Head', 'District Officer', 'Block Officer', 'Field Officer'].forEach(function(pos) { %>
                                        <button type="button" class="filter-pill-btn" data-pos="<%= pos %>" onclick="filterPatientsByPos('<%= pos %>', this)">
                                            <%= pos %>
                                        </button>
                                    <% }); %>
                                </div>

                                <!-- Active Member Filter Tag (if filtered by clicking specific member) -->
                                <div id="activeMemberFilterPill" style="display: none;" class="align-items-center gap-2">
                                    <span class="badge bg-primary px-3 py-2 d-inline-flex align-items-center gap-2">
                                        <span>Filtered by Referrer: <strong id="activeMemberFilterName"></strong></span>
                                        <button type="button" class="btn-close btn-close-white" style="font-size: 10px;" onclick="clearMemberPatientFilter()"></button>
                                    </span>
                                </div>

                                <!-- Status & Search Controls -->
                                <div class="d-flex gap-2 flex-wrap" style="max-width: 450px;">
                                    <select id="patientStatusFilter" class="form-select form-select-sm" style="width: 140px;" onchange="applyPatientFilters()">
                                        <option value="all">All Status</option>
                                        <option value="verified">Verified</option>
                                        <option value="pending">Pending</option>
                                        <option value="delivered">Delivered</option>
                                    </select>
                                    <div class="input-group">
                                        <span class="input-group-text bg-light border-end-0">
                                            <i class="fas fa-search text-muted"></i>
                                        </span>
                                        <input type="text" id="patientSearchInput" class="form-control form-control-sm border-start-0 ps-0" placeholder="Search patient, reg no, referrer...">
                                    </div>
                                </div>
                            </div>

                            <!-- Patients Table -->
                            <div class="table-responsive">
                                <table class="table table-hover team-table mb-0" id="patientsTable">
                                    <thead>
                                        <tr>
                                            <th style="min-width: 45px;">#</th>
                                            <th style="min-width: 135px;">Reg. No & Date</th>
                                            <th style="min-width: 170px;">Patient Name / मरीज का नाम</th>
                                            <th style="min-width: 170px;">Disease / बीमारी</th>
                                            <th style="min-width: 130px;">Location / क्षेत्र</th>
                                            <th style="min-width: 180px;">Referred By / रेफरर</th>
                                            <th style="min-width: 150px;">Referrer Position</th>
                                            <th style="min-width: 140px;">Status / स्थिति</th>
                                            <th style="min-width: 70px;" class="text-end">Details</th>
                                        </tr>
                                    </thead>
                                    <tbody id="patientsTableBody">
                                        <% if (patients && patients.length > 0) { %>
                                            <% patients.forEach(function(p, pIdx) { %>
                                                <%
                                                     let docStatus = (p.otherStatus && p.otherStatus.doctorStatus) || 'pending';
                                                    let delivStatus = (p.otherStatus && p.otherStatus.deliveryStatus) || '';
                                                    let isDelivered = ['delivered', 'Delivered', 'DELIVERED'].includes(delivStatus);
                                                    let isVerified = !isDelivered && docStatus && docStatus !== '' && docStatus.toLowerCase() !== 'pending';

                                                    let refPosClass = 'badge-pos-default';
                                                    if (p.referrerNormPosition === 'State Head') refPosClass = 'badge-pos-state';
                                                    else if (p.referrerNormPosition === 'District Officer') refPosClass = 'badge-pos-district';
                                                    else if (p.referrerNormPosition === 'Block Officer') refPosClass = 'badge-pos-block';
                                                    else if (p.referrerNormPosition === 'Field Officer') refPosClass = 'badge-pos-field';
                                                %>
                                                <tr class="patient-row"
                                                    data-ref-pos="<%= p.referrerNormPosition || '' %>"
                                                    data-ref-id="<%= p.referrerUserId || '' %>"
                                                    data-status="<%= isDelivered ? 'delivered' : (isVerified ? 'verified' : 'pending') %>"
                                                    data-search="<%= (p.patientName || '') + ' ' + (p.registerNo || '') + ' ' + (p.mobileNumber || '') + ' ' + (p.diseaseName || '') + ' ' + (p.referrerName || '') + ' ' + (p.referrerUserId || '') + ' ' + (p.referrerNormPosition || '') %>">
                                                    <td class="table-sub-text"><%= pIdx + 1 %></td>
                                                    <td>
                                                        <div class="fw-bold text-primary font-monospace"><%= p.registerNo || 'N/A' %></div>
                                                        <div class="table-sub-text small">
                                                            <%= p.createdAt ? new Date(p.createdAt).toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric' }) : '' %>
                                                        </div>
                                                    </td>
                                                    <td>
                                                        <div class="fw-bold table-main-text"><%= p.patientName %></div>
                                                        <div class="table-sub-text small mt-1">
                                                            <% if (p.mobileNumber) { %>
                                                                <a href="tel:<%= p.mobileNumber %>" class="table-call-pill" style="font-size: 11px; padding: 2px 7px;" title="Call Patient">
                                                                    <i class="fas fa-phone-alt text-success me-1"></i><%= p.mobileNumber %>
                                                                </a>
                                                            <% } else { %>
                                                                <i class="fas fa-phone-slash me-1"></i>N/A
                                                            <% } %>
                                                        </div>
                                                    </td>
                                                    <td>
                                                        <div class="patient-disease-tag">
                                                            <i class="fas fa-notes-medical me-1 text-primary"></i><%= p.diseaseName || 'General Care' %>
                                                        </div>
                                                        <% if (p.duration) { %>
                                                            <div class="small table-sub-text mt-1"><%= p.duration %></div>
                                                        <% } %>
                                                    </td>
                                                    <td>
                                                        <div class="small">
                                                            <div class="table-main-text fw-semibold"><%= p.cityOrDistrict || 'N/A' %></div>
                                                            <div class="table-sub-text"><%= p.state || '' %></div>
                                                        </div>
                                                    </td>
                                                    <td>
                                                        <div>
                                                            <div class="fw-bold table-main-text small"><%= p.referrerName %></div>
                                                            <div class="d-flex align-items-center gap-1 mt-1">
                                                                <span class="table-sub-text small">ID:</span>
                                                                <span class="team-uid-badge">#<%= p.referrerUserId %></span>
                                                                <% if (p.referrerLevel) { %>
                                                                    <span class="referrer-lvl-pill ms-1">L<%= p.referrerLevel %></span>
                                                                <% } %>
                                                            </div>
                                                        </div>
                                                    </td>
                                                    <td>
                                                        <span class="pos-badge <%= refPosClass %>">
                                                            <i class="fas fa-id-badge"></i> <%= p.referrerPosition || p.referrerNormPosition %>
                                                        </span>
                                                    </td>
                                                    <td>
                                                        <% if (isDelivered) { %>
                                                            <span class="patient-status-badge patient-status-delivered">
                                                                <i class="fas fa-truck-ramp-box me-1"></i>Delivered
                                                            </span>
                                                        <% } else if (isVerified) { %>
                                                            <span class="patient-status-badge patient-status-verified">
                                                                <i class="fas fa-user-check me-1"></i>Verified (<%= docStatus %>)
                                                            </span>
                                                        <% } else { %>
                                                            <span class="patient-status-badge patient-status-pending">
                                                                <i class="fas fa-hourglass-half me-1"></i>Pending Review
                                                            </span>
                                                        <% } %>
                                                    </td>
                                                    <td class="text-end">
                                                        <button type="button" 
                                                                class="btn-table-action" 
                                                                title="View Details"
                                                                onclick="showPatientModal('<%= p.registerNo %>', '<%= p.patientName %>', '<%= p.mobileNumber %>', '<%= p.diseaseName %>', '<%= p.cityOrDistrict %>', '<%= p.state %>', '<%= p.referrerName %>', '<%= p.referrerPosition %>', '<%= p.createdAt %>')">
                                                            <i class="fas fa-eye"></i>
                                                        </button>
                                                    </td>
                                                </tr>
                                            <% }); %>
                                        <% } else { %>
                                            <tr id="emptyPatientRow">
                                                <td colspan="9" class="text-center py-5 text-muted">
                                                    <i class="fas fa-file-medical fa-3x text-light mb-3 d-block"></i>
                                                    <h5>No Referred Patient Forms Yet</h5>
                                                    <p class="small">None of your descendant team members have referred any patient forms so far.</p>
                                                    <a href="/patientform/<%= user.userId %>" target="_blank" class="btn btn-sm btn-primary">
                                                        <i class="fas fa-plus me-1"></i>Refer Patient Form
                                                    </a>
                                                </td>
                                            </tr>
                                        <% } %>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>

    <!-- Quick Patient Details Modal -->
    <div class="modal fade" id="patientQuickModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow">
                <div class="modal-header bg-light">
                    <h5 class="modal-title fw-bold" id="modalPatientTitle">Patient Details</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom">
                        <span class="table-sub-text">Registration No:</span>
                        <span class="fw-bold font-monospace text-primary" id="mRegNo"></span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom">
                        <span class="table-sub-text">Patient Name:</span>
                        <span class="fw-bold table-main-text" id="mName"></span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom">
                        <span class="table-sub-text">Mobile Number:</span>
                        <div class="d-flex align-items-center gap-2">
                            <span class="fw-bold table-main-text" id="mMobile"></span>
                            <a id="mCallBtn" href="#" class="btn btn-sm btn-success px-2 py-1" style="font-size: 11.5px; border-radius: 6px; display: none;">
                                <i class="fas fa-phone-alt me-1"></i>Call
                            </a>
                        </div>
                    </div>
                    <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom">
                        <span class="table-sub-text">Disease / Condition:</span>
                        <span class="patient-disease-tag" id="mDisease"></span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom">
                        <span class="table-sub-text">Location:</span>
                        <span class="fw-semibold table-main-text" id="mLocation"></span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom">
                        <span class="table-sub-text">Referred By:</span>
                        <div class="d-flex align-items-center gap-1">
                            <span class="fw-bold table-main-text" id="mRefName"></span>
                            <span class="pos-badge badge-pos-default ms-1" id="mRefPos"></span>
                        </div>
                    </div>
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="table-sub-text">Submission Date:</span>
                        <span class="table-sub-text small" id="mDate"></span>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Required vendors -->
    <script src="/vendor/global/global.min.js"></script>
    <script src="/vendor/bootstrap-select/dist/js/bootstrap-select.min.js"></script>
    <script src="/js/custom.js"></script>
    <script src="/js/deznav-init.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/sweetalert2/11.23.0/sweetalert2.min.js"></script>

    <script>
        // Tab switching logic
        function switchTeamTab(tabName) {
            const btnMembers = document.getElementById('tabBtnMembers');
            const btnPatients = document.getElementById('tabBtnPatients');
            const secMembers = document.getElementById('sectionMembers');
            const secPatients = document.getElementById('sectionPatients');

            if (tabName === 'members') {
                btnMembers.classList.add('active');
                btnPatients.classList.remove('active');
                secMembers.style.display = 'block';
                secPatients.style.display = 'none';
            } else {
                btnPatients.classList.add('active');
                btnMembers.classList.remove('active');
                secPatients.style.display = 'block';
                secMembers.style.display = 'none';
            }
        }

        // --- MEMBER FILTERING LOGIC ---
        let currentMemberPosFilter = 'all';

        function filterMembersByPos(pos, btn) {
            currentMemberPosFilter = pos;
            document.querySelectorAll('#memberPositionFilters .filter-pill-btn').forEach(b => b.classList.remove('active'));
            if (btn) btn.classList.add('active');
            applyMemberFilters();
        }

        function applyMemberFilters() {
            const query = (document.getElementById('memberSearchInput').value || '').toLowerCase().trim();
            const rows = document.querySelectorAll('#membersTableBody tr.member-row');
            let visibleCount = 0;

            rows.forEach(row => {
                const rowPos = (row.getAttribute('data-pos') || '').toLowerCase();
                const searchData = (row.getAttribute('data-search') || '').toLowerCase();

                let matchesPos = (currentMemberPosFilter === 'all') || 
                                 (rowPos === currentMemberPosFilter.toLowerCase()) ||
                                 (currentMemberPosFilter.toLowerCase().includes(rowPos));

                let matchesSearch = !query || searchData.includes(query);

                if (matchesPos && matchesSearch) {
                    row.style.display = '';
                    visibleCount++;
                } else {
                    row.style.display = 'none';
                }
            });

            const emptyRow = document.getElementById('emptyMemberRow');
            if (emptyRow) {
                emptyRow.style.display = (visibleCount === 0 && rows.length > 0) ? '' : (rows.length === 0 ? '' : 'none');
            }
        }

        document.getElementById('memberSearchInput').addEventListener('input', applyMemberFilters);

        // --- PATIENT FILTERING LOGIC ---
        let currentPatientPosFilter = 'all';
        let currentPatientMemberId = null;

        function filterPatientsByPos(pos, btn) {
            currentPatientPosFilter = pos;
            document.querySelectorAll('#patientPositionFilters .filter-pill-btn').forEach(b => b.classList.remove('active'));
            if (btn) btn.classList.add('active');
            applyPatientFilters();
        }

        function filterPatientsByMember(userId, name) {
            currentPatientMemberId = userId;
            switchTeamTab('patients');

            const pill = document.getElementById('activeMemberFilterPill');
            const nameEl = document.getElementById('activeMemberFilterName');
            if (pill && nameEl) {
                nameEl.textContent = name + ' (#' + userId + ')';
                pill.style.display = 'inline-flex';
            }
            applyPatientFilters();
        }

        function clearMemberPatientFilter() {
            currentPatientMemberId = null;
            const pill = document.getElementById('activeMemberFilterPill');
            if (pill) pill.style.display = 'none';
            applyPatientFilters();
        }

        function applyPatientFilters() {
            const query = (document.getElementById('patientSearchInput').value || '').toLowerCase().trim();
            const statusFilter = document.getElementById('patientStatusFilter').value;
            const rows = document.querySelectorAll('#patientsTableBody tr.patient-row');
            let visibleCount = 0;

            rows.forEach(row => {
                const refPos = (row.getAttribute('data-ref-pos') || '').toLowerCase();
                const refId = row.getAttribute('data-ref-id') || '';
                const rowStatus = row.getAttribute('data-status') || '';
                const searchData = (row.getAttribute('data-search') || '').toLowerCase();

                let matchesPos = (currentPatientPosFilter === 'all') || 
                                 (refPos === currentPatientPosFilter.toLowerCase()) ||
                                 (currentPatientPosFilter.toLowerCase().includes(refPos));

                let matchesMember = !currentPatientMemberId || (refId === currentPatientMemberId);
                let matchesStatus = (statusFilter === 'all') || (rowStatus === statusFilter);
                let matchesSearch = !query || searchData.includes(query);

                if (matchesPos && matchesMember && matchesStatus && matchesSearch) {
                    row.style.display = '';
                    visibleCount++;
                } else {
                    row.style.display = 'none';
                }
            });

            const emptyRow = document.getElementById('emptyPatientRow');
            if (emptyRow) {
                emptyRow.style.display = (visibleCount === 0 && rows.length > 0) ? '' : (rows.length === 0 ? '' : 'none');
            }
        }

        document.getElementById('patientSearchInput').addEventListener('input', applyPatientFilters);

        // Modal display helper
        function showPatientModal(regNo, name, mobile, disease, city, state, refName, refPos, dateStr) {
            document.getElementById('mRegNo').textContent = regNo || 'N/A';
            document.getElementById('mName').textContent = name || 'N/A';
            document.getElementById('mMobile').textContent = mobile || 'N/A';
            
            const mCallBtn = document.getElementById('mCallBtn');
            if (mCallBtn) {
                if (mobile && mobile !== 'N/A') {
                    mCallBtn.href = 'tel:' + mobile;
                    mCallBtn.style.display = 'inline-flex';
                } else {
                    mCallBtn.style.display = 'none';
                }
            }

            document.getElementById('mDisease').textContent = disease || 'General Care';
            document.getElementById('mLocation').textContent = (city || '') + (state ? ', ' + state : '');
            document.getElementById('mRefName').textContent = refName || 'Direct';
            document.getElementById('mRefPos').textContent = refPos || '';
            document.getElementById('mDate').textContent = dateStr ? new Date(dateStr).toLocaleString('en-IN') : '';

            new bootstrap.Modal(document.getElementById('patientQuickModal')).show();
        }

        // URL param handling on initial page load
        (function() {
            const urlParams = new URLSearchParams(window.location.search);
            const tab = urlParams.get('tab');
            if (tab === 'patients') {
                switchTeamTab('patients');
            }
            const pos = urlParams.get('position');
            if (pos) {
                const targetBtn = document.querySelector(`[data-pos="${pos}"]`);
                if (targetBtn) targetBtn.click();
            }
        })();
    </script>
</body>
</html>
