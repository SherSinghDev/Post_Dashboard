<!DOCTYPE html>
<html lang="en">

<%- include('./globals/head') %>

<body>
    <%- include('./globals/preloader') %>

    <div id="main-wrapper">
        <%- include('globals/navHeader') %>
        <%- include('globals/header') %>
        <%- include('globals/store_admin_sidebar') %>

        <div class="content-body">
            <div class="container-fluid pt-4">


                <div class="row">
                    <div class="col-12">
                        <div class="card">
                            <div class="card-header border-0 pb-0 d-flex justify-content-between align-items-center">
                                <h4 class="card-title">Product Inventory</h4>
                                <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addProductModal"><i class="fa-solid fa-plus me-1"></i> Add Product</button>
                            </div>
                            <div class="card-body">
                                <div class="table-responsive">
                                    <table class="table table-responsive-md">
                                        <thead>
                                            <tr>
                                                <th class="width80"><strong>Image</strong></th>
                                                <th><strong>Name</strong></th>
                                                <th><strong>Category</strong></th>
                                                <th><strong>Price</strong></th>
                                                <th><strong>Stock</strong></th>
                                                <th><strong>Action</strong></th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <% products.forEach(product => { %>
                                                <tr>
                                                    <td>
                                                        <% if(product.image) { %>
                                                            <img src="<%= product.image %>" class="rounded" width="45" height="45" style="object-fit: cover;">
                                                        <% } else { %>
                                                            <div class="rounded bg-light d-flex align-items-center justify-content-center" style="width: 45px; height: 45px;">
                                                                <i class="fas fa-image text-muted"></i>
                                                            </div>
                                                        <% } %>
                                                    </td>
                                                    <td><strong><%= product.name %></strong></td>
                                                    <td class="text-capitalize"><%= product.category %></td>
                                                    <td class="text-primary font-w600">₹<%= product.price %></td>
                                                    <td><span class="badge light badge-success">In Stock</span></td>
                                                    <td>
                                                        <div class="d-flex">
                                                            <a href="#" data-bs-toggle="modal" data-bs-target="#editProductModal<%= product._id %>" class="btn btn-primary shadow btn-xs sharp me-1"><i class="fas fa-pencil-alt"></i></a>
                                                            <form action="/store/admin/products/delete/<%= product._id %>" method="POST" onsubmit="return confirm('Are you sure you want to delete this product?');">
                                                                <button type="submit" class="btn btn-danger shadow btn-xs sharp"><i class="fa fa-trash"></i></button>
                                                            </form>
                                                        </div>
                                                    </td>
                                                </tr>
                                                
                                                <!-- Edit Product Modal for <%= product.name %> -->
                                                <div class="modal fade" id="editProductModal<%= product._id %>" tabindex="-1" aria-labelledby="editProductModalLabel<%= product._id %>" aria-hidden="true">
                                                    <div class="modal-dialog">
                                                        <div class="modal-content">
                                                            <form action="/store/admin/products/edit/<%= product._id %>" method="POST" enctype="multipart/form-data">
                                                                <div class="modal-header">
                                                                    <h5 class="modal-title" id="editProductModalLabel<%= product._id %>">Edit Product: <%= product.name %></h5>
                                                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                                </div>
                                                                <div class="modal-body text-start">
                                                                    <div class="mb-3">
                                                                        <label class="form-label">Product Name</label>
                                                                        <input type="text" class="form-control" name="name" value="<%= product.name %>" required>
                                                                    </div>
                                                                    <div class="mb-3">
                                                                        <label class="form-label">Category</label>
                                                                        <select class="form-select form-control category-select" name="category" onchange="handleCategoryChange(this, 'editOtherCatContainer<%= product._id %>')" required>
                                                                            <% 
                                                                                const catList = typeof categories !== 'undefined' && categories.length ? categories : ['ayurveda', 'kids', 'wellness'];
                                                                                let isProductCatInList = false;
                                                                                catList.forEach(cat => { 
                                                                                    const selected = (product.category && product.category.toLowerCase() === cat.toLowerCase());
                                                                                    if (selected) isProductCatInList = true;
                                                                            %>
                                                                                <option value="<%= cat %>" <%= selected ? 'selected' : '' %> class="text-capitalize"><%= cat.charAt(0).toUpperCase() + cat.slice(1) %></option>
                                                                            <% }); %>
                                                                            <% if (product.category && !isProductCatInList) { %>
                                                                                <option value="<%= product.category %>" selected class="text-capitalize"><%= product.category.charAt(0).toUpperCase() + product.category.slice(1) %></option>
                                                                            <% } %>
                                                                            <option value="__other__">+ Add New Category...</option>
                                                                        </select>
                                                                        <div id="editOtherCatContainer<%= product._id %>" class="mt-2" style="display: none;">
                                                                            <input type="text" class="form-control" name="otherCategory" placeholder="Enter new category name">
                                                                            <small class="text-muted">Type the custom category name</small>
                                                                        </div>
                                                                    </div>
                                                                    <div class="mb-3">
                                                                        <label class="form-label">Price (₹)</label>
                                                                        <input type="number" class="form-control" name="price" value="<%= product.price %>" required min="0" step="0.01">
                                                                    </div>
                                                                    <div class="mb-3">
                                                                        <label class="form-label">Description</label>
                                                                        <textarea class="form-control" name="description" rows="3" required><%= product.description %></textarea>
                                                                    </div>
                                                                    <div class="mb-3">
                                                                        <label class="form-label d-flex justify-content-between align-items-center">
                                                                            <span>Product Images</span>
                                                                            <button type="button" class="btn btn-outline-primary btn-xs" onclick="addMoreImageInput('editImgContainer<%= product._id %>')">
                                                                                <i class="fa fa-plus me-1"></i> Add Another Image
                                                                            </button>
                                                                        </label>

                                                                        <!-- Container for multiple image input rows -->
                                                                        <div id="editImgContainer<%= product._id %>" class="d-flex flex-column gap-2">
                                                                            <div class="input-group">
                                                                                <input type="file" class="form-control" name="images" accept="image/*" onchange="previewSelectedImage(this)">
                                                                            </div>
                                                                        </div>
                                                                        <small class="text-muted d-block mt-1">Leave blank to keep existing images, or add new images above.</small>

                                                                        <!-- Existing Images Preview -->
                                                                        <% const productImages = (product.images && product.images.length > 0) ? product.images : (product.image ? [product.image] : []); %>
                                                                        <% if(productImages.length > 0) { %>
                                                                            <div class="mt-3 p-2 bg-light rounded">
                                                                                <small class="d-block text-muted fw-bold mb-2">Current Saved Images (<%= productImages.length %>):</small>
                                                                                <div class="d-flex flex-wrap gap-2">
                                                                                    <% productImages.forEach((img, idx) => { %>
                                                                                        <div class="position-relative border bg-white rounded p-1 shadow-sm text-center">
                                                                                            <img src="<%= img %>" width="60" height="60" class="rounded" style="object-fit: cover;">
                                                                                            <% if(idx === 0) { %>
                                                                                                <span class="badge badge-xs badge-primary position-absolute top-0 start-0 m-1">Main</span>
                                                                                            <% } %>
                                                                                        </div>
                                                                                    <% }); %>
                                                                                </div>
                                                                                <div class="form-check mt-2">
                                                                                    <input class="form-check-input" type="checkbox" name="keepExistingImages" value="true" id="keepImages<%= product._id %>" checked>
                                                                                    <label class="form-check-label text-dark" for="keepImages<%= product._id %>" style="font-size: 13px;">
                                                                                        Keep existing images and add new ones (uncheck to replace all with newly selected)
                                                                                    </label>
                                                                                </div>
                                                                            </div>
                                                                        <% } %>
                                                                    </div>
                                                                </div>
                                                                <div class="modal-footer">
                                                                    <button type="button" class="btn btn-danger light" data-bs-dismiss="modal">Close</button>
                                                                    <button type="submit" class="btn btn-primary">Update Product</button>
                                                                </div>
                                                            </form>
                                                        </div>
                                                    </div>
                                                </div>

                                            <% }) %>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>

        <!-- Add Product Modal -->
        <div class="modal fade" id="addProductModal" tabindex="-1" aria-labelledby="addProductModalLabel" aria-hidden="true">
            <div class="modal-dialog">
                <div class="modal-content">
                    <form action="/store/admin/products" method="POST" enctype="multipart/form-data">
                        <div class="modal-header">
                            <h5 class="modal-title" id="addProductModalLabel">Add New Product</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body">
                            <div class="mb-3">
                                <label class="form-label">Product Name</label>
                                <input type="text" class="form-control" name="name" required>
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Category</label>
                                <select class="form-select form-control category-select" name="category" onchange="handleCategoryChange(this, 'addOtherCatContainer')" required>
                                    <option value="" disabled selected>Select category...</option>
                                    <% 
                                        const catListAdd = typeof categories !== 'undefined' && categories.length ? categories : ['ayurveda', 'kids', 'wellness'];
                                        catListAdd.forEach(cat => { 
                                    %>
                                        <option value="<%= cat %>" class="text-capitalize"><%= cat.charAt(0).toUpperCase() + cat.slice(1) %></option>
                                    <% }); %>
                                    <option value="__other__">+ Add New Category...</option>
                                </select>
                                <div id="addOtherCatContainer" class="mt-2" style="display: none;">
                                    <input type="text" class="form-control" name="otherCategory" placeholder="Enter new category name">
                                    <small class="text-muted">Type the custom category name</small>
                                </div>
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Price (₹)</label>
                                <input type="number" class="form-control" name="price" required min="0" step="0.01">
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Description</label>
                                <textarea class="form-control" name="description" rows="3" required></textarea>
                            </div>
                            <div class="mb-3">
                                <label class="form-label d-flex justify-content-between align-items-center">
                                    <span>Product Images (Main image & Gallery)</span>
                                    <button type="button" class="btn btn-outline-primary btn-xs" onclick="addMoreImageInput('addImageContainer')">
                                        <i class="fa fa-plus me-1"></i> Add Another Image
                                    </button>
                                </label>
                                
                                <!-- Multiple Image Inputs Container -->
                                <div id="addImageContainer" class="d-flex flex-column gap-2">
                                    <div class="input-group">
                                        <span class="input-group-text bg-primary text-white text-xs">Main</span>
                                        <input type="file" class="form-control" name="images" accept="image/*" required onchange="previewSelectedImage(this)">
                                    </div>
                                </div>
                                <small class="text-muted d-block mt-2">
                                    <i class="fa fa-info-circle me-1"></i> The first image is the main product display image. Click <b>"+ Add Another Image"</b> to add more image fields.
                                </small>

                                <!-- Live Thumbnails Preview Area -->
                                <div id="addImageContainer_previews" class="d-flex flex-wrap gap-2 mt-2"></div>
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-danger light" data-bs-dismiss="modal">Close</button>
                            <button type="submit" class="btn btn-primary">Save Product</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

    </div>
    
    <!-- Required Scripts for Admin Theme -->
    <script src="/vendor/global/global.min.js"></script>
    <script src="/vendor/bootstrap-select/dist/js/bootstrap-select.min.js"></script>
    <script src="/js/custom.js"></script>
    <script src="/js/deznav-init.js"></script>
    <script src="/js/demo.js"></script>
    <script src="/js/styleSwitcher.js"></script>
    <script>
        function handleCategoryChange(selectElem, containerId) {
            const container = document.getElementById(containerId);
            if (!container) return;
            const input = container.querySelector('input');
            if (selectElem.value === '__other__') {
                container.style.display = 'block';
                if (input) {
                    input.required = true;
                    input.focus();
                }
            } else {
                container.style.display = 'none';
                if (input) {
                    input.required = false;
                    input.value = '';
                }
            }
        }

        // Add extra image input row dynamically
        function addMoreImageInput(containerId) {
            const container = document.getElementById(containerId);
            if (!container) return;
            
            const row = document.createElement('div');
            row.className = 'input-group mt-2';
            row.innerHTML = `
                <span class="input-group-text bg-light text-muted text-xs">Gallery</span>
                <input type="file" class="form-control" name="images" accept="image/*" onchange="previewSelectedImage(this)">
                <button type="button" class="btn btn-danger btn-sm" onclick="removeImageInputRow(this)">
                    <i class="fa fa-times"></i>
                </button>
            `;
            container.appendChild(row);
        }

        function removeImageInputRow(btn) {
            const group = btn.closest('.input-group');
            if (group) group.remove();
        }

        function previewSelectedImage(input) {
            // When an image is selected in the initial row, automatically add another input row if it's the last one
            const parentContainer = input.closest('#addImageContainer') || input.closest('[id^="editImgContainer"]');
            if (parentContainer && input.files && input.files[0]) {
                const allFileInputs = parentContainer.querySelectorAll('input[type="file"]');
                const lastFileInput = allFileInputs[allFileInputs.length - 1];
                if (input === lastFileInput) {
                    addMoreImageInput(parentContainer.id);
                }
            }
        }
    </script>
</body>
</html>
