<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Checkout | BSRF Store</title>
    <link rel="shortcut icon" type="image/png" href="/images/logo/logo.png">
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        indigo: {
                            50: '#eef2ff',
                            100: '#e0e7ff',
                            500: '#6366f1',
                            600: '#4f46e5',
                            700: '#4338ca',
                            900: '#312e81',
                        }
                    }
                }
            }
        }
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <style>
        html, body {
            width: 100%; min-height: 100vh; margin: 0; padding: 0;
            overflow-x: hidden; font-family: 'Plus Jakarta Sans', sans-serif;
            scroll-behavior: smooth;
        }
        .transition-all { transition: all 0.3s ease; }
    </style>
</head>

<body class="bg-gray-50 dark:bg-slate-950 text-gray-900 dark:text-slate-100 transition-colors duration-300">
    <%- include('globals/store_navbar') %>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <div class="max-w-7xl mx-auto px-4 py-8 md:py-12">
        <h1 class="text-3xl md:text-4xl font-extrabold text-gray-900 dark:text-white mb-8">Secure Checkout</h1>
        
        <div class="flex flex-col lg:flex-row gap-8">
            <!-- Left Column (Forms) -->
            <div class="w-full lg:w-2/3 space-y-6">
                
                <!-- Contact Information -->
                <div class="bg-white dark:bg-slate-900 rounded-2xl shadow-sm border border-gray-100 dark:border-slate-800 p-6 md:p-8">
                    <h2 class="text-xl font-bold mb-4 flex items-center gap-2">
                        <i class="fa-regular fa-envelope text-indigo-600"></i> Contact Information
                    </h2>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <div class="space-y-2">
                            <label class="block text-sm font-medium text-gray-700 dark:text-gray-300">Full Name</label>
                            <input type="text" placeholder="John Doe" class="w-full px-4 py-3 rounded-xl bg-gray-50 dark:bg-slate-800 border border-gray-200 dark:border-slate-700 focus:ring-2 focus:ring-indigo-500 focus:border-transparent transition-all outline-none">
                        </div>
                        <div class="space-y-2">
                            <label class="block text-sm font-medium text-gray-700 dark:text-gray-300">Email Address</label>
                            <input type="email" placeholder="john@example.com" class="w-full px-4 py-3 rounded-xl bg-gray-50 dark:bg-slate-800 border border-gray-200 dark:border-slate-700 focus:ring-2 focus:ring-indigo-500 focus:border-transparent transition-all outline-none">
                        </div>
                        <div class="space-y-2 md:col-span-2">
                            <label class="block text-sm font-medium text-gray-700 dark:text-gray-300">Phone Number</label>
                            <input type="tel" placeholder="+91 XXXXX XXXXX" class="w-full px-4 py-3 rounded-xl bg-gray-50 dark:bg-slate-800 border border-gray-200 dark:border-slate-700 focus:ring-2 focus:ring-indigo-500 focus:border-transparent transition-all outline-none">
                        </div>
                    </div>
                </div>

                <!-- Shipping Address -->
                <div class="bg-white dark:bg-slate-900 rounded-2xl shadow-sm border border-gray-100 dark:border-slate-800 p-6 md:p-8">
                    <h2 class="text-xl font-bold mb-4 flex items-center gap-2">
                        <i class="fa-solid fa-map-location-dot text-indigo-600"></i> Shipping Address
                    </h2>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <div class="space-y-2 md:col-span-2">
                            <label class="block text-sm font-medium text-gray-700 dark:text-gray-300">Street Address</label>
                            <input type="text" placeholder="House no, Street name, Area" class="w-full px-4 py-3 rounded-xl bg-gray-50 dark:bg-slate-800 border border-gray-200 dark:border-slate-700 focus:ring-2 focus:ring-indigo-500 focus:border-transparent transition-all outline-none">
                        </div>
                        <div class="space-y-2">
                            <label class="block text-sm font-medium text-gray-700 dark:text-gray-300">City</label>
                            <input type="text" placeholder="Mumbai" class="w-full px-4 py-3 rounded-xl bg-gray-50 dark:bg-slate-800 border border-gray-200 dark:border-slate-700 focus:ring-2 focus:ring-indigo-500 focus:border-transparent transition-all outline-none">
                        </div>
                        <div class="space-y-2">
                            <label class="block text-sm font-medium text-gray-700 dark:text-gray-300">State</label>
                            <input type="text" placeholder="Maharashtra" class="w-full px-4 py-3 rounded-xl bg-gray-50 dark:bg-slate-800 border border-gray-200 dark:border-slate-700 focus:ring-2 focus:ring-indigo-500 focus:border-transparent transition-all outline-none">
                        </div>
                        <div class="space-y-2">
                            <label class="block text-sm font-medium text-gray-700 dark:text-gray-300">PIN Code</label>
                            <input type="text" placeholder="400001" class="w-full px-4 py-3 rounded-xl bg-gray-50 dark:bg-slate-800 border border-gray-200 dark:border-slate-700 focus:ring-2 focus:ring-indigo-500 focus:border-transparent transition-all outline-none">
                        </div>
                    </div>
                </div>

                <!-- Payment Method -->
                <div class="bg-white dark:bg-slate-900 rounded-2xl shadow-sm border border-gray-100 dark:border-slate-800 p-6 md:p-8">
                    <h2 class="text-xl font-bold mb-4 flex items-center gap-2">
                        <i class="fa-regular fa-credit-card text-indigo-600"></i> Payment Method
                    </h2>
                    <div class="space-y-3">
                        <label class="flex items-center gap-4 p-4 border border-indigo-600 rounded-xl bg-indigo-50 dark:bg-slate-800 cursor-pointer transition-all">
                            <input type="radio" name="payment" checked class="w-5 h-5 text-indigo-600">
                            <div class="flex-1">
                                <h4 class="font-bold">UPI / Credit / Debit Card</h4>
                                <p class="text-sm text-gray-500 dark:text-gray-400">Pay securely via Razorpay</p>
                            </div>
                            <div class="flex gap-2">
                                <i class="fa-brands fa-cc-visa text-2xl text-blue-800"></i>
                                <i class="fa-brands fa-cc-mastercard text-2xl text-red-600"></i>
                            </div>
                        </label>
                        <label class="flex items-center gap-4 p-4 border border-gray-200 dark:border-slate-700 rounded-xl hover:bg-gray-50 dark:hover:bg-slate-800/50 cursor-pointer transition-all">
                            <input type="radio" name="payment" class="w-5 h-5 text-indigo-600">
                            <div class="flex-1">
                                <h4 class="font-bold">Cash on Delivery</h4>
                                <p class="text-sm text-gray-500 dark:text-gray-400">Pay when your order arrives</p>
                            </div>
                            <i class="fa-solid fa-money-bill-wave text-2xl text-green-600"></i>
                        </label>
                    </div>
                </div>

            </div>

            <!-- Right Column (Order Summary) -->
            <div class="w-full lg:w-1/3">
                <div class="bg-white dark:bg-slate-900 rounded-2xl shadow-sm border border-gray-100 dark:border-slate-800 p-6 sticky top-28">
                    <h2 class="text-xl font-bold mb-6">Order Summary</h2>
                    
                    <div id="checkout-items" class="space-y-4 mb-6 max-h-60 overflow-y-auto pr-2">
                        <!-- Items populated by JS -->
                    </div>
                    
                    <div class="border-t border-gray-100 dark:border-slate-800 pt-4 space-y-3">
                        <div class="flex justify-between text-gray-600 dark:text-gray-400">
                            <span>Subtotal</span>
                            <span id="checkout-subtotal" class="font-semibold text-gray-900 dark:text-white">₹0</span>
                        </div>
                        <div class="flex justify-between text-gray-600 dark:text-gray-400">
                            <span>Shipping</span>
                            <span class="font-semibold text-green-600">Free</span>
                        </div>
                        <div class="flex justify-between text-gray-600 dark:text-gray-400">
                            <span>Tax (Included)</span>
                            <span>₹0</span>
                        </div>
                    </div>
                    
                    <div class="border-t border-gray-100 dark:border-slate-800 pt-4 mt-4 mb-6">
                        <div class="flex justify-between items-center">
                            <span class="text-lg font-bold">Total</span>
                            <span id="checkout-total" class="text-2xl font-extrabold text-indigo-600 dark:text-indigo-400">₹0</span>
                        </div>
                    </div>
                    
                    <button id="place-order-btn" class="w-full bg-indigo-600 hover:bg-indigo-700 text-white font-bold py-4 rounded-xl shadow-lg hover:shadow-indigo-500/30 transition-all transform hover:-translate-y-1 text-lg flex items-center justify-center gap-2">
                        Place Order <i class="fa-solid fa-lock text-sm"></i>
                    </button>
                    <p class="text-center text-xs text-gray-500 dark:text-gray-400 mt-4">
                        By placing this order, you agree to our Terms of Service and Privacy Policy.
                    </p>
                </div>
            </div>
        </div>
    </div>

    <!-- Scripts for Checkout -->
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const currentCart = JSON.parse(localStorage.getItem('bsrf_cart')) || [];
            const container = document.getElementById('checkout-items');
            const subtotalEl = document.getElementById('checkout-subtotal');
            const totalEl = document.getElementById('checkout-total');
            const placeOrderBtn = document.getElementById('place-order-btn');

            if (currentCart.length === 0) {
                container.innerHTML = `
                    <div class="text-center py-8">
                        <i class="fa-solid fa-cart-arrow-down text-4xl text-gray-300 mb-3"></i>
                        <p class="text-gray-500">Your cart is empty.</p>
                        <a href="/store" class="text-indigo-600 font-bold mt-2 inline-block">Return to Store</a>
                    </div>
                `;
                placeOrderBtn.disabled = true;
                placeOrderBtn.classList.add('opacity-50', 'cursor-not-allowed');
                return;
            }

            let total = 0;
            container.innerHTML = currentCart.map(item => {
                total += (item.price * item.qty);
                return `
                    <div class="flex gap-4">
                        <div class="w-16 h-16 rounded-lg bg-gray-100 dark:bg-slate-800 overflow-hidden flex-shrink-0">
                            <img src="${item.image}" class="w-full h-full object-cover">
                        </div>
                        <div class="flex-1">
                            <h4 class="font-bold text-sm text-gray-900 dark:text-white line-clamp-2">${item.name}</h4>
                            <div class="text-xs text-gray-500 dark:text-gray-400 mt-1">Qty: ${item.qty}</div>
                        </div>
                        <div class="font-bold text-sm">₹${item.price * item.qty}</div>
                    </div>
                `;
            }).join('');

            subtotalEl.textContent = `₹${total}`;
            totalEl.textContent = `₹${total}`;

            placeOrderBtn.addEventListener('click', () => {
                Swal.fire({
                    title: 'Processing Order...',
                    text: 'Please wait while we securely process your payment.',
                    allowOutsideClick: false,
                    didOpen: () => {
                        Swal.showLoading();
                        setTimeout(() => {
                            localStorage.removeItem('bsrf_cart'); // Clear cart
                            Swal.fire({
                                icon: 'success',
                                title: 'Order Confirmed!',
                                text: 'Thank you for shopping with BSRF Store.',
                                confirmButtonColor: '#4f46e5',
                                confirmButtonText: 'Continue Shopping'
                            }).then(() => {
                                window.location.href = '/store';
                            });
                        }, 2000);
                    }
                });
            });
        });
    </script>
</body>
</html>
