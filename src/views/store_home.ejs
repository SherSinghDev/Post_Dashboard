<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>BSRF Store - Premium Products</title>
    <link rel="shortcut icon" type="image/png" href="/images/logo/logo.png">
    <!-- Load Tailwind CSS CDN for modern styling -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        indigo: {
                            50: '#eef2ff',
                            100: '#e0e7ff',
                            500: '#6366f1',
                            600: '#4f46e5',
                            700: '#4338ca',
                            900: '#312e81',
                        }
                    }
                }
            }
        }
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
        rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <style>
        html,
        body {
            width: 100%;
            min-height: 100vh;
            margin: 0;
            padding: 0;
            overflow-x: hidden;
            font-family: 'Plus Jakarta Sans', sans-serif;
            scroll-behavior: smooth;
        }

        .transition-all {
            transition: all 0.3s ease;
        }
        
        .product-card:hover .product-img {
            transform: scale(1.05);
        }
    </style>
</head>

<body class="bg-gray-50 dark:bg-slate-950 text-gray-900 dark:text-slate-100 transition-colors duration-300">
    <!-- Navbar Section -->
    <%- include('globals/store_navbar') %>
    <!-- SweetAlert for nice toast notifications -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <!-- Hero Section -->
    <div class="relative w-full h-[400px] overflow-hidden flex items-center justify-center bg-gradient-to-r from-indigo-900 to-indigo-700 dark:from-slate-900 dark:to-indigo-900">
        <div class="absolute inset-0 bg-black/40 z-10"></div>
        <img src="https://picsum.photos/seed/bsrf_store_hero/2000/800" class="absolute inset-0 w-full h-full object-cover mix-blend-overlay" alt="Store Hero">
        <div class="relative z-20 text-center px-4 max-w-4xl mx-auto">
            <span class="inline-block py-1 px-3 rounded-full bg-indigo-500/30 text-indigo-100 font-bold tracking-wider uppercase text-xs mb-4 backdrop-blur-sm border border-indigo-400/30">BSRF Official Store</span>
            <h1 class="text-4xl md:text-6xl font-extrabold text-white mb-6 drop-shadow-lg">Discover Premium Quality</h1>
            <p class="text-lg md:text-xl text-indigo-50 mb-8 max-w-2xl mx-auto drop-shadow-md">Explore our curated collection of authentic Ayurveda and delightful Kids products, designed for your well-being.</p>
        </div>
    </div>

    <!-- Store Main Content -->
    <div class="max-w-7xl mx-auto px-4 py-12 md:py-16">
        
        <!-- Category Filter -->
        <div class="flex flex-col md:flex-row justify-between items-center mb-10 gap-4">
            <h2 class="text-2xl md:text-3xl font-bold">Our Products</h2>
            
            <div class="flex bg-white dark:bg-slate-900 p-1 rounded-xl shadow-sm border border-gray-200 dark:border-slate-800">
                <a href="/store?category=all" class="px-4 py-2 rounded-lg text-sm font-semibold transition-all <%= currentCategory === 'all' ? 'bg-indigo-600 text-white shadow-md' : 'text-gray-600 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-slate-800' %>">
                    All Products
                </a>
                <a href="/store?category=ayurveda" class="px-4 py-2 rounded-lg text-sm font-semibold transition-all <%= currentCategory === 'ayurveda' ? 'bg-indigo-600 text-white shadow-md' : 'text-gray-600 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-slate-800' %>">
                    Ayurveda
                </a>
                <a href="/store?category=kids" class="px-4 py-2 rounded-lg text-sm font-semibold transition-all <%= currentCategory === 'kids' ? 'bg-indigo-600 text-white shadow-md' : 'text-gray-600 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-slate-800' %>">
                    Kids Section
                </a>
            </div>
        </div>

        <!-- Products Grid -->
        <% if (products && products.length > 0) { %>
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6 md:gap-8">
                <% products.forEach(product => { %>
                    <div class="product-card group bg-white dark:bg-slate-900 rounded-2xl overflow-hidden shadow-sm hover:shadow-xl border border-gray-100 dark:border-slate-800 transition-all duration-300 flex flex-col">
                        <a href="/store/products/<%= product._id %>" class="block relative aspect-square overflow-hidden bg-gray-100 dark:bg-slate-800">
                            <!-- Category Badge -->
                            <div class="absolute top-3 right-3 z-10">
                                <% if (product.category === 'ayurveda') { %>
                                    <span class="bg-green-100 text-green-700 text-xs font-bold px-2 py-1 rounded-md shadow-sm">Ayurveda</span>
                                <% } else if (product.category === 'kids') { %>
                                    <span class="bg-blue-100 text-blue-700 text-xs font-bold px-2 py-1 rounded-md shadow-sm">Kids</span>
                                <% } %>
                            </div>
                            <img src="<%= product.image %>" alt="<%= product.name %>" class="product-img w-full h-full object-cover transition-transform duration-500">
                        </a>
                        
                        <div class="p-5 flex-1 flex flex-col">
                            <div class="flex justify-between items-start mb-2">
                                <a href="/store/products/<%= product._id %>" class="flex-1">
                                    <h3 class="text-lg font-bold text-gray-900 dark:text-white group-hover:text-indigo-600 dark:group-hover:text-indigo-400 transition-colors line-clamp-1"><%= product.name %></h3>
                                </a>
                                <button data-id="<%= product._id %>" onclick="toggleFavourite('<%= product._id %>', '<%= product.name.replace(/'/g, "\\'") %>', <%= product.price %>, '<%= product.image %>')" class="fav-btn text-gray-400 hover:text-red-500 transition-colors ml-2">
                                    <i class="fa-regular fa-heart text-xl"></i>
                                </button>
                            </div>
                            
                            <!-- Rating -->
                            <div class="flex items-center gap-1 mb-3 text-sm">
                                <div class="text-yellow-400 flex text-xs">
                                    <i class="fa-solid fa-star"></i>
                                    <i class="fa-solid fa-star"></i>
                                    <i class="fa-solid fa-star"></i>
                                    <i class="fa-solid fa-star"></i>
                                    <i class="fa-solid fa-star-half-stroke"></i>
                                </div>
                                <span class="text-gray-500 dark:text-gray-400 text-xs font-medium">(<%= product.rating %> • <%= product.reviews %> reviews)</span>
                            </div>
                            
                            <p class="text-gray-600 dark:text-gray-400 text-sm mb-4 line-clamp-2 flex-1"><%= product.description %></p>
                            
                            <div class="flex items-center justify-between mt-auto pt-4 border-t border-gray-100 dark:border-slate-800">
                                <span class="text-xl font-extrabold text-gray-900 dark:text-white">₹<%= product.price %></span>
                                <button onclick="addToCart('<%= product._id %>', '<%= product.name.replace(/'/g, "\\'") %>', <%= product.price %>, '<%= product.image %>')" class="px-4 py-2 rounded-xl bg-indigo-600 text-white hover:bg-indigo-700 font-bold text-sm flex items-center gap-2 transition-all shadow-md">
                                    <i class="fa-solid fa-cart-plus"></i> Add
                                </button>
                            </div>
                        </div>
                    </div>
                <% }) %>
            </div>
        <% } else { %>
            <div class="text-center py-20 bg-white dark:bg-slate-900 rounded-2xl border border-gray-100 dark:border-slate-800 shadow-sm">
                <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-gray-100 dark:bg-slate-800 text-gray-400 dark:text-gray-500 mb-4">
                    <i class="fa-solid fa-box-open text-2xl"></i>
                </div>
                <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-2">No Products Found</h3>
                <p class="text-gray-500 dark:text-gray-400 max-w-md mx-auto">We couldn't find any products in this category at the moment. Please check back later.</p>
                <a href="/store?category=all" class="inline-block mt-6 px-6 py-2 bg-indigo-600 hover:bg-indigo-700 text-white rounded-xl font-semibold shadow-md transition-all">View All Products</a>
            </div>
        <% } %>
    </div>

    <!-- Features Section -->
    <div class="bg-white dark:bg-slate-900 border-t border-gray-100 dark:border-slate-800">
        <div class="max-w-7xl mx-auto px-4 py-12">
            <div class="grid grid-cols-1 md:grid-cols-3 gap-8 text-center">
                <div class="p-4">
                    <div class="w-12 h-12 mx-auto bg-indigo-50 dark:bg-slate-800 text-indigo-600 dark:text-indigo-400 rounded-full flex items-center justify-center text-xl mb-4">
                        <i class="fa-solid fa-truck-fast"></i>
                    </div>
                    <h4 class="text-lg font-bold mb-2">Fast Delivery</h4>
                    <p class="text-sm text-gray-500 dark:text-gray-400">Nationwide fast delivery on all your orders.</p>
                </div>
                <div class="p-4">
                    <div class="w-12 h-12 mx-auto bg-indigo-50 dark:bg-slate-800 text-indigo-600 dark:text-indigo-400 rounded-full flex items-center justify-center text-xl mb-4">
                        <i class="fa-solid fa-leaf"></i>
                    </div>
                    <h4 class="text-lg font-bold mb-2">Authentic Products</h4>
                    <p class="text-sm text-gray-500 dark:text-gray-400">100% genuine and certified ayurvedic items.</p>
                </div>
                <div class="p-4">
                    <div class="w-12 h-12 mx-auto bg-indigo-50 dark:bg-slate-800 text-indigo-600 dark:text-indigo-400 rounded-full flex items-center justify-center text-xl mb-4">
                        <i class="fa-solid fa-shield-halved"></i>
                    </div>
                    <h4 class="text-lg font-bold mb-2">Secure Payment</h4>
                    <p class="text-sm text-gray-500 dark:text-gray-400">Multiple secure payment options available.</p>
                </div>
            </div>
        </div>
    </div>

</body>
</html>
