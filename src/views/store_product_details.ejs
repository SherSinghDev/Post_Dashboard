<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= product.name %> | BSRF Store</title>
    <link rel="shortcut icon" type="image/png" href="/images/logo/logo.png">
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        indigo: {
                            50: '#eef2ff',
                            100: '#e0e7ff',
                            500: '#6366f1',
                            600: '#4f46e5',
                            700: '#4338ca',
                            900: '#312e81',
                        }
                    }
                }
            }
        }
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <style>
        html, body {
            width: 100%; min-height: 100vh; margin: 0; padding: 0;
            overflow-x: hidden; font-family: 'Plus Jakarta Sans', sans-serif;
            scroll-behavior: smooth;
        }
        .transition-all { transition: all 0.3s ease; }
    </style>
</head>

<body class="bg-gray-50 dark:bg-slate-950 text-gray-900 dark:text-slate-100 transition-colors duration-300">
    <%- include('globals/store_navbar') %>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <!-- Breadcrumb -->
    <div class="max-w-7xl mx-auto px-4 py-6">
        <nav class="flex text-sm text-gray-500 dark:text-gray-400 font-medium" aria-label="Breadcrumb">
            <ol class="inline-flex items-center space-x-1 md:space-x-3">
                <li class="inline-flex items-center">
                    <a href="/store" class="hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors">Store</a>
                </li>
                <li>
                    <div class="flex items-center">
                        <i class="fa-solid fa-chevron-right text-xs mx-2"></i>
                        <a href="/store?category=<%= product.category %>" class="capitalize hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors">
                            <%= product.category %>
                        </a>
                    </div>
                </li>
                <li aria-current="page">
                    <div class="flex items-center">
                        <i class="fa-solid fa-chevron-right text-xs mx-2"></i>
                        <span class="text-gray-900 dark:text-white"><%= product.name %></span>
                    </div>
                </li>
            </ol>
        </nav>
    </div>

    <!-- Product Details Section -->
    <div class="max-w-7xl mx-auto px-4 pb-16">
        <div class="bg-white dark:bg-slate-900 rounded-3xl p-6 md:p-10 shadow-sm border border-gray-100 dark:border-slate-800">
            <div class="flex flex-col lg:flex-row gap-10 lg:gap-16">
                <!-- Product Image Gallery -->
                <div class="w-full lg:w-1/2">
                    <div class="aspect-square rounded-2xl overflow-hidden bg-gray-100 dark:bg-slate-800 relative group">
                        <!-- Category Badge -->
                        <div class="absolute top-4 left-4 z-10">
                            <% if (product.category === 'ayurveda') { %>
                                <span class="bg-green-100 text-green-700 text-sm font-bold px-3 py-1 rounded-lg shadow-sm">Ayurveda</span>
                            <% } else if (product.category === 'kids') { %>
                                <span class="bg-blue-100 text-blue-700 text-sm font-bold px-3 py-1 rounded-lg shadow-sm">Kids</span>
                            <% } %>
                        </div>
                        <img src="<%= product.image %>" alt="<%= product.name %>" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105">
                    </div>
                    
                    <!-- Thumbnails mock -->
                    <div class="grid grid-cols-4 gap-4 mt-4">
                        <div class="aspect-square rounded-xl overflow-hidden border-2 border-indigo-600 cursor-pointer">
                            <img src="<%= product.image %>" class="w-full h-full object-cover">
                        </div>
                        <div class="aspect-square rounded-xl overflow-hidden border border-transparent hover:border-gray-300 dark:hover:border-slate-600 opacity-60 hover:opacity-100 transition-all cursor-pointer bg-gray-100 dark:bg-slate-800">
                             <img src="<%= product.image %>" class="w-full h-full object-cover grayscale">
                        </div>
                        <div class="aspect-square rounded-xl overflow-hidden border border-transparent hover:border-gray-300 dark:hover:border-slate-600 opacity-60 hover:opacity-100 transition-all cursor-pointer bg-gray-100 dark:bg-slate-800">
                             <img src="<%= product.image %>" class="w-full h-full object-cover grayscale">
                        </div>
                    </div>
                </div>

                <!-- Product Info -->
                <div class="w-full lg:w-1/2 flex flex-col justify-center">
                    <h1 class="text-3xl md:text-5xl font-extrabold text-gray-900 dark:text-white mb-4 leading-tight"><%= product.name %></h1>
                    
                    <!-- Rating & Reviews -->
                    <div class="flex items-center gap-3 mb-6">
                        <div class="text-yellow-400 flex text-lg">
                            <i class="fa-solid fa-star"></i>
                            <i class="fa-solid fa-star"></i>
                            <i class="fa-solid fa-star"></i>
                            <i class="fa-solid fa-star"></i>
                            <i class="fa-solid fa-star-half-stroke"></i>
                        </div>
                        <div class="flex items-center text-sm">
                            <span class="font-bold text-gray-900 dark:text-white mr-1"><%= product.rating %></span>
                            <span class="text-gray-500 dark:text-gray-400">(<%= product.reviews %> verified reviews)</span>
                        </div>
                    </div>
                    
                    <!-- Price -->
                    <div class="mb-8 flex items-baseline gap-3">
                        <span class="text-4xl md:text-5xl font-extrabold text-indigo-600 dark:text-indigo-400">₹<%= product.price %></span>
                        <span class="text-lg text-gray-400 dark:text-gray-500 line-through font-medium">₹<%= Math.round(product.price * 1.3) %></span>
                        <span class="bg-red-100 text-red-600 text-xs font-bold px-2 py-1 rounded-md ml-2">Save 30%</span>
                    </div>
                    
                    <div class="border-t border-b border-gray-100 dark:border-slate-800 py-6 mb-8">
                        <h3 class="text-lg font-bold mb-3">Product Description</h3>
                        <p class="text-gray-600 dark:text-gray-300 leading-relaxed text-lg">
                            <%= product.description %>
                            Experience the premium quality and carefully crafted formulation designed to meet the highest standards. Perfect for regular use and highly recommended by our community.
                        </p>
                    </div>
                    
                    <!-- Actions -->
                    <div class="flex flex-col sm:flex-row gap-4 mb-8">
                        <!-- Quantity -->
                        <div class="flex items-center border border-gray-200 dark:border-slate-700 rounded-xl bg-gray-50 dark:bg-slate-800/50 h-14 px-2 w-full sm:w-32">
                            <button onclick="const el=document.getElementById('qty'); el.value = Math.max(1, parseInt(el.value) - 1);" class="w-10 h-10 flex items-center justify-center text-gray-500 hover:text-indigo-600 transition-colors">
                                <i class="fa-solid fa-minus"></i>
                            </button>
                            <input type="number" id="qty" value="1" min="1" class="w-full h-full bg-transparent text-center font-bold text-lg border-none focus:outline-none dark:text-white" readonly>
                            <button onclick="const el=document.getElementById('qty'); el.value = parseInt(el.value) + 1;" class="w-10 h-10 flex items-center justify-center text-gray-500 hover:text-indigo-600 transition-colors">
                                <i class="fa-solid fa-plus"></i>
                            </button>
                        </div>
                        
                        <button onclick="addToCart(<%= product.id %>, '<%= product.name.replace(/'/g, "\\'") %>', <%= product.price %>, '<%= product.image %>', parseInt(document.getElementById('qty').value))" class="flex-1 bg-indigo-600 hover:bg-indigo-700 text-white rounded-xl h-14 font-bold text-lg shadow-lg hover:shadow-indigo-500/30 transition-all transform hover:-translate-y-1 flex items-center justify-center gap-2">
                            <i class="fa-solid fa-cart-shopping"></i> Add to Cart
                        </button>
                        
                        <button data-id="<%= product.id %>" onclick="toggleFavourite(<%= product.id %>, '<%= product.name.replace(/'/g, "\\'") %>', <%= product.price %>, '<%= product.image %>')" class="fav-btn w-14 h-14 rounded-xl border border-gray-200 dark:border-slate-700 flex items-center justify-center text-gray-400 hover:text-red-500 hover:border-red-500 hover:bg-red-50 transition-all">
                            <i class="fa-regular fa-heart text-xl"></i>
                        </button>
                    </div>

                    <!-- Features -->
                    <div class="grid grid-cols-2 gap-4 text-sm font-medium text-gray-600 dark:text-gray-400 bg-gray-50 dark:bg-slate-800/50 p-4 rounded-xl">
                        <div class="flex items-center gap-2">
                            <i class="fa-solid fa-truck text-indigo-500"></i> Free Delivery
                        </div>
                        <div class="flex items-center gap-2">
                            <i class="fa-solid fa-box text-indigo-500"></i> 7 Days Return
                        </div>
                        <div class="flex items-center gap-2">
                            <i class="fa-solid fa-shield-halved text-indigo-500"></i> Quality Assured
                        </div>
                        <div class="flex items-center gap-2">
                            <i class="fa-solid fa-leaf text-indigo-500"></i> 100% Genuine
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Related Products -->
    <% if (relatedProducts && relatedProducts.length > 0) { %>
    <div class="max-w-7xl mx-auto px-4 pb-20">
        <h2 class="text-2xl md:text-3xl font-bold mb-8">Related Products</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
            <% relatedProducts.forEach(relProduct => { %>
                <div class="product-card group bg-white dark:bg-slate-900 rounded-2xl overflow-hidden shadow-sm hover:shadow-xl border border-gray-100 dark:border-slate-800 transition-all duration-300 flex flex-col">
                    <a href="/store/products/<%= relProduct.id %>" class="block relative aspect-square overflow-hidden bg-gray-100 dark:bg-slate-800">
                        <img src="<%= relProduct.image %>" alt="<%= relProduct.name %>" class="product-img w-full h-full object-cover transition-transform duration-500">
                    </a>
                    <div class="p-5 flex-1 flex flex-col">
                        <a href="/store/products/<%= relProduct.id %>">
                            <h3 class="text-lg font-bold text-gray-900 dark:text-white group-hover:text-indigo-600 transition-colors line-clamp-1 mb-2"><%= relProduct.name %></h3>
                        </a>
                        <div class="flex items-center justify-between mt-auto">
                            <span class="text-lg font-extrabold">₹<%= relProduct.price %></span>
                        </div>
                    </div>
                </div>
            <% }) %>
        </div>
    </div>
    <% } %>

</body>
</html>
