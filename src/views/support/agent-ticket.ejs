<!DOCTYPE html>
<html>

<head>
  <title>Handle Ticket</title>
  <!-- <link rel="stylesheet" href="/css/support.css"> -->
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      font-family: 'Inter', 'Segoe UI', sans-serif;
    }

    body {
      background: linear-gradient(135deg, #ffe3ef, #fff6fa);
      color: #333;
      padding: 60px 16px;
    }

    button {
      width: 100%;
      padding: 14px;
      border-radius: 12px;
      border: none;
      background: linear-gradient(135deg, #d81b60, #ec407a);
      color: #fff;
      font-size: 15px;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.25s ease;
      box-shadow: 0 6px 16px rgba(216, 27, 96, 0.35);
    }

    button:hover {
      transform: translateY(-2px);
      box-shadow: 0 10px 22px rgba(216, 27, 96, 0.45);
    }

    button:active {
      transform: scale(0.98);
    }


    /* =========================
   TICKET CARD
========================= */
    .ticket-card {
      background: #fff7fb;
      border: 1px solid #ffd1e3;
      border-radius: 14px;
      padding: 16px;
      margin-bottom: 20px;
      font-size: 14px;
      line-height: 1.7;
    }

    .ticket-card b {
      color: #d81b60;
      font-weight: 600;
    }

    /* =========================
   FORM STYLES
========================= */
    form {
      margin-top: 18px;
    }

    label {
      display: block;
      font-size: 13px;
      font-weight: 600;
      color: #555;
      margin-bottom: 6px;
    }

    select,
    input[type="number"],
    textarea {
      width: 100%;
      padding: 12px;
      border-radius: 10px;
      border: 1px solid #ddd;
      font-size: 14px;
      outline: none;
      transition: border 0.2s ease, box-shadow 0.2s ease;
    }

    select:focus,
    input:focus,
    textarea:focus {
      border-color: #d81b60;
      box-shadow: 0 0 0 3px rgba(216, 27, 96, 0.15);
    }

    /* =========================
   TEXTAREA
========================= */
    textarea {
      resize: none;
      min-height: 90px;
    }

    /* =========================
   BUTTON SPACING
========================= */
    form button {
      margin-top: 14px;
    }

    /* =========================
   SECONDARY ACTION
========================= */
    form+form {
      margin-top: 22px;
      padding-top: 16px;
      border-top: 1px dashed #ffd1e3;
    }

    /* =========================
   USER DETAILS HIGHLIGHT
========================= */
    .ticket-card .user-info {
      margin-top: 10px;
      padding-top: 10px;
      border-top: 1px dashed #ffd1e3;
    }

    /* =========================
   STATUS COLORS (Optional)
========================= */
    .status {
      font-weight: 600;
      padding: 4px 10px;
      border-radius: 999px;
      font-size: 12px;
    }

    .status.calling {
      background: #fff3e0;
      color: #ef6c00;
    }

    .status.inprogress {
      background: #e3f2fd;
      color: #1565c0;
    }

    .status.resolved {
      background: #e8f5e9;
      color: #2e7d32;
    }

    .support-wrapper {
      max-width: 520px;
      margin: 0 auto;
      background: #ffffff;
      border-radius: 18px;
      padding: 28px;
      box-shadow: 0 18px 45px rgba(216, 27, 96, 0.15);
    }

    .support-header {
      text-align: center;
      margin-bottom: 24px;
    }

    .support-header h1 {
      font-size: 22px;
      color: #d81b60;
    }

    /* =========================
   TABLET
========================= */
    @media (max-width: 1024px) {
      body {
        padding: 40px 20px;
      }

      .support-wrapper {
        max-width: 600px;
      }
    }

    /* =========================
   MOBILE
========================= */
    @media (max-width: 480px) {
      body {
        padding: 20px 12px;
      }

      .support-wrapper {
        padding: 20px 16px;
        border-radius: 14px;
      }

      .support-header h1 {
        font-size: 20px;
      }

      .ticket-card {
        font-size: 13px;
        padding: 14px;
      }

      label {
        font-size: 12px;
      }

      select,
      input[type="number"],
      textarea {
        font-size: 13px;
        padding: 10px;
      }

      button {
        padding: 12px;
        font-size: 14px;
      }
    }

    .ticket-card {
      word-wrap: break-word;
      overflow-wrap: break-word;
    }
  </style>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/sweetalert2/11.23.0/sweetalert2.min.css">

</head>

<body>

  <div class="support-wrapper">

    <div class="support-header">
      <h1>📞 Ticket Handling</h1>
    </div>

    <div class="ticket-card">
      <b>Category:</b>
      <%= ticket.category %><br>
        <b>Parcel ID:</b>
        <%= ticket.parcelId || 'N/A' %><br>
          <b>Issue:</b>
          <%= ticket.issueSummary %><br>

            <div class="user-info">
              <b>User Name:</b>
              <%= user.name %><br>
                
                  <b>Mobile:</b>
                  <%= user.mobile %>
            </div>
    </div>


    <form action="/support/support/log-call/<%= ticket._id %>" method="POST" id="call-log">
      <label>Call Outcome</label>
      <select name="outcome">
        <option value="CONNECTED">Connected</option>
        <option value="NO_ANSWER">No Answer</option>
        <option value="BUSY">Busy</option>
      </select>
      <br>

      <label>Call Duration (seconds)</label>
      <input type="number" name="duration">
      <br>

      <button type="submit">Save Call Log</button>
    </form>

    <form action="/support/support/resolve/<%= ticket._id %>" id="resolve-form" method="POST">
      <label>Resolution Note</label>
      <textarea name="resolutionNote" required></textarea>
      <br>

      <button type="submit">Resolve Ticket</button>
    </form>

  </div>



  <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/sweetalert2/11.23.0/sweetalert2.min.js"></script>
  <script>
    $(document).on('submit', '#call-log', function (e) {
      e.preventDefault()
      let form = this
      let {
        outcome,
        duration
      } = form

      let inputs = {
        outcome,
        duration
      }


      let err = []

      for (let key in inputs) {
        if (!inputs[key].value) {
          let text = inputs[key].previousElementSibling?.innerText
          err.push(text)
        }
      }

      if (err.length > 0) {
        Swal.fire({
          icon: "error",
          title: "Oops...",
          html: err.join('<br>'),
        });
      }
      else {
        let data = {
          outcome: form.outcome.value,
          duration: form.duration.value
        }

        fetch(`/support/support/log-call/<%= ticket._id %>`, {
          method: "POST",
          body: JSON.stringify(data),
          // body: new FormData(e.target),
          headers: {
            "Content-Type": "application/json"
          },
        })
          .then((data) => {
            return data.json()
          })
          .then((result) => {
            console.log(result);
            if (result.success) {
              Swal.fire({
                title: "Success!",
                icon: "success",
                text: "Call Log Updated!",
                timer: 2000

              });

              for (let key in inputs) {
                inputs[key].setAttribute('disabled', 'true')
              }
            }
            else {

              Swal.fire({
                icon: "error",
                title: "Oops...",
                text: result.error,
                // timer: 1000
              });
            }
          })
          .catch((err) => {
            console.log(err);
          })
      }
    });

    $(document).on('submit', '#resolve-form', function (e) {
      e.preventDefault()
      let form = this
      let {
        resolutionNote,
      } = form

      let inputs = {
        resolutionNote
      }


      let err = []

      for (let key in inputs) {
        if (!inputs[key].value) {
          let text = inputs[key].previousElementSibling?.innerText
          err.push(text)
        }
      }

      if (err.length > 0) {
        Swal.fire({
          icon: "error",
          title: "Oops...",
          html: err.join('<br>'),
        });
      }
      else {
        let data = {
          resolutionNote:form.resolutionNote.value
          
        }

        fetch(`/support/support/resolve/<%= ticket._id %>`, {
          method: "POST",
          body: JSON.stringify(data),
          // body: new FormData(e.target),
          headers: {
            "Content-Type": "application/json"
          },
        })
          .then((data) => {
            return data.json()
          })
          .then((result) => {
            console.log(result);
            if (result.success) {
              Swal.fire({
                title: "Success!",
                icon: "success",
                text: "Resolve Message Submitted!",
                timer: 2000

              });

              for (let key in inputs) {
                inputs[key].setAttribute('disabled', 'true')
              }

              window.location.href = '/support/dashboard'
            }
            else {

              Swal.fire({
                icon: "error",
                title: "Oops...",
                text: result.error,
                // timer: 1000
              });
            }
          })
          .catch((err) => {
            console.log(err);
          })
      }
    });


  </script>
</body>

</html>