<!DOCTYPE html>
<html lang="en">
<%- include('./globals/head') %>

<body>

    <!--*******************
        Preloader start
    ********************-->
    <%- include('./globals/preloader') %>
    <!--*******************
        Preloader end
    ********************-->

    <!--**********************************
        Main wrapper start
    ***********************************-->
    <div id="main-wrapper">
        <!--**********************************
            Nav header start
        ***********************************-->
        <%- include('globals/navHeader') %>
        <!--**********************************
            Nav header end
        ***********************************-->

        <!--**********************************
            Header start
        ***********************************-->
        <%- include('globals/header') %>
        <!--**********************************
            Header end ti-comment-alt
        ***********************************-->

        <!--**********************************
            Sidebar start
        ***********************************-->
        <%- include('globals/sidebar') %>

        <!--**********************************
            Sidebar end
        ***********************************-->

        <!--**********************************
            Content body start
        ***********************************-->
        <div class="content-body">
            <div class="container">
                <div class="d-flex justify-content-between mb-4 flex-wrap">
                    <div class="input-group w-auto mb-2 mb-xxl-0">
                        <input type="text" placeholder="Search by name, phone, or spec..." class="form-control search-input" style="width: 300px;">
                    </div>
                    <div class="text-end">
                        <a href="/teleconsult" target="_blank" class="btn btn-primary me-1 add-btn">+ New Booking</a>
                    </div>
                </div>

                <div class="row">
                    <div class="col-xl-12">
                        <div class="card mt-2">
                            <div class="card-body">
                                <div class="table-responsive text-center">
                                    <table class="table table-striped align-middle main-table">
                                        <thead>
                                            <tr>
                                                <th>Booking Date</th>
                                                <th>Time Slot</th>
                                                <th>Patient Name</th>
                                                <th>Phone</th>
                                                <th>Speciality</th>
                                                <th>Age / Gender</th>
                                                <th>Submission Date</th>
                                                <th>Status</th>
                                                <th>Actions</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <% if (bookings && bookings.length > 0) { %>
                                                <% bookings.forEach((booking) => { %>
                                                    <tr id="tr-<%= booking._id %>">
                                                        <td>
                                                            <span class="badge badge-info"><%= booking.bookingDate %></span>
                                                        </td>
                                                        <td>
                                                            <%= booking.hours %>:<%= booking.minutes %> <%= booking.meridian %>
                                                        </td>
                                                        <td>
                                                            <%= booking.firstName %> <%= booking.lastName %>
                                                        </td>
                                                        <td>
                                                            <%= booking.phone %>
                                                        </td>
                                                        <td>
                                                            <%= booking.speciality %>
                                                        </td>
                                                        <td>
                                                            <%= booking.age %> / <%= booking.gender %>
                                                        </td>
                                                        <td>
                                                            <%= new Date(booking.createdAt).toLocaleDateString() %>
                                                        </td>
                                                        <td>
                                                            <% if(booking.status === 'Verified') { %>
                                                                <span class="badge badge-success">Verified</span>
                                                            <% } else { %>
                                                                <span class="badge badge-danger">Unverified</span>
                                                            <% } %>
                                                        </td>
                                                        <td>
                                                            <a href="javascript:void(0)" data-id="<%= booking._id %>" class="btn btn-sm btn-success edit-btn"><i class="fa-solid fa-pen"></i></a>
                                                            <a href="javascript:void(0)" data-id="<%= booking._id %>" class="btn btn-sm btn-danger delete-btn">
                                                                <i class="fa-solid fa-trash"></i>
                                                            </a>
                                                        </td>
                                                    </tr>
                                                <% }) %>
                                            <% } else { %>
                                                <tr>
                                                    <td colspan="9" class="text-center text-muted">
                                                        No Teleconsult Bookings found
                                                    </td>
                                                </tr>
                                            <% } %>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>
        <!--**********************************
            Content body end
        ***********************************-->

    </div>
    <!--**********************************
        Main wrapper end
    ***********************************-->

    <!-- Edit Modal -->
    <div class="modal fade edit-modal bd-example-modal-xl" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Edit Booking & Verification</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <form id="edit-form">
                        <input type="hidden" name="bookingId" id="editBookingId">

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label class="mb-1"><strong>First Name</strong></label>
                                <input type="text" name="firstName" id="editFirstName" class="form-control">
                            </div>
                            <div class="col-md-6">
                                <label class="mb-1"><strong>Last Name</strong></label>
                                <input type="text" name="lastName" id="editLastName" class="form-control">
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label class="mb-1"><strong>Phone Number</strong></label>
                                <input type="text" name="phone" id="editPhone" class="form-control">
                            </div>
                            <div class="col-md-6">
                                <label class="mb-1"><strong>Speciality</strong></label>
                                <input type="text" name="speciality" id="editSpeciality" class="form-control">
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label class="mb-1"><strong>Verification Status</strong></label>
                                <select name="status" id="editStatus" class="form-control form-select">
                                    <option value="Unverified">Unverified</option>
                                    <option value="Verified">Verified</option>
                                </select>
                            </div>
                        </div>

                        <div class="text-center mt-4">
                            <button type="submit" class="btn btn-primary btn-block">Update Booking</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
    <!--**********************************
        Main wrapper end
    ***********************************-->

    <!--**********************************
        Scripts
    ***********************************-->
    <!-- Required vendors -->
    <script src="/vendor/global/global.min.js"></script>
    <script src="/vendor/bootstrap-select/dist/js/bootstrap-select.min.js"></script>

    <!-- Dashboard 1 -->
    <script src="/vendor/datatables/js/jquery.dataTables.min.js"></script>
    <script src="/js/plugins-init/datatables.init.js"></script>

    <script src="/js/custom.js"></script>
    <script src="/js/deznav-init.js"></script>
    <script src="/js/styleSwitcher.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/sweetalert2/11.23.0/sweetalert2.min.js"></script>
    
    <script>
        // 🔍 Search filter
        $(document).on('keyup', '.search-input', function () {
            const value = $(this).val().toLowerCase();
            $('tbody tr').filter(function () {
                $(this).toggle($(this).text().toLowerCase().indexOf(value) > -1);
            });
        });

        // Delete
        $(document).on('click', '.delete-btn', function () {
            Swal.fire({
                title: "Do you want to delete this booking?",
                showDenyButton: true,
                confirmButtonText: "Delete",
                denyButtonText: `Cancel`
            }).then((result) => {
                if (result.isConfirmed) {
                    let id = $(this).attr('data-id');
                    $.ajax({
                        url: `/teleconsult/admin/delete/${id}`,
                        method: "POST",
                        success: function (data) {
                            if (data.success) {
                                Swal.fire({
                                    title: "Success!",
                                    icon: "success",
                                    text: "Deleted Successfully",
                                    timer: 1500
                                });
                                $(`#tr-${id}`).fadeOut(800);
                            } else {
                                Swal.fire({
                                    icon: "error",
                                    title: "Oops...",
                                    text: "Something Went Wrong",
                                    timer: 1500
                                });
                            }
                        },
                        error: function (err) {
                            console.log(err);
                        }
                    })
                }
            });
        });

        // Open Edit Modal
        $(document).on('click', '.edit-btn', function() {
            const id = $(this).attr('data-id');

            $.ajax({
                url: `/teleconsult/admin/${id}`,
                method: "GET",
                success: function(response) {
                    if (response.success && response.booking) {
                        const b = response.booking;
                        $('#editBookingId').val(b._id);
                        $('#editFirstName').val(b.firstName);
                        $('#editLastName').val(b.lastName);
                        $('#editPhone').val(b.phone);
                        $('#editSpeciality').val(b.speciality);
                        $('#editStatus').val(b.status || 'Unverified');

                        $('.edit-modal').modal('show');
                    } else {
                        Swal.fire('Error', 'Could not load booking data.', 'error');
                    }
                },
                error: function(err) {
                    console.error(err);
                    Swal.fire('Error', 'Server Error. Check console.', 'error');
                }
            });
        });

        // Submit Edit Form
        $('#edit-form').on('submit', function(e) {
            e.preventDefault();
            const id = $('#editBookingId').val();

            const payload = {
                firstName: $('#editFirstName').val(),
                lastName: $('#editLastName').val(),
                phone: $('#editPhone').val(),
                speciality: $('#editSpeciality').val(),
                status: $('#editStatus').val()
            };

            $.ajax({
                url: `/teleconsult/admin/update/${id}`,
                method: 'POST',
                data: JSON.stringify(payload),
                contentType: 'application/json',
                success: function(response) {
                    if(response.success) {
                        $('.edit-modal').modal('hide');
                        Swal.fire({
                            title: 'Success!',
                            text: 'Booking updated successfully',
                            icon: 'success',
                            timer: 1500
                        }).then(() => {
                            window.location.reload();
                        });
                    } else {
                        Swal.fire('Error', 'Update failed!', 'error');
                    }
                },
                error: function(err) {
                    Swal.fire('Error', 'Server Error!', 'error');
                }
            });
        });
    </script>
</body>
</html>
