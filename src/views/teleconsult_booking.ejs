<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>BSRF - Teleconsultation Booking</title>
    <link rel="shortcut icon" type="image/png" href="https://bsrfindia.com/images/logo/logo.png">

    <!-- Bootstrap CSS -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.0/css/bootstrap.min.css" rel="stylesheet">
    <!-- FontAwesome for Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
        @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap');

        :root {
            --primary: #0284c7;
            --primary-light: #e0f2fe;
            --primary-hover: #0369a1;
            --secondary: #64748b;
            --card-bg: #ffffff;
            --bg-page: #f8fafc;
            --border-color: #e2e8f0;
            --border-focus: #38bdf8;
            --text-heading: #0f172a;
            --text-body: #334155;
            --text-muted: #64748b;
            --radius-md: 10px;
            --radius-lg: 16px;
            --shadow-card: 0 10px 30px -5px rgba(15, 23, 42, 0.06), 0 4px 10px -2px rgba(15, 23, 42, 0.03);
            --shadow-sm: 0 1px 3px rgba(0, 0, 0, 0.05);
        }

        * {
            box-sizing: border-box;
            font-family: 'Plus Jakarta Sans', sans-serif;
        }

        body {
            background-color: var(--bg-page);
            color: var(--text-body);
            margin: 0;
            padding: 30px 15px;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        /* --- App Container --- */
        .app-container {
            width: 100%;
            max-width: 620px;
            margin: auto;
            padding: 36px 40px;
            background-color: var(--card-bg);
            border-radius: var(--radius-lg);
            border: 1px solid var(--border-color);
            box-shadow: var(--shadow-card);
            position: relative;
        }

        /* --- Back Button --- */
        .back-btn-wrapper {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 24px;
        }

        .btn-circle-back {
            width: 42px;
            height: 42px;
            border-radius: 50%;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border: 1px solid var(--border-color);
            background: #ffffff;
            color: var(--text-heading);
            font-size: 15px;
            cursor: pointer;
            transition: all 0.2s ease-in-out;
            box-shadow: var(--shadow-sm);
        }

        .btn-circle-back:hover {
            background-color: var(--primary-light);
            color: var(--primary);
            border-color: var(--primary);
            transform: translateX(-3px);
        }

        /* --- Stepper Styling --- */
        .stepper-nav {
            display: flex;
            justify-content: space-between;
            position: relative;
            margin: 28px 0 32px;
            padding: 0 10px;
        }

        .stepper-nav::before {
            content: '';
            position: absolute;
            top: 20px;
            left: 50px;
            right: 50px;
            height: 2px;
            background-color: var(--border-color);
            z-index: 1;
        }

        .step-item {
            position: relative;
            z-index: 2;
            display: flex;
            flex-direction: column;
            align-items: center;
            flex: 1;
            text-align: center;
        }

        .step-circle {
            width: 42px;
            height: 42px;
            border-radius: 50%;
            background-color: #ffffff;
            border: 2px solid var(--border-color);
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
            font-size: 14px;
            color: var(--text-muted);
            margin-bottom: 8px;
            transition: all 0.25s ease;
        }

        .step-item.active .step-circle {
            background: var(--primary);
            border-color: var(--primary);
            color: #ffffff;
            box-shadow: 0 0 0 4px var(--primary-light);
        }

        .step-item.completed .step-circle {
            background-color: #10b981;
            border-color: #10b981;
            color: #ffffff;
        }

        .step-text {
            font-size: 13px;
            font-weight: 600;
            color: var(--text-muted);
            margin: 0;
            transition: color 0.2s;
        }

        .step-item.active .step-text {
            color: var(--text-heading);
            font-weight: 700;
        }

        /* --- Section Titles --- */
        .section-header {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 22px;
            padding-bottom: 12px;
            border-bottom: 1px solid var(--border-color);
        }

        .section-header h5 {
            font-size: 17px;
            font-weight: 700;
            color: var(--text-heading);
            margin: 0;
        }

        /* --- Inputs & Labels --- */
        .form-label {
            font-size: 13.5px;
            color: var(--text-heading);
            font-weight: 600;
            margin-bottom: 6px;
        }

        .form-control,
        .form-select {
            border: 1px solid var(--border-color);
            border-radius: var(--radius-md);
            padding: 10px 14px;
            font-size: 14.5px;
            color: var(--text-body);
            background-color: #ffffff;
            transition: all 0.2s ease;
            box-shadow: var(--shadow-sm);
        }

        .form-control:focus,
        .form-select:focus {
            border-color: var(--border-focus);
            box-shadow: 0 0 0 3px rgba(56, 189, 248, 0.25);
            outline: none;
        }

        .form-control::placeholder {
            color: #94a3b8;
            font-size: 14px;
        }

        .phone-group {
            display: flex;
            gap: 8px;
        }

        .phone-code {
            flex: 0 0 80px;
            background-color: #f1f5f9;
            color: var(--text-heading);
            font-weight: 600;
            text-align: center;
            border: 1px solid var(--border-color);
        }

        /* --- Speciality Radio Cards --- */
        .speciality-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
            gap: 10px;
            margin-bottom: 22px;
        }

        .speciality-card {
            position: relative;
            cursor: pointer;
        }

        .speciality-card input {
            position: absolute;
            opacity: 0;
            cursor: pointer;
        }

        .speciality-label {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            text-align: center;
            padding: 14px 10px;
            background: #ffffff;
            border: 1.5px solid var(--border-color);
            border-radius: var(--radius-md);
            font-size: 13px;
            font-weight: 600;
            color: var(--text-body);
            transition: all 0.2s ease;
            height: 100%;
            cursor: pointer;
            box-shadow: var(--shadow-sm);
        }

        .speciality-label i {
            font-size: 18px;
            margin-bottom: 6px;
            color: var(--primary);
        }

        .speciality-card input:checked + .speciality-label {
            border-color: var(--primary);
            background-color: var(--primary-light);
            color: var(--primary-hover);
            box-shadow: 0 0 0 2px var(--primary);
        }

        .speciality-label:hover {
            border-color: #93c5fd;
            background-color: #f8fafc;
        }

        /* --- Buttons --- */
        .btn-theme-primary {
            background-color: var(--primary);
            color: #ffffff;
            border: none;
            padding: 11px 26px;
            border-radius: var(--radius-md);
            font-weight: 600;
            font-size: 14.5px;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            transition: all 0.2s ease;
            box-shadow: 0 4px 12px rgba(2, 132, 199, 0.25);
        }

        .btn-theme-primary:hover {
            background-color: var(--primary-hover);
            color: #ffffff;
            transform: translateY(-1px);
            box-shadow: 0 6px 16px rgba(2, 132, 199, 0.35);
        }

        .btn-theme-secondary {
            background-color: #ffffff;
            color: var(--text-muted);
            border: 1px solid var(--border-color);
            padding: 11px 22px;
            border-radius: var(--radius-md);
            font-weight: 600;
            font-size: 14.5px;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            transition: all 0.2s ease;
        }

        .btn-theme-secondary:hover {
            background-color: #f1f5f9;
            color: var(--text-heading);
            border-color: #cbd5e1;
        }

        .actions-wrapper {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-top: 28px;
            padding-top: 18px;
            border-top: 1px solid var(--border-color);
        }

        .actions-right-only {
            display: flex;
            justify-content: flex-end;
            margin-top: 28px;
            padding-top: 18px;
            border-top: 1px solid var(--border-color);
        }

        /* --- Form Sections Animation --- */
        .form-section {
            display: none;
        }

        .form-section.active {
            display: block;
            animation: fadeIn 0.3s cubic-bezier(0.16, 1, 0.3, 1);
        }

        @keyframes fadeIn {
            from {
                opacity: 0;
                transform: translateY(8px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @media (max-width: 576px) {
            .app-container {
                padding: 24px 20px;
            }
            .speciality-grid {
                grid-template-columns: repeat(2, 1fr);
            }
        }
    </style>
</head>

<body>

    <!-- Main Container -->
    <div class="app-container">

        <!-- Back Button Wrapper -->
        <div class="back-btn-wrapper">
            <button type="button" class="btn-circle-back" onclick="if (window.history.length > 1) { window.history.back(); } else { window.location.href = '/'; }" title="Back to Previous Page">
                <i class="fas fa-arrow-left"></i>
            </button>
            <span class="badge bg-light text-secondary border px-3 py-2" style="font-size: 12px; font-weight: 600; border-radius: 20px;">
                <i class="fas fa-shield-alt text-primary me-1"></i> Verified Portal
            </span>
        </div>

        <!-- Logo Block -->
        <div class="text-center mb-3">
            <img src="/images/logo/logo.png" alt="BSRF India Logo" style="max-width: 220px; height: auto;">
            <h4 class="mt-3 fw-bold" style="color: var(--text-heading); font-size: 22px;">Teleconsult Booking</h4>
            <p class="text-muted" style="font-size: 13.5px; margin-top: 4px;">Book an online consultation with certified doctors</p>
        </div>

        <!-- Stepper Component -->
        <div class="stepper-nav">
            <div class="step-item active" id="step1-indicator">
                <div class="step-circle">1</div>
                <div class="step-text">User Profile</div>
            </div>

            <div class="step-item" id="step2-indicator">
                <div class="step-circle">2</div>
                <div class="step-text">Schedule Appointment</div>
            </div>
        </div>

        <!-- HTML FORM -->
        <form id="appointmentForm" action="/submit" method="POST">

            <!-- STEP 1: USER PROFILE -->
            <div class="form-section active" id="section-1">
                <div class="section-header">
                    <i class="fas fa-user-circle text-primary fs-5"></i>
                    <h5>User Profile Details</h5>
                </div>

                <div class="mb-3">
                    <label class="form-label">Phone Number *</label>
                    <div class="phone-group">
                        <input type="text" class="form-control phone-code" value="+91" readonly>
                        <input type="tel" class="form-control" name="phone" placeholder="Enter 10-digit phone number" required>
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-sm-6 mb-2 mb-sm-0">
                        <label class="form-label">First Name *</label>
                        <input type="text" class="form-control" name="firstName" placeholder="First Name" required>
                    </div>
                    <div class="col-sm-6">
                        <label class="form-label">Country</label>
                        <select class="form-select" name="country">
                            <option value="India" selected>India</option>
                            <option value="USA">USA</option>
                            <option value="UK">UK</option>
                        </select>
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label">Last Name</label>
                    <input type="text" class="form-control" name="lastName" placeholder="Last Name">
                </div>

                <div class="row mb-3">
                    <div class="col-sm-6 mb-2 mb-sm-0">
                        <label class="form-label">Date of Birth</label>
                        <input type="date" class="form-control" name="dob">
                    </div>
                    <div class="col-sm-6">
                        <label class="form-label">Age</label>
                        <input type="number" class="form-control" name="age" placeholder="e.g. 28">
                    </div>
                </div>

                <div class="row mb-4">
                    <div class="col-sm-6">
                        <label class="form-label">Gender</label>
                        <select class="form-select" name="gender">
                            <option value="" selected disabled>Select Gender</option>
                            <option value="Male">Male</option>
                            <option value="Female">Female</option>
                            <option value="Other">Other</option>
                        </select>
                    </div>
                </div>

                <div class="actions-right-only">
                    <button type="button" class="btn-theme-primary" onclick="goToStep(2)">
                        <span>Save & Continue</span>
                        <i class="fas fa-arrow-right"></i>
                    </button>
                </div>
            </div>


            <!-- STEP 2: SCHEDULE APPOINTMENT -->
            <div class="form-section" id="section-2">
                <div class="section-header">
                    <i class="fas fa-calendar-alt text-primary fs-5"></i>
                    <h5>Schedule Appointment</h5>
                </div>

                <label class="form-label mb-2">Select Speciality *</label>
                <div class="speciality-grid">
                    <label class="speciality-card">
                        <input type="radio" name="speciality" value="Cardiologist" checked>
                        <span class="speciality-label">
                            <i class="fas fa-heartbeat"></i>
                            Cardiologist
                        </span>
                    </label>
                    <label class="speciality-card">
                        <input type="radio" name="speciality" value="Orthopedic">
                        <span class="speciality-label">
                            <i class="fas fa-bone"></i>
                            Orthopedic
                        </span>
                    </label>
                    <label class="speciality-card">
                        <input type="radio" name="speciality" value="Dermatologist">
                        <span class="speciality-label">
                            <i class="fas fa-allergies"></i>
                            Dermatologist
                        </span>
                    </label>
                    <label class="speciality-card">
                        <input type="radio" name="speciality" value="General">
                        <span class="speciality-label">
                            <i class="fas fa-stethoscope"></i>
                            General Physician
                        </span>
                    </label>
                    <label class="speciality-card">
                        <input type="radio" name="speciality" value="Other">
                        <span class="speciality-label">
                            <i class="fas fa-user-md"></i>
                            Other Speciality
                        </span>
                    </label>
                </div>

                <div class="mb-3">
                    <label class="form-label">Booking Date *</label>
                    <input type="date" id="bookingDateInput" class="form-control" name="bookingDate" required>
                </div>

                <label class="form-label">Preferred Time Slot *</label>
                <div class="row mb-3 gx-2">
                    <div class="col-4">
                        <label class="form-label" style="font-size: 12px; color: var(--text-muted);">Hour</label>
                        <select class="form-select" name="hours">
                            <option value="09" selected>09</option>
                            <option value="10">10</option>
                            <option value="11">11</option>
                            <option value="12">12</option>
                            <option value="02">02</option>
                            <option value="03">03</option>
                            <option value="04">04</option>
                            <option value="05">05</option>
                            <option value="06">06</option>
                            <option value="07">07</option>
                        </select>
                    </div>
                    <div class="col-4">
                        <label class="form-label" style="font-size: 12px; color: var(--text-muted);">Minute</label>
                        <select class="form-select" name="minutes">
                            <option value="00" selected>00</option>
                            <option value="15">15</option>
                            <option value="30">30</option>
                            <option value="45">45</option>
                        </select>
                    </div>
                    <div class="col-4">
                        <label class="form-label" style="font-size: 12px; color: var(--text-muted);">Period</label>
                        <select class="form-select" name="meridian">
                            <option value="AM" selected>AM</option>
                            <option value="PM">PM</option>
                        </select>
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label">Reason For Consultation</label>
                    <input type="text" class="form-control" name="reason" placeholder="e.g. Fever, routine checkup, consultation">
                </div>

                <div class="mb-3">
                    <label class="form-label">Additional Comments</label>
                    <textarea class="form-control" name="comments" rows="2" placeholder="Any symptoms or relevant notes..."></textarea>
                </div>

                <div class="actions-wrapper">
                    <button type="button" class="btn-theme-secondary" onclick="goToStep(1)">
                        <i class="fas fa-arrow-left"></i>
                        <span>Previous</span>
                    </button>
                    <button type="submit" class="btn-theme-primary">
                        <i class="fas fa-check-circle"></i>
                        <span>Confirm Booking</span>
                    </button>
                </div>

            </div>

        </form>



    </div>

    <!-- Bootstrap Bundle JS -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.0/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/sweetalert2/11.23.0/sweetalert2.min.js"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/sweetalert2/11.23.0/sweetalert2.min.css">

    <script>
        // Restrict Booking Date to today and future dates
        const today = new Date().toISOString().split('T')[0];
        document.getElementById('bookingDateInput').setAttribute('min', today);

        function goToStep(step) {
            if (step === 2) {
                document.getElementById('section-1').classList.remove('active');
                document.getElementById('section-2').classList.add('active');

                document.getElementById('step1-indicator').classList.remove('active');
                document.getElementById('step1-indicator').classList.add('completed');
                document.getElementById('step2-indicator').classList.add('active');
            } else {
                document.getElementById('section-2').classList.remove('active');
                document.getElementById('section-1').classList.add('active');

                document.getElementById('step1-indicator').classList.add('active');
                document.getElementById('step1-indicator').classList.remove('completed');
                document.getElementById('step2-indicator').classList.remove('active');
            }
        }

        document.getElementById('appointmentForm').addEventListener('submit', async function (e) {
            e.preventDefault();

            const formData = new FormData(this);
            const data = Object.fromEntries(formData.entries());

            try {
                const response = await fetch('/teleconsult/submit', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(data)
                });

                const result = await response.json();

                if (result.success) {
                    Swal.fire({
                        icon: 'success',
                        title: 'Booking Confirmed!',
                        text: 'Your teleconsultation has been scheduled successfully.',
                        confirmButtonColor: '#00bced'
                    }).then(() => {
                        window.location.reload();
                    });
                } else {
                    Swal.fire({
                        icon: 'error',
                        title: 'Error',
                        text: 'Something went wrong while booking.',
                        confirmButtonColor: '#00bced'
                    });
                }
            } catch (err) {
                console.error(err);
                Swal.fire({
                    icon: 'error',
                    title: 'Error',
                    text: 'Failed to submit form.',
                    confirmButtonColor: '#00bced'
                });
            }
        });
    </script>
</body>

</html>